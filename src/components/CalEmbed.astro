---
// src/components/CalEmbed.astro
// CTA que dispara el modal Cal.com de onboarding 20 min.
//
// Requiere que <CalRuntime /> esté montado en la página (Layout.astro lo hace).
//
// Uso:
//   <CalEmbed text="agendar 20 min →" variant="accent" microcopy="20 min · gratuito" />

export interface Props {
  text?: string;
  variant?: 'primary' | 'accent' | 'bronce' | 'terracota' | 'indigo' | 'musgo';
  calLink?: string;
  microcopy?: string;
  className?: string;
}

const {
  text = 'agendar llamada · 20 min →',
  variant = 'primary',
  calLink = 'omaralvarezo/onboarding-20min',
  microcopy,
  className = '',
} = Astro.props;

// Mapa de variantes a HEX (paleta omar-brand v2.1)
const variantColors: Record<string, string> = {
  primary: '#1C1917',     // sumi (outline)
  accent: '#1E5FA8',      // azul brand (filled)
  bronce: '#8B6F47',
  terracota: '#C67B5C',
  indigo: '#3D4E6B',
  musgo: '#6B7F5C',
};
const accentHex = variantColors[variant] || variantColors.primary;
const isFilled = variant === 'accent';
---

<div class={`cal-cta-wrap ${className}`}>
  <button
    type="button"
    data-cal-namespace="onboarding-20min"
    data-cal-link={calLink}
    data-cal-config='{"layout":"month_view","theme":"light"}'
    class={`cal-cta cal-cta--${variant}${isFilled ? ' cal-cta--filled' : ''}`}
    style={`--cal-accent: ${accentHex};`}
    aria-label={text}
    data-magnetic
    data-magnetic-strength="0.2"
  >
    {text}
  </button>

  {microcopy && (
    <p class="cal-cta-micro">
      {microcopy}
    </p>
  )}
</div>

<style>
  .cal-cta-wrap {
    display: inline-flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .cal-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--cal-accent);
    background: transparent;
    border: 1px solid var(--cal-accent);
    border-radius: 0;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease, opacity 0.3s ease;
    will-change: transform;
  }
  .cal-cta:hover {
    background-color: var(--cal-accent);
    color: var(--bg);
  }
  .cal-cta:focus-visible {
    outline: 2px solid var(--cal-accent);
    outline-offset: 4px;
  }

  /* Filled — CTA primario del Hero/Nav */
  .cal-cta--filled {
    background-color: var(--cal-accent);
    color: var(--bg);
    border-color: var(--cal-accent);
  }
  .cal-cta--filled:hover {
    opacity: 0.85;
    background-color: var(--cal-accent);
    color: var(--bg);
  }

  .cal-cta-micro {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mute);
  }
</style>
