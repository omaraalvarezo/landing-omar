---
import CalEmbed from './CalEmbed.astro';

const today = new Date();
const stamp = `${today.getFullYear()}.${String(today.getMonth() + 1).padStart(2, '0')}.${String(today.getDate()).padStart(2, '0')}`;
---

<section id="hero" class="hero">
  <div class="hero__inner container-page">
    <!-- Header recurrente: pilar + path/timestamp -->
    <div class="hero__top">
      <p class="hero__pillar">PERFIL · CONSULTOR DE IA APLICADA</p>
      <p class="hero__path">~/omar.alvarez · {stamp}</p>
    </div>

    <!-- Pill superior: estado disponible -->
    <p class="hero__badge" data-reveal>
      <span class="hero__badge-dot-wrap" aria-hidden="true">
        <span class="hero__badge-dot"></span>
        <span class="hero__badge-pulse"></span>
      </span>
      DISPONIBLE · AGENDA ABIERTA · SESIONES 1:1
    </p>

    <!-- Headline editorial: Instrument Serif Regular -->
    <h1 class="hero__headline display-1" data-split-reveal style="--reveal-delay: 200ms; --reveal-stagger: 50ms;">
      Tu pyme genera datos. Casi ninguno <span class="accent-italic">decide</span>.
    </h1>

    <!-- Subheadline en mono -->
    <p class="hero__sub body-lg" data-reveal style="--reveal-delay: 700ms;">
      Trabajo 1:1 con operadores de pymes que ya facturan y quieren usar IA en serio. Lo que te muestro lo opero todos los días en Enzo y en Arkhē — no es teoría, es lo que hago para que mi propio negocio funcione.
    </p>

    <!-- Credenciales académicas express (mono, inline) -->
    <p class="hero__creds" data-reveal style="--reveal-delay: 800ms;" aria-label="Formación académica">
      <span>EAFIT</span>
      <span aria-hidden="true">·</span>
      <span>UPB MEDELLÍN</span>
      <span aria-hidden="true">·</span>
      <span>LA SALLE BARCELONA</span>
    </p>

    <!-- CTAs -->
    <div class="hero__ctas" data-reveal style="--reveal-delay: 850ms;">
      <CalEmbed
        text="agendar 20 min →"
        variant="accent"
        microcopy="20 min · video · gratuito · sin compromiso"
        className="hero__cta-cal"
      />
      <a
        href="#casos"
        class="hero__cta hero__cta--ghost"
        data-magnetic
        data-magnetic-strength="0.15"
      >
        ver casos
      </a>
    </div>

    <!-- Trust-row: resuelve la fricción de "qué pasa después" sin esperar al FAQ -->
    <p class="hero__trust" data-reveal style="--reveal-delay: 950ms;" aria-label="Garantías de la llamada">
      <span>20 min · gratis</span>
      <span aria-hidden="true">·</span>
      <span>te digo si no encajamos</span>
      <span aria-hidden="true">·</span>
      <span>sin pitch</span>
    </p>

    <!-- Scroll indicator (esquina inferior derecha en desktop) -->
    <div class="hero__scroll" aria-hidden="true">
      <span class="hero__scroll-line"></span>
      <span class="hero__scroll-label">scroll</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-top: clamp(96px, 14vh, 140px);
    padding-bottom: clamp(32px, 6vh, 64px);
    gap: clamp(20px, 3vh, 32px);
  }

  /* Top: pillar + path */
  .hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 12px;
    border-bottom: 0.5px solid var(--line);
    margin-bottom: clamp(16px, 3vh, 24px);
  }
  .hero__pillar {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .hero__path {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mute);
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    padding: 6px 12px;
    border: 0.5px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--mute);
    margin: 0;
  }
  .hero__badge-dot-wrap {
    position: relative;
    display: inline-block;
    width: 8px;
    height: 8px;
  }
  .hero__badge-dot {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background-color: var(--accent);
  }
  .hero__badge-pulse {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background-color: var(--accent);
    opacity: 0.6;
    transform: scale(1);
    animation: pulse-clean 2.4s var(--ease-out-expo) infinite;
  }
  @keyframes pulse-clean {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    70% { transform: scale(2.4); opacity: 0; }
  }

  /* Headline */
  .hero__headline {
    margin: 0;
    max-width: 16ch;
    color: var(--ink);
  }

  /* Subheadline */
  .hero__sub {
    margin: 0;
    max-width: 56ch;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  /* Credenciales académicas express */
  .hero__creds {
    margin: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .hero__creds span[aria-hidden='true'] {
    color: var(--line-hi);
  }

  /* CTAs */
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-start;
  }
  .hero__cta-cal :global(.cal-cta) {
    font-size: 13px;
    padding: 12px 20px;
  }

  /* Trust row debajo del CTA */
  .hero__trust {
    margin: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mute);
    max-width: 64ch;
  }
  .hero__trust span[aria-hidden='true'] {
    color: var(--line-hi);
  }

  .hero__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    border-radius: 0;
    transition: opacity 0.3s var(--ease-out-expo);
    will-change: transform;
  }
  .hero__cta--primary {
    background-color: var(--accent);
    color: var(--bg);
  }
  .hero__cta--primary:hover {
    opacity: 0.85;
  }

  .hero__cta--ghost {
    background-color: transparent;
    color: var(--ink);
    border: 0.5px solid var(--line-hi);
  }
  .hero__cta--ghost:hover {
    border-color: var(--ink);
  }

  .hero__cta-arrow {
    display: inline-block;
    transition: transform 0.4s var(--ease-out-expo);
  }
  .hero__cta--primary:hover .hero__cta-arrow {
    transform: translateX(3px);
  }

  /* Scroll indicator (esquina inferior derecha en desktop) */
  .hero__scroll {
    display: none;
  }

  @media (min-width: 768px) {
    .hero__scroll {
      position: absolute;
      right: clamp(20px, 4vw, 48px);
      bottom: clamp(32px, 6vh, 64px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .hero__scroll-line {
      display: block;
      width: 1px;
      height: 40px;
      background-color: var(--line-hi);
      transform-origin: top center;
      animation: scroll-line 1.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }
    .hero__scroll-label {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--mute);
      font-weight: 500;
    }
    @keyframes scroll-line {
      0% { transform: scaleY(0); transform-origin: top center; }
      45% { transform: scaleY(1); transform-origin: top center; }
      55% { transform: scaleY(1); transform-origin: bottom center; }
      100% { transform: scaleY(0); transform-origin: bottom center; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__badge-pulse,
    .hero__scroll-line {
      animation: none !important;
    }
  }
</style>

<script>
  import { splitAndReveal } from '../scripts/splitText';
  import { initMagnetic } from '../scripts/magnetic';

  splitAndReveal({ selector: '[data-split-reveal]', staggerMs: 50, durationMs: 800 });
  initMagnetic();

  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-split-reveal])');
  if (reveals.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      reveals.forEach((el) => el.classList.add('is-revealed'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-revealed');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      reveals.forEach((el) => io.observe(el));
    }
  }
</script>
