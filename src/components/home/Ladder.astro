---
// La escalera del home: de lo gratis a lo que pide mi tiempo. Montos y destinos salen de
// `LADDER` (que los toma de `getProduct()`); aquí solo se decide cómo se ven.
import { bogotaToday } from '../../lib/directory';
import { LADDER, PRIMARY_RUNG, type Rung } from '../../lib/ladder';
import { formatCop } from '../../lib/money';
import { getProduct, isProductOnSale } from '../../lib/products';

const sistema = getProduct('enzo-detailing');
if (!sistema) throw new Error('LADDER_SIN_SISTEMA');
const sistemaOnSale = isProductOnSale(sistema, bogotaToday());

function actionLabel(rung: Rung) {
  switch (rung.action) {
    case 'correo':
      return 'pedir el PDF';
    case 'compra':
      return 'ver el kit';
    case 'preventa':
      return sistemaOnSale ? 'comprar en preventa' : 'ver el sistema';
    case 'anotarse':
      return 'anotarme';
  }
}

function statusLabel(rung: Rung) {
  switch (rung.action) {
    case 'correo':
      return 'gratis';
    case 'compra':
      return 'descarga directa';
    case 'preventa':
      return sistemaOnSale ? 'preventa abierta' : 'preventa · abre pronto';
    case 'anotarse':
      return 'cupos cerrados hoy';
  }
}

const rungs = LADDER.map((rung, index) => ({
  ...rung,
  index: String(index + 1).padStart(2, '0'),
  primary: rung.id === PRIMARY_RUNG,
  closed: rung.action === 'anotarse',
  price: rung.priceCop === null ? (rung.action === 'correo' ? 'Gratis' : 'Sin costo') : formatCop(rung.priceCop),
  usd: rung.usdReference === null ? null : `aprox. USD ${rung.usdReference}`,
  action: actionLabel(rung),
  status: statusLabel(rung),
}));
---

<section class="ladder" id="escalera" aria-labelledby="ladder-title">
  <header class="ladder__head">
    <p class="overline">POR DÓNDE EMPEZAR</p>
    <h2 id="ladder-title">Cuatro escalones.<br /><span>Sube hasta donde te sirva.</span></h2>
    <p>Puedes empezar gratis y quedarte ahí. Lo que montas tú solo está a la venta; lo que pide mi tiempo en persona queda en lista de espera.</p>
  </header>

  <ol class="ladder__steps">
    {rungs.map((rung, position) => (
      <li
        class:list={['step', rung.primary && 'step--primary', rung.closed && 'step--closed']}
        style={`--rise:${position}`}
      >
        <div class="step__top">
          <span>{rung.index} / 04</span>
          <span>{rung.status}</span>
        </div>
        {rung.primary && <p class="step__flag">EL QUE OPERO EN ENZO</p>}
        <h3>{rung.name}</h3>
        <p class="step__who">{rung.forWho}</p>
        <p class="step__gets">{rung.gets}</p>
        <p class="step__price">
          <strong>{rung.price}</strong>
          {rung.usd && <span>{rung.usd}</span>}
        </p>
        <a
          class="step__action"
          href={rung.href}
          data-track="escalon_click"
          data-track-id={rung.id}
          data-track-placement="escalera"
          data-contact-link={rung.closed ? '' : undefined}
          data-cta-placement={rung.closed ? 'escalera' : undefined}
        >
          <span>{rung.action}</span>
          <i aria-hidden="true">{rung.closed ? '↘' : '↗'}</i>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .ladder {
    padding: clamp(110px, 14vw, 210px) clamp(20px, 5vw, 80px) clamp(90px, 11vw, 160px);
    overflow: hidden;
    color: var(--bone);
    background: var(--ink);
  }
  .ladder *,
  .ladder *::before,
  .ladder *::after { box-sizing: border-box; }
  .ladder h2,
  .ladder h3,
  .ladder p { margin-top: 0; }
  .ladder a { color: inherit; text-decoration: none; }
  .overline {
    font-family: var(--data);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ladder__head {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, .7fr);
    gap: clamp(40px, 8vw, 130px);
    align-items: end;
    max-width: 1440px;
    margin-inline: auto;
  }
  .ladder__head .overline { grid-column: 1 / -1; margin-bottom: 0; color: var(--sky); }
  .ladder__head h2 {
    max-width: 11ch;
    margin-bottom: 0;
    font-family: var(--display);
    font-size: clamp(50px, 7vw, 108px);
    font-stretch: 78%;
    font-weight: 760;
    line-height: .85;
    letter-spacing: -.07em;
  }
  .ladder__head h2 span { color: var(--lime); }
  .ladder__head > p:last-child { max-width: 42ch; margin-bottom: 0; color: rgba(255, 248, 234, .68); font-size: 18px; line-height: 1.55; }

  /* Escalera real: cada escalón arranca más arriba que el anterior y todos apoyan en el mismo
     piso. El principal es el único a color pleno. */
  .ladder__steps {
    position: relative;
    display: grid;
    grid-template-columns: .9fr .95fr 1.25fr .9fr;
    align-items: end;
    max-width: 1440px;
    margin: clamp(80px, 10vw, 140px) auto 0;
    padding: 0;
    list-style: none;
    border-bottom: 2px solid rgba(255, 248, 234, .4);
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(340px + var(--rise) * 70px);
    padding: clamp(20px, 2.2vw, 32px);
    color: var(--bone);
    background: var(--ink-soft);
    border-top: 2px solid rgba(255, 248, 234, .55);
    border-right: 1px solid rgba(255, 248, 234, .14);
  }
  .step:first-child { border-left: 1px solid rgba(255, 248, 234, .14); }
  .step__top { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 28px; font-family: var(--data); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; opacity: .72; }
  .step h3 {
    margin-bottom: 14px;
    font-family: var(--display);
    font-size: clamp(28px, 2.6vw, 40px);
    font-stretch: 80%;
    font-weight: 750;
    line-height: .92;
    letter-spacing: -.045em;
  }
  .step__who { margin-bottom: 10px; font-size: 15px; line-height: 1.45; }
  .step__gets { margin-bottom: 24px; color: rgba(255, 248, 234, .66); font-size: 14px; line-height: 1.45; }
  .step__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin: auto 0 18px; }
  .step__price strong { font-family: var(--display); font-size: clamp(34px, 3.4vw, 52px); font-stretch: 78%; line-height: .9; letter-spacing: -.05em; }
  .step__price span { font-family: var(--data); font-size: 10px; letter-spacing: .06em; opacity: .76; }

  .step__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 48px;
    padding: 12px 0;
    border-top: 1px solid rgba(255, 248, 234, .3);
    font-family: var(--data);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    transition: color .25s ease, gap .25s ease;
  }
  .step__action i { font-style: normal; font-size: 16px; }
  .step__action:hover { color: var(--lime); }
  .step__action:focus-visible { outline: 3px solid var(--lime); outline-offset: 3px; }

  .step--primary {
    z-index: 2;
    margin-inline: -6px;
    color: var(--ink);
    background: var(--lime);
    border: 2px solid var(--ink);
    box-shadow: 10px 10px 0 var(--coral);
  }
  .step--primary .step__top { opacity: 1; }
  .step--primary .step__gets { color: rgba(19, 17, 24, .76); }
  .step--primary .step__price span { opacity: 1; }
  .step__flag {
    align-self: flex-start;
    margin-bottom: 18px;
    padding: 7px 9px;
    color: var(--lime);
    background: var(--ink);
    font-family: var(--data);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .1em;
  }
  .step--primary .step__action {
    min-height: 56px;
    padding: 14px 16px;
    color: var(--ink);
    background: var(--bone);
    border: 2px solid var(--ink);
    border-radius: 14px 14px 14px 3px;
  }
  .step--primary .step__action:hover { color: var(--ink); background: #fff; }
  .step--primary .step__action:focus-visible { outline-color: var(--ink); }

  /* Lista de espera: el escalón existe pero está cerrado hoy. */
  .step--closed {
    background: transparent;
    border-top-style: dashed;
    border-right-style: dashed;
  }

  @media (max-width: 1050px) {
    .ladder__steps { grid-template-columns: 1fr 1fr; align-items: stretch; gap: 0; border-bottom: 0; }
    .step { min-height: 0; border: 1px solid rgba(255, 248, 234, .14); border-top: 2px solid rgba(255, 248, 234, .55); }
    .step--primary { margin: 0; border: 2px solid var(--ink); }
  }

  @media (max-width: 820px) {
    .ladder__head { grid-template-columns: 1fr; align-items: start; }
    .ladder__head .overline { grid-column: auto; }
  }

  @media (max-width: 560px) {
    .ladder__head h2 { font-size: clamp(46px, 14vw, 70px); }
    /* En el teléfono la escalera baja en diagonal: cada escalón se corre un poco a la derecha. */
    .ladder__steps { grid-template-columns: 1fr; gap: 14px; }
    .step { margin-left: calc(var(--rise) * 8px); }
    .step--primary { margin-left: calc(var(--rise) * 8px); margin-right: 8px; box-shadow: 6px 6px 0 var(--coral); }
  }

  @media (prefers-reduced-motion: reduce) {
    .step__action { transition: none; }
  }
</style>
