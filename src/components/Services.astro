---
import SectionLabel from './SectionLabel.astro';
import CalEmbed from './CalEmbed.astro';

type AccentVariant = 'bronce' | 'terracota';

interface Service {
  n: string;
  label: string;
  title: string;
  meta: string;
  investment: string;
  desc: string;
  bullets: string[];
  takeaway: { label: string; body: string }[];
  ctaText: string;
  accent: AccentVariant;
  flipped?: boolean;
  footer?: string;
}

const ACCENT_HEX: Record<AccentVariant, string> = {
  bronce: '#8B6F47',
  terracota: '#C67B5C',
};

const SERVICES: Service[] = [
  {
    n: '01',
    label: 'puntual',
    title: 'Sesión 1:1',
    meta: '90 min · Google Meet · GMT-5',
    investment: 'consultar inversión',
    desc: 'Salimos con la decisión tomada o el sistema andando — no con tarea para la casa.',
    bullets: [
      '90 min enfocados en UN problema concreto que traes definido',
      'Trabajo en vivo: configuro Claude con tus datos, escribimos prompts, probamos hasta que sirva',
      'Documento de cierre con lo decidido y los próximos pasos (te llega en 48h)',
      'WhatsApp abierto 7 días para dudas mientras lo ejecutas',
      'Grabación de la sesión si la quieres',
    ],
    takeaway: [
      { label: 'Decisión tomada o sistema andando', body: 'No teoría, no tarea para la casa.' },
      { label: 'Razonamiento documentado', body: 'Para que lo repliques sin mí.' },
      { label: 'Cero dependencia futura', body: 'No te ato a retainer ni a follow-up que no necesitas.' },
    ],
    ctaText: 'agendar llamada de 20 min →',
    accent: 'bronce',
    footer: 'Ideal si tienes un problema puntual y quieres salirlo hoy.',
  },
  {
    n: '02',
    label: 'recurrente',
    title: 'Pack de 5 sesiones',
    meta: '5 × 90 min · a tu ritmo · GMT-5',
    investment: 'consultar inversión · descuento vs sesión suelta',
    desc: 'Continuidad real para los próximos meses. No reexplicas tu negocio cada vez.',
    bullets: [
      '5 sesiones de 90 min, agendadas según tu ritmo (recomiendo una cada dos semanas)',
      'Cada sesión sobre un problema distinto o la continuación del anterior',
      'Documento de cierre por cada sesión',
      'WhatsApp async abierto durante toda la vigencia del pack',
      'Vigencia: 6 meses desde la primera sesión',
      'Grabación de cada sesión',
    ],
    takeaway: [
      { label: 'Continuidad', body: 'No reexplicas tu negocio cada vez.' },
      { label: 'Avances acumulados', body: 'No decisiones sueltas — un hilo conductor.' },
      { label: 'Mejor precio por sesión', body: 'Descuento vs comprarlas una por una.' },
    ],
    ctaText: 'agendar llamada de 20 min →',
    accent: 'terracota',
    flipped: true,
    footer: 'Ideal si ya sabes que la IA va a ser parte de tu operación los próximos meses.',
  },
];
---

<section id="servicios" class="services scroll-mt-24" aria-labelledby="services-title">
  <div class="container-page services__grid">
    <div class="services__label">
      <SectionLabel number="03" title="SERVICIOS" />
    </div>

    <div class="services__content">
      <h2 id="services-title" class="h2-section services__headline" data-split-reveal style="--reveal-stagger: 35ms;">
        Una sesión, un problema, una <span class="accent-italic">decisión</span>.
      </h2>

      <p class="services__lede" data-reveal>
        90 minutos contigo, en vivo, sobre algo que ya te tiene pensando hace rato.
        Salimos con la decisión tomada o el sistema andando — no con tarea para la casa.
        Escoge el formato que te sirva.
      </p>

      <ul class="services__list" role="list">
        {SERVICES.map((s) => (
          <li
            class={`service-card service-card--${s.accent}${s.flipped ? ' service-card--flipped' : ''}`}
            style={`--service-accent: ${ACCENT_HEX[s.accent]};`}
            data-reveal
          >
            <div class="service-card__main">
              <div class="service-card__tag">
                <span class="service-card__num">{s.n}</span>
                <span class="service-card__tag-sep" aria-hidden="true">·</span>
                <span class="service-card__label">{s.label}</span>
              </div>
              <div class="service-card__head">
                <h3 class="service-card__title">{s.title}</h3>
                <p class="service-card__meta">{s.meta}</p>
                <p class="service-card__investment">{s.investment}</p>
              </div>
              <p class="service-card__desc">{s.desc}</p>
              <ul class="service-card__bullets" role="list">
                {s.bullets.map((b) => (
                  <li>
                    <span class="service-card__check" aria-hidden="true">+</span>
                    {b}
                  </li>
                ))}
              </ul>
              <CalEmbed text={s.ctaText} variant={s.accent} microcopy="20 min · gratuito · sin compromiso" />
              {s.footer && (
                <p class="service-card__footer">{s.footer}</p>
              )}
            </div>

            <aside class="service-card__aside" aria-label={`Qué te llevas con ${s.title}`}>
              <p class="service-card__aside-label">Qué te llevas</p>
              <ul class="service-card__takeaway" role="list">
                {s.takeaway.map((t) => (
                  <li>
                    <p class="service-card__takeaway-label">{t.label}</p>
                    <p class="service-card__takeaway-body">{t.body}</p>
                  </li>
                ))}
              </ul>
            </aside>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: clamp(96px, 14vw, 200px);
    border-top: 0.5px solid var(--line);
  }

  .services__grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }

  .services__content {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 80px);
  }

  .services__headline {
    margin: 0;
    max-width: 18ch;
  }

  .services__lede {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.7vw, 18px);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 56ch;
    letter-spacing: -0.005em;
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .service-card {
    border: 0.5px solid var(--line);
    border-radius: 4px;
    background-color: var(--bg);
    overflow: hidden;
    transition: border-color 0.3s ease;
    display: grid;
    grid-template-columns: 1fr;
  }
  .service-card:hover { border-color: var(--service-accent, var(--line-hi)); }
  .service-card:hover .service-card__num { color: var(--service-accent, var(--accent)); }

  .service-card__main {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Tag (NN · label) en lugar del numero grande solo */
  .service-card__tag {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
    font-weight: 500;
  }
  .service-card__num {
    color: var(--service-accent, var(--accent));
    transition: color 0.4s var(--ease-out-expo);
  }
  .service-card__tag-sep {
    color: var(--line-hi);
  }
  .service-card__label {
    color: var(--mute);
  }

  .service-card__head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .service-card__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.018em;
    font-weight: 400;
    color: var(--ink);
  }

  .service-card__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .service-card__investment {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--service-accent, var(--accent));
    font-weight: 500;
  }

  .service-card__desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .service-card__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 0.5px solid var(--line);
    padding-top: 20px;
  }
  .service-card__bullets li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .service-card__check {
    flex-shrink: 0;
    font-family: var(--font-mono);
    color: var(--service-accent, var(--accent));
    line-height: 1.55;
  }

  .service-card__footer {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mute);
    font-style: italic;
  }

  /* Aside (qué te llevas) */
  .service-card__aside {
    background-color: var(--bg-soft);
    border-top: 0.5px solid var(--line);
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .service-card__aside-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--service-accent, var(--mute));
  }

  .service-card__takeaway {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .service-card__takeaway li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 16px;
    border-bottom: 0.5px solid var(--line);
  }
  .service-card__takeaway li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .service-card__takeaway-label {
    margin: 0;
    font-size: 14px;
    color: var(--ink);
    font-weight: 500;
  }
  .service-card__takeaway-body {
    margin: 0;
    font-size: 13px;
    color: var(--mute);
    line-height: 1.55;
  }

  /* Tablet+ — layout asimétrico horizontal */
  @media (min-width: 900px) {
    .service-card {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
    .service-card__main {
      padding: 40px 36px 44px;
      gap: 24px;
    }
    .service-card__aside {
      border-top: 0;
      border-left: 0.5px solid var(--line);
      padding: 40px 32px;
    }
    .service-card--flipped .service-card__main { order: 2; border-left: 0.5px solid var(--line); }
    .service-card--flipped .service-card__aside { order: 1; border-left: 0; }
  }

  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
