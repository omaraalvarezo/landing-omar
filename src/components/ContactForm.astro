---
// src/components/ContactForm.astro
// Sección 07 · CONTACTO — split editorial + embed Cal.com inline.
//
// La columna izquierda condensa P7+P8 del FAQ (filtro de 20 min + Quick Win Brief)
// para que el visitante no tenga que bajar a buscarlas. La columna derecha es
// el calendario embebido directo: cero click extra al modal, cero email visible.
import SectionLabel from './SectionLabel.astro';
import { CAL_LINK, calBookUrl } from '../lib/contact';
---

<section id="contacto" class="contact scroll-mt-24" aria-labelledby="contact-title">
  <div class="container-page">
    <SectionLabel number="07" title="CONTACTO" />

    <div class="contact__grid">
      <!-- Columna izquierda · editorial -->
      <div class="contact__editorial">
        <h2 id="contact-title" class="contact__headline" data-split-reveal style="--reveal-stagger: 35ms;">
          ¿Listo para integrar <span class="accent-italic">IA</span> en tu operación?
        </h2>

        <p class="contact__lede body-lg" data-reveal>
          20 minutos por video. Filtramos juntos si encajamos. Después te mando un
          <em>Quick Win Brief</em> gratis con UNA oportunidad detectada — decidas
          trabajar conmigo o no.
        </p>

        <ol class="contact__tline" aria-label="Qué pasa cuando agendas">
          <li data-reveal>
            <span class="contact__tline-num">01</span>
            <div>
              <p class="contact__tline-label">agendas</p>
              <p class="contact__tline-sub">eliges un slot del calendario · respuesta inmediata</p>
            </div>
          </li>
          <li data-reveal>
            <span class="contact__tline-num">02</span>
            <div>
              <p class="contact__tline-label">llamada</p>
              <p class="contact__tline-sub">20 min por video · sin pitch · filtramos si encaja</p>
            </div>
          </li>
          <li data-reveal>
            <span class="contact__tline-num">03</span>
            <div>
              <p class="contact__tline-label">brief 24h</p>
              <p class="contact__tline-sub">PDF de 1 página con tu Quick Win · sin compromiso</p>
            </div>
          </li>
        </ol>

        <ul class="contact__badges" aria-label="Garantías">
          <li>GRATUITO · SIN COMPROMISO</li>
          <li>SALIDA EN CUALQUIER MOMENTO</li>
          <li>QUICK WIN BRIEF SIN OBLIGACIÓN</li>
        </ul>
      </div>

      <!-- Columna derecha · embed Cal inline -->
      <div class="contact__embed">
        <div
          class="contact__cal"
          data-cal-inline
          data-cal-namespace="onboarding-20min"
          data-cal-link={CAL_LINK}
          aria-label="Calendario de agendamiento"
        ></div>
        <noscript>
          <p class="contact__noscript">
            <a href={calBookUrl()} target="_blank" rel="noopener">
              abrir calendario en cal.com →
            </a>
          </p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(96px, 14vw, 200px);
    border-top: 0.5px solid var(--line);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 6vw, 64px);
    align-items: start;
  }

  /* Editorial */
  .contact__editorial {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 32px);
  }

  .contact__headline {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.018em;
    font-weight: 400;
    color: var(--ink);
    max-width: 18ch;
  }

  .contact__lede {
    margin: 0;
    color: var(--ink-soft);
    max-width: 50ch;
  }
  .contact__lede em {
    font-style: italic;
    color: var(--ink);
  }

  /* Timeline */
  .contact__tline {
    list-style: none;
    margin: 0;
    padding: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 0.5px solid var(--line);
    border-bottom: 0.5px solid var(--line);
  }
  .contact__tline li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    align-items: baseline;
  }
  .contact__tline-num {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--accent);
    font-weight: 500;
  }
  .contact__tline-label {
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
    font-weight: 500;
  }
  .contact__tline-sub {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mute);
    line-height: 1.5;
  }

  /* Badges trust */
  .contact__badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact__badges li {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
    font-weight: 500;
  }

  /* Embed */
  .contact__embed {
    position: relative;
    width: 100%;
  }
  .contact__cal {
    width: 100%;
    min-height: 640px;
    border: 0.5px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--bg);
  }
  .contact__noscript {
    margin: 24px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }
  .contact__noscript a:hover {
    text-decoration: underline;
  }

  /* Desktop split 5/7 */
  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
    }
    .contact__editorial {
      position: sticky;
      top: 96px;
    }
    .contact__cal {
      min-height: 720px;
    }
  }
</style>

<script>
  // Reveal de items del timeline.
  const reveals = document.querySelectorAll<HTMLElement>('.contact [data-reveal]:not([data-split-reveal])');
  if (reveals.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      reveals.forEach((el) => el.classList.add('is-revealed'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-revealed');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      reveals.forEach((el) => io.observe(el));
    }
  }
</script>
