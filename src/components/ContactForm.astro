---
// src/components/ContactForm.astro
// Sección 07 · CONTACTO — split editorial + mini formulario de pre-llenado
// + embed Cal.com inline.
//
// La columna izquierda es editorial: hook, timeline 3 pasos y badges de garantía.
// La columna derecha trae el mini form encima del calendario embebido: el visitante
// puede llenar 3 campos (nombre, negocio, qué resolver) y abrir Cal.com con esos
// datos ya pre-rellenados, o agendar directo en el calendario sin llenar nada.
import SectionLabel from './SectionLabel.astro';
import { CAL_LINK, CAL_NAMESPACE, calBookUrl } from '../lib/contact';
---

<section id="contacto" class="contact scroll-mt-24" aria-labelledby="contact-title">
  <div class="container-page">
    <SectionLabel number="07" title="CONTACTO" />

    <div class="contact__grid">
      <!-- Columna izquierda · editorial -->
      <div class="contact__editorial">
        <h2 id="contact-title" class="contact__headline" data-split-reveal style="--reveal-stagger: 35ms;">
          Cuéntame qué te tiene <span class="accent-italic">pensando</span>.
        </h2>

        <p class="contact__lede body-lg" data-reveal>
          Una línea sobre tu negocio y otra sobre lo que quieres resolver. Te respondo
          personalmente en menos de 24h — no hay equipo, soy yo.
        </p>

        <ol class="contact__tline" aria-label="Qué pasa cuando agendas">
          <li data-reveal>
            <span class="contact__tline-num">01</span>
            <div>
              <p class="contact__tline-label">agendas</p>
              <p class="contact__tline-sub">eliges un slot del calendario · respuesta inmediata</p>
            </div>
          </li>
          <li data-reveal>
            <span class="contact__tline-num">02</span>
            <div>
              <p class="contact__tline-label">llamada</p>
              <p class="contact__tline-sub">20 min por video · te digo si encajamos · sin pitch</p>
            </div>
          </li>
          <li data-reveal>
            <span class="contact__tline-num">03</span>
            <div>
              <p class="contact__tline-label">siguiente paso</p>
              <p class="contact__tline-sub">si encajamos, te explico el paso · si no, te ahorro la consultoría</p>
            </div>
          </li>
        </ol>

        <ul class="contact__badges" aria-label="Garantías">
          <li>GRATUITO · SIN COMPROMISO</li>
          <li>SALIDA EN CUALQUIER MOMENTO</li>
          <li>RESPONDO YO · NO HAY EQUIPO</li>
        </ul>
      </div>

      <!-- Columna derecha · mini form + embed Cal inline -->
      <div class="contact__embed-col">
        <form
          class="contact__prefill"
          data-prefill-form
          aria-label="Pre-llenar tu reserva"
          novalidate
        >
          <p class="contact__prefill-title">PRE-LLENA TU RESERVA · OPCIONAL</p>
          <p class="contact__prefill-help">
            Si prefieres dejar algo escrito antes de abrir el calendario, llena estos
            3 campos. Tu información va directo a la reserva de Cal.com — no me llega
            por separado.
          </p>

          <label class="contact__prefill-field">
            <span>Tu nombre</span>
            <input
              type="text"
              name="name"
              autocomplete="name"
              data-prefill-name
            />
          </label>

          <label class="contact__prefill-field">
            <span>Tu negocio o sector</span>
            <input
              type="text"
              name="business"
              autocomplete="organization"
              data-prefill-business
            />
          </label>

          <label class="contact__prefill-field">
            <span>Qué quieres resolver</span>
            <textarea
              name="notes"
              rows="3"
              data-prefill-notes
            ></textarea>
          </label>

          <button type="button" class="contact__prefill-cta" data-prefill-submit>
            continuar al calendario →
          </button>

          <p class="contact__prefill-foot">
            o agenda directo abajo sin llenar nada
          </p>
        </form>

        <div
          class="contact__cal"
          data-cal-inline
          data-cal-namespace={CAL_NAMESPACE}
          data-cal-link={CAL_LINK}
          aria-label="Calendario de agendamiento"
        ></div>
        <noscript>
          <p class="contact__noscript">
            <a href={calBookUrl()} target="_blank" rel="noopener">
              abrir calendario en cal.com →
            </a>
          </p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(96px, 14vw, 200px);
    border-top: 0.5px solid var(--line);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 6vw, 64px);
    align-items: start;
  }

  /* Editorial */
  .contact__editorial {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 32px);
  }

  .contact__headline {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.018em;
    font-weight: 400;
    color: var(--ink);
    max-width: 18ch;
  }

  .contact__lede {
    margin: 0;
    color: var(--ink-soft);
    max-width: 50ch;
  }

  /* Timeline */
  .contact__tline {
    list-style: none;
    margin: 0;
    padding: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 0.5px solid var(--line);
    border-bottom: 0.5px solid var(--line);
  }
  .contact__tline li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    align-items: baseline;
  }
  .contact__tline-num {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--accent);
    font-weight: 500;
  }
  .contact__tline-label {
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
    font-weight: 500;
  }
  .contact__tline-sub {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mute);
    line-height: 1.5;
  }

  /* Badges trust */
  .contact__badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact__badges li {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
    font-weight: 500;
  }

  /* Columna derecha · mini form + embed */
  .contact__embed-col {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 4vw, 32px);
  }

  /* Mini formulario de pre-llenado */
  .contact__prefill {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(20px, 3vw, 28px);
    border: 0.5px solid var(--line);
    border-radius: 4px;
    background-color: var(--bg);
  }
  .contact__prefill-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--mute);
    font-weight: 500;
  }
  .contact__prefill-help {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .contact__prefill-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact__prefill-field > span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mute);
    font-weight: 500;
  }
  .contact__prefill-field input,
  .contact__prefill-field textarea {
    width: 100%;
    padding: 10px 0;
    background: transparent;
    border: 0;
    border-bottom: 0.5px solid var(--line);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
    transition: border-color 0.3s ease;
    resize: vertical;
  }
  .contact__prefill-field input:focus,
  .contact__prefill-field textarea:focus {
    outline: none;
    border-bottom-color: var(--accent);
  }
  .contact__prefill-field textarea {
    min-height: 72px;
    font-family: var(--font-sans);
  }

  .contact__prefill-cta {
    align-self: flex-start;
    margin-top: 4px;
    padding: 10px 18px;
    background-color: var(--accent);
    color: var(--bg);
    border: 0;
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  .contact__prefill-cta:hover {
    opacity: 0.85;
  }
  .contact__prefill-cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .contact__prefill-foot {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mute);
    font-style: italic;
  }

  /* Embed */
  .contact__cal {
    width: 100%;
    min-height: 640px;
    border: 0.5px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--bg);
  }
  .contact__noscript {
    margin: 24px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }
  .contact__noscript a:hover {
    text-decoration: underline;
  }

  /* Desktop split 5/7 */
  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
    }
    .contact__editorial {
      position: sticky;
      top: 96px;
    }
    .contact__cal {
      min-height: 720px;
    }
  }
</style>

<script>
  // Reveal de items del timeline.
  const reveals = document.querySelectorAll<HTMLElement>('.contact [data-reveal]:not([data-split-reveal])');
  if (reveals.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      reveals.forEach((el) => el.classList.add('is-revealed'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-revealed');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      reveals.forEach((el) => io.observe(el));
    }
  }

  // Mini form de pre-llenado: lee los 3 campos, abre el modal Cal.com con
  // name + notes (combinados: "Negocio: X · Quiero resolver: Y") pre-rellenados.
  // Si todos los campos vienen vacíos, hace scroll al calendario inline.
  import { combinePrefillNotes } from '../lib/contact';

  declare global {
    interface Window {
      Cal: any;
    }
  }

  const form = document.querySelector<HTMLFormElement>('[data-prefill-form]');
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-prefill-submit]');
  const inlineEmbed = document.querySelector<HTMLElement>('[data-cal-inline]');

  submitBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    if (!form) return;

    const name = (form.querySelector<HTMLInputElement>('[data-prefill-name]')?.value || '').trim();
    const business = (form.querySelector<HTMLInputElement>('[data-prefill-business]')?.value || '').trim();
    const notesRaw = (form.querySelector<HTMLTextAreaElement>('[data-prefill-notes]')?.value || '').trim();
    const notes = combinePrefillNotes(business, notesRaw);

    // Si no llenó nada, simplemente lleva al calendario inline.
    if (!name && !notes) {
      inlineEmbed?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }

    // Abre el modal Cal.com con prefill. Requiere que CalRuntime ya haya
    // inicializado el namespace 'onboarding-20min'.
    const cal = window.Cal?.ns?.['onboarding-20min'];
    if (typeof cal === 'function') {
      cal('modal', {
        calLink: 'omaralvarezo/onboarding-20min',
        config: {
          layout: 'month_view',
          theme: 'light',
          prefill: {
            ...(name ? { name } : {}),
            ...(notes ? { notes } : {}),
          },
        },
      });
    } else {
      // Fallback: si Cal no cargó, lleva al calendario inline sin pre-llenado.
      inlineEmbed?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
</script>
