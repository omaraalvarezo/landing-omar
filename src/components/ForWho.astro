---
import SectionLabel from './SectionLabel.astro';
import { Database, Workflow, Brain } from '@lucide/astro';

const CARDS = [
  {
    n: '01',
    title: 'Dueño de pyme con datos sin usar',
    body: 'Tienes Excel, ventas en POS, reservas en calendario. Y aun así decides por intuición porque abrir los archivos da pereza. Yo paso por ahí — con Claude bien configurado eso se lee solo y te llega un resumen cada mañana.',
    Icon: Database,
  },
  {
    n: '02',
    title: 'CEO que delega mal',
    body: 'Si no contestas tú, no avanza nada. Lo viví con Enzo antes de sistematizar el WhatsApp y el reporte diario. La salida no es contratar más gente, es que el sistema decida y responda por ti en las cosas que no necesitan tu cabeza.',
    Icon: Workflow,
  },
  {
    n: '03',
    title: 'Emprendedor con criterio de negocios',
    body: 'Sabes leer un P&L, sabes lo que es CAC, pero no has metido IA porque parece moda o porque parece técnica. Te muestro qué uso en mis dos negocios, qué descarté y por qué. Sin venderte humo.',
    Icon: Brain,
  },
];
---

<section id="para-quien" class="forwho scroll-mt-24" aria-labelledby="forwho-title">
  <div class="container-page forwho__grid">
    <div class="forwho__label">
      <SectionLabel number="02" title="PARA QUIÉN" />
    </div>

    <div class="forwho__content">
      <h2 id="forwho-title" class="h2-section forwho__headline" data-split-reveal style="--reveal-stagger: 35ms;">
        Trabajo bien con tres tipos de personas. Si te ves <span class="accent-italic">acá</span>, hablemos.
      </h2>

      <ul class="forwho__cards" role="list">
        {CARDS.map(({ n, title, body, Icon }) => (
          <li class="forwho-card" data-reveal>
            <Icon class="forwho-card__icon" size={160} stroke-width={0.6} aria-hidden="true" />
            <p class="forwho-card__num">{n}</p>
            <h3 class="forwho-card__title">{title}</h3>
            <p class="forwho-card__body">{body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .forwho {
    padding-block: clamp(96px, 14vw, 200px);
    border-top: 0.5px solid var(--line);
  }

  .forwho__grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }

  .forwho__content {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 80px);
  }

  .forwho__headline {
    margin: 0;
    max-width: 18ch;
  }

  .forwho__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .forwho-card {
    position: relative;
    overflow: hidden;
    padding: 28px 24px 32px;
    border: 0.5px solid var(--line);
    border-radius: 4px;
    background-color: var(--bg);
    transition:
      transform 0.4s var(--ease-out-expo),
      border-color 0.3s ease;
    isolation: isolate;
  }
  .forwho-card:hover {
    transform: translateY(-2px);
    border-color: var(--line-hi);
  }
  .forwho-card:hover .forwho-card__num {
    color: var(--accent);
  }

  .forwho-card__icon {
    position: absolute;
    right: -20px;
    bottom: -20px;
    color: var(--ink);
    opacity: 0.06;
    z-index: 0;
    pointer-events: none;
  }
  :global([data-theme='dark']) .forwho-card__icon {
    opacity: 0.10;
  }

  .forwho-card__num {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--mute);
    margin: 0 0 24px;
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
  }

  .forwho-card__title {
    position: relative;
    z-index: 1;
    margin: 0 0 12px;
    font-size: clamp(20px, 2.4vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--ink);
  }

  .forwho-card__body {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--mute);
    max-width: 38ch;
  }

  @media (min-width: 768px) {
    .forwho__cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .forwho-card { padding: 32px 28px 36px; }
  }

  @media (min-width: 1024px) {
    .forwho__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .forwho__cards { gap: 16px; }
  }
</style>
