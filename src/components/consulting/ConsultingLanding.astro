    .fit__panels { grid-template-columns: 1fr; }
    .fit__no { margin: 18px 0 0; }
    .cost h2,
    .cost__answer { font-size: clamp(64px, 20vw, 100px); }
    .faq summary { grid-template-columns: 28px 1fr 20px; gap: 10px; }
    .faq details > p { margin-left: 38px; }
    .reserve__price strong { font-size: 84px; }
    .footer { grid-template-columns: 1fr; }
    .footer > p { grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .nav-shell { transition: none; }
    .hero { height: auto; }
    .hero__sticky { position: relative; min-height: 100svh; }
    .hero__moment { display: none; transition: none; }
    .hero__moment--final { display: block; opacity: 1 !important; pointer-events: auto; transform: translateY(-50%) !important; }
    .hero__progress b { transform: scaleX(1); }
    .receipt,
    .receipt:hover,
    .fit__yes,
    .fit__no,
    .ui { transform: none; transition: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero-scroll]');
  const ignition = document.querySelector<HTMLElement>('[data-system-ignition]');
  const systemStatus = document.querySelector<HTMLElement>('[data-system-status]');
  const systemTelemetry = document.querySelector<HTMLElement>('[data-system-telemetry]');
  const phaseLabel = document.querySelector<HTMLElement>('[data-phase-label]');
  const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
  const navAction = document.querySelector<HTMLAnchorElement>('[data-nav-action]');
  const navLabel = document.querySelector<HTMLElement>('[data-nav-label]');
  const systemsSection = document.querySelector<HTMLElement>('#sistemas');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const phaseContent = [
    ['señales sueltas', 'ESTADO / SIN CONECTAR', 'SEÑALES SUELTAS'],
    ['venta aislada', 'ESTADO / OPORTUNIDAD ABIERTA', 'ENTRA EL LEAD'],
    ['operación aislada', 'ESTADO / ENTREGA SIN MEMORIA', 'SE ROMPE EL RECORRIDO'],
    ['sistema conectado', 'ESTADO / 4C EN LÍNEA', 'SISTEMA CONECTADO'],
  ];

  let currentPhase = -1;
  let frame = 0;
  let heroVisible = true;
  let previousScrollY = window.scrollY;

  const setPhase = (next: number) => {
    if (!hero || next === currentPhase) return;
    currentPhase = next;
    hero.dataset.phase = String(next);
    if (ignition) ignition.dataset.phase = String(next);
    if (systemStatus) systemStatus.textContent = phaseContent[next][0];
    if (systemTelemetry) systemTelemetry.textContent = phaseContent[next][1];
    if (phaseLabel) phaseLabel.textContent = phaseContent[next][2];
  };

  const updateHero = () => {
    frame = 0;
    if (!hero || !heroVisible) return;

    if (reducedMotion.matches) {
      hero.style.setProperty('--hero-progress', '1');
      setPhase(3);
      return;
    }

    const rect = hero.getBoundingClientRect();
    const distance = Math.max(1, hero.offsetHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, -rect.top / distance));
    const phase = progress < .22 ? 0 : progress < .46 ? 1 : progress < .7 ? 2 : 3;
    hero.style.setProperty('--hero-progress', progress.toFixed(3));
    setPhase(phase);
  };

  const requestHeroUpdate = () => {
    if (!frame) frame = window.requestAnimationFrame(updateHero);
    if (siteHeader) siteHeader.dataset.condensed = String(window.scrollY > 44);
    const scrollDelta = window.scrollY - previousScrollY;
    if (siteHeader && !siteHeader.matches(':focus-within')) {
      if (window.scrollY < 90 || scrollDelta < -6) siteHeader.dataset.hidden = 'false';
      else if (scrollDelta > 6) siteHeader.dataset.hidden = 'true';
    }
    previousScrollY = window.scrollY;
    const canReserve = systemsSection
      ? window.scrollY > systemsSection.offsetTop - window.innerHeight * .55
      : false;
    if (navAction) navAction.href = canReserve ? '#reservar' : '#taller';
    if (navLabel) navLabel.textContent = canReserve ? 'reservar 2 horas' : 'empezar el recorrido';
  };

  if (hero) {
    const observer = new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting;
      if (heroVisible) requestHeroUpdate();
    }, { rootMargin: '20% 0px' });
    observer.observe(hero);
    window.addEventListener('scroll', requestHeroUpdate, { passive: true });
    window.addEventListener('resize', requestHeroUpdate, { passive: true });
    reducedMotion.addEventListener?.('change', requestHeroUpdate);
    requestHeroUpdate();
  }

  if (ignition && window.matchMedia('(pointer: fine)').matches && !reducedMotion.matches) {
    ignition.addEventListener('pointermove', (event) => {
      const rect = ignition.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;
      ignition.style.setProperty('--pointer-x', `${x.toFixed(1)}%`);
      ignition.style.setProperty('--pointer-y', `${y.toFixed(1)}%`);
    }, { passive: true });
  }
</script>
