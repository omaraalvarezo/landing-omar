  .session__route { list-style: none; margin: clamp(80px, 10vw, 140px) 0 0; padding: 0; border-top: 3px solid var(--ink); }
  .session__route li { display: grid; grid-template-columns: minmax(190px, .4fr) 1.6fr; gap: clamp(28px, 6vw, 100px); padding: 28px 0; border-bottom: 1px solid rgba(19,17,24,.38); }
