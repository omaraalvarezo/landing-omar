---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/ibm-plex-sans/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';

import { getCollection } from 'astro:content';
import ConsultingContact from './ConsultingContact.astro';
import ConversionCTA from './ConversionCTA.astro';
import SystemIgnition from './SystemIgnition.astro';
import Ladder from '../home/Ladder.astro';
import SistemaEnzo from '../home/SistemaEnzo.astro';
import contenidoDetailing from '../../data/sistema-enzo-detailing-contenido.json';
import { SOCIALS } from '../../lib/contact';
import { bogotaToday } from '../../lib/directory';
import { getProduct, isProductOnSale } from '../../lib/products';
import { publicRecibo } from '../../lib/recibos';
import type { SistemaContent } from '../../lib/sistema';
import {
  QUESTION_HREF,
  foreignAnswer,
  guaranteeAnswer,
  hasGuarantee,
  longDate,
  toolsAnswer,
  videosAnswer,
} from '../../lib/sistema-copy';

const year = new Date().getFullYear();

const sistema = getProduct('enzo-detailing');
if (!sistema) throw new Error('HOME_SIN_PRODUCTO_SISTEMA_ENZO');
// Si la página del sistema no está publicada (falta o es borrador), el home no muestra la sección
// ni la pregunta "qué incluye", y los botones del sistema bajan a la escalera.
const sistemaEntry =
  (await getCollection('sistemas')).find((entry) => entry.data.product === 'enzo-detailing' && !entry.data.draft) ?? null;
const sistemaPublished = sistemaEntry !== null;
const includesFaq = sistemaEntry?.data.faqs[0] ?? null;
if (sistemaEntry && !includesFaq) throw new Error('HOME_SISTEMA_ENZO_SIN_FAQ');
const sistemaHref = sistemaPublished ? sistema.page : '#escalera';
const sistemaAnchor = sistemaPublished ? '#sistema-enzo' : '#escalera';
const sistemaContent = contenidoDetailing as SistemaContent;

// Cifras de mis negocios con fuente registrada (wiki/sintesis/recibos-operativos.md). El origen
// se imprime siempre; "aprox." va aparte para que el número respire.
const RECEIPTS = [
  { id: 'inspeccion-puntos', eyebrow: 'INSPECCIÓN / ENZO', color: '#c8ff3d' },
  { id: 'fotos-salida-antes', eyebrow: 'ENTREGA / ENZO', color: '#c79aff' },
  { id: 'cotizacion-minutos', eyebrow: 'COTIZACIÓN / ENZO', color: '#ff6b45' },
  { id: 'pl-arkhe', eyebrow: 'P&L / ARKHĒ', color: '#4b5fe3', light: true },
].map((receipt) => {
  const recibo = publicRecibo(receipt.id);
  const approx = recibo.value.startsWith('aprox. ');
  return { ...receipt, ...recibo, approx, figure: approx ? recibo.value.slice('aprox. '.length) : recibo.value };
});

const ordenesTaller = publicRecibo('ordenes-taller');

const PROJECTS = [
  {
    id: 'enzo',
    number: '01',
    name: 'Enzo Motorsport',
    label: 'NEGOCIO FÍSICO · AUTOMOTRIZ',
    title: 'De cotizar por memoria a operar con trazabilidad.',
    body: 'Caja, taller, cotización, garantías, asistencia, documentos y reportes: piezas construidas sobre el negocio que sí abre la puerta cada mañana.',
    metric: ordenesTaller.value.replace(/^aprox\. /, ''),
    metricApprox: ordenesTaller.value.startsWith('aprox. '),
    metricLabel: ordenesTaller.label,
    metricOrigin: ordenesTaller.origin,
  },
  {
    id: 'arkhe',
    number: '02',
    name: 'Arkhē',
    label: 'NEGOCIO FÍSICO · ESPACIOS',
    title: 'Reservar, pagar y entender cómo se usa cada metro.',
    body: 'Checkout, validación Wompi, reservas, mapas operativos y análisis histórico para dejar de administrar el espacio a oscuras.',
    metric: 'Wompi',
    metricLabel: 'pago y reserva en línea',
  },
  {
    id: 'adjudika',
    number: '03',
    name: 'Adjudika',
    label: 'SOFTWARE · CONTRATACIÓN PÚBLICA',
    title: 'Leer procesos complejos sin perder el criterio humano.',
    body: 'Radar SECOP II, análisis documental, pagos por créditos, seguridad multiempresa y monitoreo para decidir dónde sí competir.',
    metric: 'SECOP II',
    metricLabel: 'datos conectados',
  },
  {
    id: 'grupo',
    number: '04',
    name: 'Grupo Enzo',
    label: 'CONTROL · DOS EMPRESAS',
    title: 'Un solo pulso para saber qué requiere atención.',
    body: 'Indicadores, alertas, reportes y responsables separados por negocio. Menos persecución; más capacidad de decidir.',
    metric: '2',
    metricLabel: 'negocios separados en una sola app',
  },
];

// FAQ del producto y de la lista de espera. Las respuestas que dependen de datos (herramientas,
// fecha de videos, garantía, tarjetas de fuera) salen de `sistema-copy`, igual que en
// /sistemas/detailing.
const sistemaOnSale = isProductOnSale(sistema, bogotaToday());
const dueIso = sistema.presale?.videosDueDate ?? null;
const dueDate = dueIso ? longDate(dueIso) : '';
const guarantee = hasGuarantee(sistema.guaranteeDays) ? sistema.guaranteeDays : null;
const foreign = foreignAnswer(sistema.acceptsForeignCards);

type Faq = { q: string; a: string; link?: { href: string; label: string; trackId: string; contact?: boolean } };

const FAQ: Faq[] = [
  ...(includesFaq
    ? [{ q: includesFaq.q, a: includesFaq.a, link: { href: sistemaHref, label: 'Ver el sistema de Enzo', trackId: 'sistema-enzo' } }]
    : []),
  { q: '¿Qué herramientas pide y cuánto cuestan al mes?', a: toolsAnswer(sistemaContent.tools) },
  { q: '¿Cuándo llegan los videos?', a: videosAnswer({ dueDate, onSale: sistemaOnSale, place: 'fuera' }) },
  ...(guarantee !== null ? [{ q: '¿Cómo funciona la garantía?', a: guaranteeAnswer(guarantee) }] : []),
  {
    q: foreign.q,
    a: foreign.a,
    ...(foreign.linkLabel ? { link: { href: QUESTION_HREF, label: foreign.linkLabel, trackId: 'lista' } } : {}),
  },
  {
    q: '¿Por qué no me lo instalas ni hacemos una sesión?',
    a: 'Porque mi tiempo hoy está en operar Enzo y Arkhē. Lo que vendo aquí lo montas tú solo, con la guía y las plantillas; lo que pide mi tiempo en persona queda en lista de espera. Hoy no estoy tomando instalaciones ni sesiones. Si te anotas, te escribo cuando abra cupo. Si es una pregunta del sistema, te respondo por correo.',
    link: { href: '#contacto', label: 'Anotarme en la lista', trackId: 'lista', contact: true },
  },
];
---

<div class="experience">
  <header class="nav-shell" data-site-header>
    <a class="wordmark" href="#inicio" aria-label="Omar Álvarez, volver al inicio">
      <strong>omar</strong><i aria-hidden="true"></i><span>álvarez</span>
    </a>
    <nav aria-label="Navegación principal">
      <a href="#taller">cómo opero</a>
      <a href="#sistemas">lo que construí</a>
      <a href="#escalera">por dónde empezar</a>
      <a href="/herramientas-ia" class="nav-shell__tools">herramientas</a>
      <a
        class="nav-shell__action"
        href={sistemaHref}
        data-track="escalon_click"
        data-track-id="sistema-enzo"
        data-track-placement="nav"
      >
        <span>ver el sistema de Enzo</span>
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </header>

  <section class="hero" id="inicio" data-hero-scroll data-phase="0" aria-label="Un negocio convertido en sistema">
    <div class="hero__sticky">
      <div class="hero__noise" aria-hidden="true"></div>
      <div class="hero__meta">
        <span>NEGOCIOS REALES / SISTEMAS REALES</span>
        <span>ENZO MOTORSPORT · ARKHĒ</span>
        <span>CÚCUTA / COLOMBIA</span>
      </div>

      <div class="hero__copy">
        <div class="hero__moment" data-moment="0">
          <p class="hero__cue">OJO / AQUÍ EMPIEZA</p>
          <p class="hero__display">Mira esto.</p>
          <p class="hero__aside">Entra un trabajo. Hay cuatro momentos donde se te puede ir la plata o la confianza.</p>
        </div>

        <div class="hero__moment" data-moment="1">
          <p class="hero__cue">01 RECEPCIÓN · 02 CHECKLIST</p>
          <p class="hero__display hero__display--medium">Llegó el carro.<br />Se hizo el trabajo.<br /><span>¿Quién revisó?</span></p>
        </div>

        <div class="hero__moment" data-moment="2">
          <p class="hero__cue">03 ENTREGA · 04 SEGUIMIENTO</p>
          <p class="hero__display hero__display--medium">Salió sin firma.<br />Nadie escribió.<br /><span>¿Y si vuelve con un reclamo?</span></p>
        </div>

        <div class="hero__moment hero__moment--final" data-moment="3">
          <p class="hero__cue">RECIBIR → HACER → ENTREGAR → SEGUIR</p>
          <h1>Mis negocios no corren con memoria.<br /><span>Corren con sistemas.</span></h1>
          <p class="hero__lead">Opero un taller de detailing y un coworking con piezas que construí yo. Mira cómo, y llévate el sistema con el que Enzo entrega sin olvidos.</p>
          <div class="hero__actions">
            <a
              class="hero__button"
              href={sistemaAnchor}
              data-track="escalon_click"
              data-track-id="sistema-enzo"
              data-track-placement="hero"
            >
              ver el sistema de Enzo <span aria-hidden="true">↓</span>
            </a>
            <a class="hero__secondary" href="#taller">ver cómo opero <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>

      <div class="hero__machine">
        <SystemIgnition />
      </div>

      <div class="hero__input" aria-hidden="true">
        <span>FOTOS</span><span>CHECKLIST</span><span>FIRMA</span><span>WHATSAPP</span><span>RESEÑA</span>
      </div>

      <div class="hero__progress" aria-hidden="true">
        <span>SCROLL</span>
        <i><b></b></i>
        <span data-phase-label>TRABAJO SUELTO</span>
      </div>
    </div>
  </section>

  <section class="workshop" id="taller" aria-labelledby="workshop-title">
    <div class="workshop__intro">
      <p class="overline">NO VENGO DE UNA AGENCIA</p>
      <h2 id="workshop-title">Tengo dos negocios físicos.<br /><span>El código vino después.</span></h2>
      <div class="workshop__text">
        <p>Primero me cansé de cotizar en Excel, perseguir reportes, reconstruir cierres y depender de que alguien se acordara.</p>
        <p>Lo que enseño en TikTok no son demos. Son piezas que construí porque mis propias empresas las necesitaban para vender, cumplir y seguir atendiendo.</p>
      </div>
    </div>

    <div class="receipts" role="group" aria-label="Cifras de mis negocios, con su origen">
      {RECEIPTS.map((receipt, index) => (
        <article
          class:list={['receipt', receipt.light && 'receipt--light']}
          style={`--receipt-color:${receipt.color}; --receipt-tilt:${index % 2 === 0 ? '-1.5deg' : '1.2deg'}`}
        >
          <p>{receipt.eyebrow}</p>
          {receipt.approx && <span class="receipt__approx">aprox.</span>}
          <strong>{receipt.figure}</strong>
          <small>{receipt.label}</small>
          <em>{receipt.origin}</em>
        </article>
      ))}
    </div>

    <div class="workshop__note">
      <span aria-hidden="true">*</span>
      <p>No tienes que copiar mis herramientas.<br /><strong>Tienes que entender qué decisión deben mejorar las tuyas.</strong></p>
    </div>
  </section>

  <section class="bridge" aria-label="Principio de trabajo">
    <p class="overline">LA VAINA ES ASÍ</p>
    <p class="bridge__statement">No empezamos diciendo <s>“metamos IA”.</s></p>
    <p class="bridge__answer">Empezamos encontrando dónde se pierde una oportunidad, una hora, una decisión o un cliente.</p>
    <div class="bridge__tape" aria-hidden="true">EL PROBLEMA PRIMERO · LA HERRAMIENTA DESPUÉS ·</div>
  </section>

  <section class="systems" id="sistemas" aria-labelledby="systems-title">
    <header class="systems__head">
      <p class="overline">ESTO YA LO OPERO</p>
      <h2 id="systems-title">Lo construí porque me hacía falta.</h2>
      <p>Desliza y abre el taller. Cada sistema empezó con un problema concreto, no con ganas de sumar otra plataforma.</p>
    </header>

    <div class="case-rail" role="list" tabindex="0" aria-label="Proyectos construidos por Omar">
      {PROJECTS.map((project) => (
        <article class={`case case--${project.id}`} role="listitem">
          <div class="case__copy">
            <div class="case__top">
              <span>{project.number} / 04</span>
              <span>{project.label}</span>
            </div>
            <p class="case__name">{project.name}</p>
            <h3>{project.title}</h3>
            <p class="case__body">{project.body}</p>
            <div class="case__metric">
              {project.metricApprox && <em>aprox.</em>}
              <strong>{project.metric}</strong>
              <span>{project.metricLabel}</span>
              {project.metricOrigin && <small>{project.metricOrigin}</small>}
            </div>
            {project.id === 'enzo' && sistemaPublished && (
              <a
                class="case__link"
                href={sistemaHref}
                data-track="escalon_click"
                data-track-id="sistema-enzo"
                data-track-placement="rail"
              >
                las 4 piezas de la entrega, para tu taller <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>

          <div class="case__visual" aria-hidden="true">
            {project.id === 'enzo' && (
              <div class="ui ui--quote">
                <div class="ui__bar"><i></i><i></i><i></i><span>COTIZACIÓN / ENZ-————</span></div>
                <div class="quote-car"><span>BMW</span><strong>M4</strong></div>
                <div class="quote-lines"><span>PPF frontal</span><b>$ ———</b><span>Tiempo estimado</span><b>02 días</b><span>Estado</span><b>LISTO PARA ENVIAR</b></div>
                <div class="quote-action">GENERAR COTIZACIÓN ↗</div>
              </div>
            )}
            {project.id === 'arkhe' && (
              <div class="ui ui--map">
                <div class="ui__bar"><i></i><i></i><i></i><span>MAPA / DISPONIBILIDAD AHORA</span></div>
                <div class="floor-map">
                  <span class="room room--one">SALA 01<small>LIBRE</small></span>
                  <span class="room room--two">SALA 02<small>14:30</small></span>
                  <span class="room room--three">FLEX<small>8 / 12</small></span>
                  <span class="room room--four">TERRAZA<small>ACTIVA</small></span>
                </div>
                <div class="map-legend"><span><i></i>Disponible</span><span><i></i>Reservado</span></div>
              </div>
            )}
            {project.id === 'adjudika' && (
              <div class="ui ui--radar">
                <div class="ui__bar"><i></i><i></i><i></i><span>RADAR / SECOP II</span></div>
                <div class="radar-score"><span>OPORTUNIDAD</span><strong>86</strong><small>/ 100</small></div>
                <div class="radar-list"><span><i></i>Capacidad jurídica<b>LISTO</b></span><span><i></i>Experiencia requerida<b>REVISAR</b></span><span><i></i>Presupuesto<b>EN RANGO</b></span></div>
                <div class="radar-wave"></div>
              </div>
            )}
            {project.id === 'grupo' && (
              <div class="ui ui--pulse">
                <div class="ui__bar"><i></i><i></i><i></i><span>PULSO / LUNES 07:00</span></div>
                <div class="pulse-number"><span>HOY REQUIERE ATENCIÓN</span><strong>03</strong></div>
                <div class="pulse-bars"><span style="--bar:72%">Cotizaciones <b>——%</b></span><span style="--bar:46%">Ocupación <b>——%</b></span><span style="--bar:88%">Entregas <b>——%</b></span></div>
                <div class="pulse-alert">01 alerta asignada · no perseguir por chat</div>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
    <p class="systems__scroll"><span aria-hidden="true">←</span> ARRASTRA / DESLIZA <span aria-hidden="true">→</span></p>
    {sistemaPublished && (
    <ConversionCTA
      kicker="YA VISTE QUE ESTO NO ES UNA DEMO"
      title="¿Tienes un taller y se te pierden las entregas?"
      body="Te paso las cuatro piezas con las que entregamos en Enzo: los textos, las listas y las plantillas, para montarlas con herramientas que ya existen."
      placement="systems"
    />
    )}
  </section>

  {sistemaPublished && <SistemaEnzo />}

  <Ladder />

  <section class="faq" aria-labelledby="faq-title">
    <header>
      <p class="overline">SIN LETRA PEQUEÑA</p>
      <h2 id="faq-title">Antes de comprar, esto tiene que estar claro.</h2>
    </header>
    <div class="faq__list">
      {FAQ.map((faq, index) => (
        <details open={index === 0}>
          <summary><span>{String(index + 1).padStart(2, '0')}</span><strong>{faq.q}</strong><i aria-hidden="true">+</i></summary>
          <p>{faq.a}</p>
          {faq.link && (
            <p class="faq__link">
              <a
                href={faq.link.href}
                data-track="escalon_click"
                data-track-id={faq.link.trackId}
                data-track-placement="faq"
                data-contact-link={faq.link.contact ? '' : undefined}
                data-cta-placement={faq.link.contact ? 'faq' : undefined}
              >
                {faq.link.label} <span aria-hidden="true">↗</span>
              </a>
            </p>
          )}
        </details>
      ))}
    </div>
  </section>

  <section class="reserve" id="contacto" aria-labelledby="reserve-title">
    <div class="reserve__intro">
      <p class="overline">LISTA DE ESPERA</p>
      <h2 id="reserve-title">Hoy no tomo cupos.</h2>
      <p class="reserve__lead">Instalarte el sistema o sentarme contigo a revisar tu negocio pide mi tiempo, y hoy está en Enzo y Arkhē. Si lo quieres igual, anótate: así sé cuánta gente lo pide y te escribo yo cuando abra cupo.</p>
      <dl>
        <div><dt>Qué es</dt><dd>lista de espera · sin costo</dd></div>
        <div><dt>Instalación y sesión</dt><dd>cerradas por ahora</dd></div>
        <div><dt>Pregunta del sistema</dt><dd>te respondo por correo</dd></div>
        <div><dt>Quién lo lee</dt><dd>yo</dd></div>
      </dl>
    </div>
    <ConsultingContact />
  </section>

  <footer class="footer">
    <div class="footer__brand">
      <a class="wordmark wordmark--footer" href="#inicio" aria-label="Omar Álvarez, volver al inicio"><strong>omar</strong><i aria-hidden="true"></i><span>álvarez</span></a>
      <p>Empresas de servicios que dejan de improvisar.</p>
    </div>
    <nav aria-label="Sitio y redes">
      <a href="/sistemas">Sistemas</a>
      <a href="/herramientas-ia">Herramientas IA</a>
      <a href="/recursos">Recursos</a>
      <a href={SOCIALS.tiktok} target="_blank" rel="noopener">TikTok ↗</a>
      <a href={SOCIALS.instagram} target="_blank" rel="noopener">Instagram ↗</a>
      <a href={SOCIALS.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href="/sobre-mi">Sobre mí</a>
      <a href="/privacidad">Privacidad</a>
      <a href="/terminos">Términos</a>
    </nav>
    <p>© {year} · Cúcuta, Colombia</p>
  </footer>
</div>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
    background: #131118;
  }

  :global(body) {
    margin: 0;
    background: #131118 !important;
  }

  .experience {
    --ink: #131118;
    --ink-soft: #1d1921;
    --bone: #fff8ea;
    --bone-muted: #e2dccc;
    --coral: #ff6b45;
    --purple: #c79aff;
    --cobalt: #4b5fe3;
    --lime: #c8ff3d;
    --sky: #bdd9d8;
    --display: 'Bricolage Grotesque Variable', 'Arial Narrow', sans-serif;
    --body: 'IBM Plex Sans Variable', Arial, sans-serif;
    --data: 'IBM Plex Mono', monospace;
    min-height: 100vh;
    color: var(--ink);
    background: var(--bone);
    font-family: var(--body);
    font-size: 16px;
    font-variation-settings: 'wdth' 96;
  }

  .experience *,
  .experience *::before,
  .experience *::after { box-sizing: border-box; }

  .experience h1,
  .experience h2,
  .experience h3,
  .experience p { margin-top: 0; }

  .experience a { color: inherit; text-decoration: none; }

  .overline {
    margin-bottom: 26px;
    font-family: var(--data);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .nav-shell {
    position: fixed;
    z-index: 80;
    top: 16px;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    width: min(calc(100% - 32px), 1240px);
    min-height: 58px;
    padding: 8px 9px 8px 18px;
    color: var(--bone);
    background: rgba(19, 17, 24, .82);
    border: 1px solid rgba(255, 248, 234, .16);
    border-radius: 999px;
    box-shadow: 0 16px 56px rgba(0, 0, 0, .17);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
    transition: min-height .35s ease, background-color .35s ease;
  }

  .nav-shell[data-condensed='true'] {
    min-height: 50px;
    background: rgba(19, 17, 24, .94);
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--display);
    font-size: 18px;
    font-stretch: 84%;
    letter-spacing: -.045em;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark strong { font-weight: 760; }
  .wordmark span { font-weight: 420; }
  .wordmark i { align-self: center; width: 7px; height: 7px; background: var(--coral); border-radius: 50%; }

  .nav-shell nav { display: flex; align-items: center; gap: clamp(14px, 2.2vw, 28px); }
  .nav-shell nav a {
    font-family: var(--data);
    font-size: 9px;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color .25s ease;
  }
  .nav-shell nav a:hover { color: var(--lime); }
  .nav-shell__action {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 20px;
    min-height: 44px;
    padding: 13px 16px;
    overflow: hidden;
    color: var(--ink) !important;
    background: var(--lime);
    border-radius: 999px;
    box-shadow: 0 0 0 rgba(200, 255, 61, 0);
    transition: color .25s ease, background-color .25s ease, transform .25s cubic-bezier(.16, 1, .3, 1), box-shadow .25s ease !important;
  }
  .nav-shell__action > span { position: relative; z-index: 1; }
  .nav-shell__action::after {
    content: '';
    position: absolute;
    inset: -70% auto -70% -25%;
    width: 18%;
    background: rgba(255,255,255,.78);
    filter: blur(8px);
    opacity: 0;
    transform: skewX(-18deg);
    animation: nav-cta-sheen 1.15s .7s cubic-bezier(.16, 1, .3, 1) both;
  }
  .nav-shell__action:hover { background: var(--bone); box-shadow: 0 8px 30px rgba(200, 255, 61, .18); transform: translateY(-2px); }
  .nav-shell__action:active { transform: scale(.98); }
  .nav-shell__action:focus-visible { outline: 3px solid var(--bone); outline-offset: 4px; }

  .hero {
    --hero-progress: 0;
    height: 320vh;
    height: 320svh;
    color: var(--bone);
    background: var(--ink);
  }

  /* El escenario mide exactamente un viewport. Con min-height la máquina SVG lo estiraba
     en laptops bajas (1366×768, 1280×720) y el CTA del momento final quedaba bajo el
     pliegue mientras el hero estaba pegado. El padding superior deja libre la meta. */
  .hero__sticky {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(400px, 1.08fr);
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    padding: clamp(114px, 11vh, 128px) clamp(20px, 4.5vw, 70px) 28px;
    isolation: isolate;
  }

  .hero__sticky::after {
    content: '';
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 49.9%, rgba(255,255,255,.055) 50%, transparent 50.1%),
      linear-gradient(rgba(255,255,255,.032) 1px, transparent 1px);
    background-size: 100% 100%, 100% 96px;
    opacity: .8;
  }

  .hero__noise {
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
    opacity: .055;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .hero__meta {
    position: absolute;
    z-index: 5;
    top: 94px;
    left: clamp(20px, 4.5vw, 70px);
    right: clamp(20px, 4.5vw, 70px);
    display: flex;
    justify-content: space-between;
    gap: 18px;
    color: rgba(255, 248, 234, .52);
    font-family: var(--data);
    font-size: 8px;
    letter-spacing: .13em;
  }

  /* Cada momento ocupa toda el área del copy y se centra con `safe center`: si el texto no
     cabe (móvil, pantallas bajas) se alinea arriba en vez de desbordar hacia la nav. */
  .hero__copy { position: relative; z-index: 6; align-self: stretch; min-height: min(58vh, 550px); }
  .hero__moment {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    max-width: 690px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(34px) rotate(.6deg);
    transition: opacity .5s ease, transform .85s cubic-bezier(.16, 1, .3, 1);
  }
  .hero[data-phase='0'] [data-moment='0'],
  .hero[data-phase='1'] [data-moment='1'],
  .hero[data-phase='2'] [data-moment='2'],
  .hero[data-phase='3'] [data-moment='3'] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) rotate(0);
  }

  .hero__cue {
    margin-bottom: 24px;
    color: var(--lime);
    font-family: var(--data);
    font-size: 9px;
    letter-spacing: .14em;
  }

  .hero__display,
  .hero h1 {
    margin-bottom: 26px;
    font-family: var(--display);
    font-size: clamp(68px, 9.5vw, 150px);
    font-stretch: 76%;
    font-weight: 760;
    line-height: .79;
    letter-spacing: -.075em;
  }
  .hero__display--medium { font-size: clamp(56px, 7.8vw, 124px); line-height: .84; }
  .hero__display span { color: var(--purple); }
  .hero h1 { max-width: 10.5ch; font-size: clamp(50px, 6.4vw, 100px); line-height: .87; }
  .hero h1 span { color: var(--lime); }
  .hero__aside,
  .hero__lead { max-width: 52ch; margin-bottom: 0; color: rgba(255, 248, 234, .67); font-size: clamp(16px, 1.4vw, 20px); line-height: 1.5; }
  .hero__lead { max-width: 46ch; margin-bottom: 28px; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; }
  .hero__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    min-width: 280px;
    min-height: 52px;
    padding: 15px 17px;
    color: var(--ink) !important;
    background: var(--lime);
    border: 1px solid var(--lime);
    box-shadow: 6px 6px 0 var(--coral);
    font-family: var(--data);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    transition: transform .25s ease, background-color .25s ease, box-shadow .25s ease;
  }
  .hero__button:hover { background: var(--bone); box-shadow: 9px 9px 0 var(--purple); transform: translate(-2px, -3px); }
  .hero__button:active { transform: scale(.985); }
  .hero__button:focus-visible { outline: 3px solid var(--bone); outline-offset: 5px; }
  .hero__secondary {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    min-height: 48px;
    padding: 12px 4px;
    color: rgba(255, 248, 234, .68) !important;
    border-bottom: 1px solid rgba(255, 248, 234, .28);
    font-family: var(--data);
    font-size: 9px;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color .25s ease, border-color .25s ease, transform .25s ease;
  }
  .hero__secondary:hover { color: var(--bone) !important; border-color: var(--lime); transform: translateX(4px); }
  .hero__secondary:focus-visible { outline: 2px solid var(--lime); outline-offset: 4px; }

  .hero__machine { position: relative; z-index: 2; align-self: center; justify-self: end; }
  .hero__machine::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 15%;
    background: rgba(93, 114, 255, calc(.02 + var(--hero-progress) * .09));
    filter: blur(80px);
    border-radius: 50%;
  }

  .hero__input {
    position: absolute;
    z-index: 3;
    right: clamp(18px, 3vw, 44px);
    top: 50%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transform: translateY(-50%);
  }
  .hero__input span {
    padding: 7px 9px;
    color: rgba(255, 248, 234, .32);
    border: 1px solid rgba(255, 248, 234, .08);
    font-family: var(--data);
    font-size: 7px;
    letter-spacing: .1em;
  }

  .hero__progress {
    position: relative;
    z-index: 6;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    color: rgba(255, 248, 234, .42);
    font-family: var(--data);
    font-size: 8px;
    letter-spacing: .12em;
  }
  .hero__progress i { display: block; height: 1px; overflow: hidden; background: rgba(255, 248, 234, .14); }
  .hero__progress b { display: block; width: 100%; height: 100%; background: var(--lime); transform: scaleX(var(--hero-progress)); transform-origin: left; }

  /* Pantallas bajas: el titular del momento final escala con el alto para que el CTA quepa
     dentro del escenario sin tocar la nav ni la barra de progreso. */
  @media (min-width: 821px) and (max-height: 900px) {
    .hero h1 { margin-bottom: 20px; font-size: clamp(44px, min(6.4vw, 8.2svh), 100px); }
    .hero__lead { margin-bottom: 22px; }
  }
  @media (min-width: 821px) and (max-width: 1050px) and (max-height: 900px) {
    .hero h1 { font-size: clamp(44px, min(5.4vw, 7.2svh), 100px); }
  }

  .workshop { padding: clamp(100px, 12vw, 180px) clamp(20px, 5vw, 80px); background: var(--bone); }
  .workshop__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, .65fr);
    gap: clamp(40px, 8vw, 130px);
    align-items: end;
    max-width: 1440px;
    margin-inline: auto;
  }
  .workshop__intro .overline { grid-column: 1 / -1; margin-bottom: 0; color: #7b6f65; }
  .workshop h2,
  .systems__head h2,
  .faq h2,
  .reserve h2 {
    margin-bottom: 0;
    font-family: var(--display);
    font-size: clamp(54px, 8vw, 122px);
    font-stretch: 78%;
    font-weight: 760;
    line-height: .83;
    letter-spacing: -.07em;
  }
  /* Coral un tono más oscuro: #ff6b45 sobre bone da 2,67:1 y el titular necesita 3:1. */
  .workshop h2 span { color: #f05a32; }
  .workshop__text { max-width: 48ch; font-size: clamp(17px, 1.6vw, 21px); line-height: 1.55; }
  .workshop__text p:last-child { margin-bottom: 0; }

  .receipts {
    display: grid;
    grid-template-columns: 1.05fr .85fr 1.1fr .9fr;
    gap: clamp(10px, 1.6vw, 24px);
    align-items: start;
    max-width: 1440px;
    margin: clamp(80px, 11vw, 155px) auto 0;
  }
  .receipt {
    display: flex;
    flex-direction: column;
    min-height: clamp(310px, 31vw, 450px);
    padding: clamp(22px, 2.6vw, 40px);
    color: var(--ink);
    background: var(--receipt-color);
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(var(--receipt-tilt));
    transition: transform .45s cubic-bezier(.16, 1, .3, 1);
  }
  .receipt:nth-child(2) { margin-top: 74px; }
  .receipt:nth-child(4) { margin-top: 40px; }
  .receipt:hover { transform: rotate(0) translateY(-10px); }
  .receipt--light { color: var(--bone); }
  .receipt > p { min-height: 42px; margin-bottom: 36px; font-family: var(--data); font-size: 9px; letter-spacing: .1em; }
  .receipt strong { display: block; font-family: var(--display); font-size: clamp(42px, 4.4vw, 70px); font-stretch: 76%; line-height: .82; letter-spacing: -.065em; overflow-wrap: anywhere; }
  .receipt__approx { display: block; margin-bottom: 10px; font-family: var(--data); font-size: 10px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  .receipt small { display: block; margin-top: clamp(36px, 4.5vw, 70px); font-size: 14px; line-height: 1.45; }
  .receipt em { display: block; margin-top: auto; padding-top: 22px; font-family: var(--data); font-size: 9px; font-style: normal; letter-spacing: .06em; line-height: 1.5; text-transform: uppercase; opacity: .82; }
  .receipt--light em { opacity: 1; }

  .workshop__note {
    display: flex;
    gap: 28px;
    max-width: 860px;
    margin: clamp(100px, 13vw, 180px) auto 0;
    transform: rotate(-1deg);
  }
  .workshop__note > span { color: var(--purple); font-family: var(--display); font-size: 120px; font-weight: 800; line-height: .55; }
  .workshop__note p { margin-bottom: 0; font-size: clamp(28px, 4vw, 56px); line-height: 1.02; letter-spacing: -.035em; }
  .workshop__note strong { font-weight: 650; text-decoration: underline; text-decoration-color: var(--purple); text-decoration-thickness: .12em; text-underline-offset: .12em; }

  .bridge {
    position: relative;
    overflow: hidden;
    padding: clamp(110px, 14vw, 210px) clamp(20px, 6vw, 96px) clamp(150px, 18vw, 260px);
    color: var(--ink);
    background: var(--sky);
  }
  .bridge .overline { color: #425d5c; }
  .bridge__statement,
  .bridge__answer {
    max-width: 16ch;
    margin-bottom: 28px;
    font-family: var(--display);
    font-size: clamp(48px, 7.2vw, 108px);
    font-stretch: 78%;
    font-weight: 730;
    line-height: .88;
    letter-spacing: -.065em;
  }
  .bridge__statement { color: #587270; }
  .bridge__statement s { text-decoration-color: var(--coral); text-decoration-thickness: .09em; }
  .bridge__answer { max-width: 13.5ch; margin: 0 0 0 auto; }
  .bridge__tape {
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 55px;
    padding: 14px 0;
    color: var(--bone);
    background: var(--ink);
    font-family: var(--data);
    font-size: clamp(12px, 1.5vw, 20px);
    letter-spacing: .12em;
    text-align: center;
    white-space: nowrap;
    transform: rotate(2deg);
  }

  .systems { padding: clamp(120px, 15vw, 220px) 0 80px; overflow: hidden; color: var(--bone); background: var(--ink); }
  .systems__head { display: grid; grid-template-columns: 1fr minmax(250px, .45fr); gap: 52px; align-items: end; padding-inline: clamp(20px, 5vw, 80px); }
  .systems__head .overline { grid-column: 1 / -1; margin-bottom: 0; color: var(--coral); }
  .systems__head h2 { max-width: 9ch; }
  .systems__head > p:last-child { max-width: 42ch; margin-bottom: 0; color: rgba(255, 248, 234, .66); font-size: 18px; line-height: 1.55; }

  .case-rail {
    display: flex;
    gap: clamp(16px, 2.2vw, 34px);
    margin-top: clamp(70px, 9vw, 130px);
    padding: 0 max(20px, calc((100vw - 1440px) / 2)) 28px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-color: var(--lime) rgba(255,255,255,.1);
    scrollbar-width: thin;
  }
  .case-rail::-webkit-scrollbar { height: 6px; }
  .case-rail::-webkit-scrollbar-track { background: rgba(255,255,255,.08); }
  .case-rail::-webkit-scrollbar-thumb { background: var(--lime); }
  .case {
    flex: 0 0 min(82vw, 1080px);
    display: grid;
    grid-template-columns: .82fr 1.18fr;
    min-height: min(75svh, 760px);
    overflow: hidden;
    color: var(--ink);
    scroll-snap-align: center;
  }
  .case--enzo { color: var(--bone); background: #211d14; }
  .case--arkhe { background: var(--coral); }
  .case--adjudika { color: var(--bone); background: var(--cobalt); }
  .case--grupo { background: var(--purple); }
  .case__copy { display: flex; flex-direction: column; padding: clamp(28px, 4vw, 60px); }
  .case__top { display: flex; justify-content: space-between; gap: 20px; margin-bottom: auto; font-family: var(--data); font-size: 8px; letter-spacing: .1em; }
  .case__name { margin: 46px 0 14px; font-family: var(--data); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .case h3 { max-width: 11ch; margin-bottom: 24px; font-family: var(--display); font-size: clamp(42px, 5vw, 74px); font-stretch: 77%; font-weight: 750; line-height: .87; letter-spacing: -.06em; }
  .case__body { max-width: 44ch; margin-bottom: 40px; opacity: .86; line-height: 1.5; }
  .case--adjudika .case__body { opacity: 1; }
  .case__metric { display: flex; flex-wrap: wrap; align-items: end; gap: 8px 14px; margin-top: auto; }
  .case__metric strong { font-family: var(--display); font-size: clamp(44px, 5vw, 76px); font-stretch: 76%; line-height: .8; letter-spacing: -.06em; }
  .case__metric span { max-width: 16ch; font-family: var(--data); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }
  .case__metric em { flex-basis: 100%; font-family: var(--data); font-size: 10px; font-style: normal; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  .case__metric small { flex-basis: 100%; font-family: var(--data); font-size: 9px; letter-spacing: .06em; opacity: .72; }
  .case__link {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin-top: 26px;
    padding: 10px 0;
    color: var(--lime) !important;
    border-bottom: 1px solid currentColor;
    font-family: var(--data);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: transform .25s ease;
  }
  .case__link:hover { transform: translateX(4px); }
  .case__link:focus-visible { outline: 2px solid var(--lime); outline-offset: 4px; }
  .case__visual { display: grid; place-items: center; min-width: 0; padding: clamp(28px, 5vw, 74px); background: rgba(255,255,255,.08); }
  .ui { width: min(100%, 620px); overflow: hidden; background: #f8f3e9; border: 2px solid currentColor; box-shadow: 14px 14px 0 rgba(0,0,0,.26); transform: rotate(1.4deg); }
  .ui__bar { display: flex; align-items: center; gap: 6px; height: 38px; padding: 0 12px; color: #171218; background: #e9e2d7; border-bottom: 1px solid #171218; font-family: var(--data); font-size: 7px; letter-spacing: .08em; }
  .ui__bar i { width: 6px; height: 6px; background: #171218; border-radius: 50%; }
  .ui__bar span { margin-left: auto; }
  .quote-car { display: flex; align-items: baseline; gap: 8px; padding: 34px; color: var(--bone); background: #15130f; }
  .quote-car span { font-family: var(--data); font-size: 9px; letter-spacing: .15em; }
  .quote-car strong { font-family: var(--display); font-size: 70px; line-height: 1; letter-spacing: -.06em; }
  .quote-lines { display: grid; grid-template-columns: 1fr auto; gap: 0; color: #171218; }
  .quote-lines > * { padding: 14px 18px; border-bottom: 1px solid #c8c0b4; font-size: 11px; }
  .quote-lines b { font-family: var(--data); font-size: 9px; text-align: right; }
  .quote-action { padding: 18px; color: #10140e; background: #2daa7a; font-family: var(--data); font-size: 9px; font-weight: 600; text-align: right; }
  .floor-map { position: relative; height: 360px; color: #171218; background: #f5e8dd; }
  .room { position: absolute; display: flex; flex-direction: column; justify-content: space-between; padding: 12px; border: 2px solid #171218; font-family: var(--data); font-size: 8px; letter-spacing: .08em; }
  .room small { font-size: 7px; }
  .room--one { inset: 28px 52% 51% 28px; background: var(--lime); }
  .room--two { inset: 28px 28px 51% 50%; background: var(--purple); }
  .room--three { inset: 52% 36% 28px 28px; background: var(--sky); }
  .room--four { inset: 52% 28px 28px 66%; background: var(--coral); }
  .map-legend { display: flex; gap: 20px; padding: 16px; color: #171218; font-family: var(--data); font-size: 7px; }
  .map-legend span { display: flex; align-items: center; gap: 6px; }
  .map-legend i { width: 7px; height: 7px; background: var(--lime); border-radius: 50%; }
  .map-legend span:last-child i { background: var(--purple); }
  .ui--radar { color: #171218; background: #11131c; box-shadow: 14px 14px 0 #2937a6; }
  .radar-score { display: flex; align-items: baseline; padding: 38px; color: var(--bone); }
  .radar-score span { margin-right: auto; font-family: var(--data); font-size: 8px; letter-spacing: .12em; }
  .radar-score strong { color: var(--lime); font-family: var(--display); font-size: 100px; line-height: .8; letter-spacing: -.06em; }
  .radar-score small { opacity: .45; font-family: var(--data); }
  .radar-list { color: var(--bone); }
  .radar-list span { display: grid; grid-template-columns: 8px 1fr auto; align-items: center; gap: 10px; padding: 14px 20px; border-top: 1px solid rgba(255,255,255,.14); font-size: 11px; }
  .radar-list i { width: 6px; height: 6px; background: var(--lime); border-radius: 50%; }
  .radar-list b { color: var(--purple); font-family: var(--data); font-size: 8px; }
  .radar-wave { height: 80px; opacity: .5; background: repeating-linear-gradient(90deg, transparent 0 14px, var(--cobalt) 15px 16px), linear-gradient(150deg, transparent 45%, var(--lime) 46% 47%, transparent 48%); }
  .ui--pulse { color: #171218; background: #fff8ea; transform: rotate(-1.4deg); }
  .pulse-number { display: flex; align-items: center; justify-content: space-between; padding: 34px; background: var(--lime); }
  .pulse-number span { max-width: 12ch; font-family: var(--data); font-size: 8px; letter-spacing: .1em; }
  .pulse-number strong { font-family: var(--display); font-size: 100px; line-height: .75; letter-spacing: -.07em; }
  .pulse-bars { padding: 28px; }
  .pulse-bars span { position: relative; display: flex; justify-content: space-between; padding: 15px 0; overflow: hidden; border-bottom: 1px solid #bdb5a9; font-size: 11px; }
  .pulse-bars span::after { content: ''; position: absolute; left: 0; bottom: 0; width: var(--bar); height: 4px; background: var(--coral); }
  .pulse-bars b { font-family: var(--data); font-size: 9px; }
  .pulse-alert { padding: 16px; color: var(--bone); background: var(--ink); font-family: var(--data); font-size: 8px; text-align: center; }
  .systems__scroll { display: flex; justify-content: space-between; gap: 20px; margin: 22px clamp(20px, 5vw, 80px) 0; color: rgba(255,248,234,.52); font-family: var(--data); font-size: 8px; letter-spacing: .12em; }

  .faq { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(50px, 10vw, 170px); padding: clamp(110px, 14vw, 210px) clamp(20px, 6vw, 96px); background: var(--bone); }
  .faq header { position: sticky; top: 105px; align-self: start; }
  .faq h2 { max-width: 8.5ch; font-size: clamp(54px, 6.7vw, 100px); }
  .faq .overline { color: #756d63; }
  .faq__list { border-top: 2px solid var(--ink); }
  .faq details { border-bottom: 1px solid #9f978c; }
  .faq summary { display: grid; grid-template-columns: 36px 1fr 24px; gap: 14px; align-items: start; padding: 24px 0; cursor: pointer; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary > span { font-family: var(--data); font-size: 9px; }
  .faq summary strong { font-size: clamp(18px, 1.6vw, 23px); line-height: 1.25; }
  .faq summary i { font-family: var(--data); font-style: normal; font-size: 22px; line-height: 1; transition: transform .25s ease; }
  .faq details[open] summary i { transform: rotate(45deg); }
  .faq details > p { max-width: 60ch; margin: 0 24px 26px 50px; color: #5f584f; line-height: 1.6; }
  .faq details > .faq__link { margin-top: -10px; }
  .faq__link a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--ink); border-bottom: 1px solid var(--ink); font-family: var(--data); font-size: 10px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .faq__link a:hover { color: var(--cobalt); border-color: var(--cobalt); }

  .reserve { display: grid; grid-template-columns: minmax(0, .92fr) minmax(460px, 1.08fr); gap: clamp(50px, 8vw, 130px); padding: clamp(110px, 14vw, 210px) clamp(20px, 6vw, 96px); color: var(--bone); background: var(--purple); }
  .reserve__intro { align-self: start; }
  .reserve .overline { color: #392d42; }
  .reserve h2 { max-width: 9ch; color: var(--ink); }
  .reserve__lead { max-width: 46ch; margin: 36px 0 50px; color: #3c3043; font-size: 18px; line-height: 1.55; }
  .reserve dl { margin: 26px 0 0; color: var(--ink); }
  .reserve dl div { display: flex; justify-content: space-between; gap: 24px; padding: 11px 0; border-bottom: 1px solid rgba(19,17,24,.3); }
  .reserve dt { opacity: .76; }
  .reserve dd { margin: 0; font-family: var(--data); font-size: 10px; text-align: right; }

  @keyframes nav-cta-sheen {
    0% { opacity: 0; transform: skewX(-18deg) translateX(0); }
    25% { opacity: .8; }
    100% { opacity: 0; transform: skewX(-18deg) translateX(850%); }
  }

  .footer { display: grid; grid-template-columns: 1fr auto auto; gap: 50px; align-items: end; padding: 80px clamp(20px, 5vw, 80px) 30px; color: var(--bone); background: var(--ink); border-top: 1px solid rgba(255,248,234,.14); }
  .wordmark--footer { font-size: clamp(34px, 4vw, 58px); }
  .footer__brand p,
  .footer > p { margin: 16px 0 0; color: rgba(255,248,234,.52); font-family: var(--data); font-size: 8px; letter-spacing: .08em; }
  .footer nav { display: flex; flex-wrap: wrap; gap: 18px; }
  .footer nav a { color: rgba(255,248,234,.65); font-family: var(--data); font-size: 9px; letter-spacing: .08em; }
  .footer nav a:hover { color: var(--lime); }

  @media (max-width: 1050px) {
    .hero__sticky { grid-template-columns: 1fr 1fr; }
    .hero__input { display: none; }
    .receipts { grid-template-columns: 1fr 1fr; }
    .receipt:nth-child(2), .receipt:nth-child(4) { margin-top: 30px; }
    .case { grid-template-columns: .95fr 1.05fr; }
    .reserve { grid-template-columns: 1fr; }
    .reserve__intro { max-width: 850px; }
  }

  @media (max-width: 820px) {
    .nav-shell nav a:not(.nav-shell__action):not(.nav-shell__tools) { display: none; }
    .hero {
      height: 330vh;
      height: 330svh;
    }
    .hero__sticky { display: block; padding-top: 118px; }
    .hero__meta { top: 92px; }
    .hero__meta span:nth-child(2) { display: none; }
    .hero__copy { z-index: 6; min-height: 47vh; }
    .hero__machine { position: absolute; z-index: 1; right: -12vw; bottom: 4vh; opacity: .72; }
    .hero__machine::after { content: ''; position: absolute; inset: -10%; background: linear-gradient(var(--ink), transparent 26%); pointer-events: none; }
    .hero__progress { position: absolute; left: 20px; right: 20px; bottom: 25px; }
    .workshop__intro,
    .systems__head,
    .faq { grid-template-columns: 1fr; }
    .workshop__intro .overline,
    .systems__head .overline { grid-column: auto; }
    .workshop__intro { align-items: start; }
    .case { flex-basis: 88vw; grid-template-columns: 1fr; }
    .case__visual { min-height: 440px; }
    .faq header { position: static; }
    .footer { grid-template-columns: 1fr 1fr; }
    .footer > p { grid-column: 1 / -1; }
  }

  @media (max-width: 560px) {
    .nav-shell { top: 10px; width: calc(100% - 20px); min-height: 52px; padding-left: 14px; }
    .wordmark { font-size: 16px; }
    /* El CTA lleva el texto completo: en el teléfono cede el enlace a herramientas (está en el pie). */
    .nav-shell { gap: 12px; }
    .nav-shell__tools { display: none; }
    .nav-shell__action { gap: 9px; padding: 12px; font-size: 9px !important; white-space: nowrap; }
    .hero {
      height: 340vh;
      height: 340svh;
    }
    .hero__sticky { padding: 100px 18px 24px; }
    .hero__meta { top: 74px; left: 18px; right: 18px; }
    .hero__meta span:last-child { display: none; }
    .hero[data-phase='3'] .hero__meta { opacity: 0; }
    .hero__copy { min-height: 53vh; }
    .hero__display { font-size: clamp(68px, 22vw, 102px); }
    .hero__display--medium { font-size: clamp(54px, 16vw, 78px); }
    .hero h1 { font-size: clamp(48px, 14.6vw, 70px); }
    .hero__lead { font-size: 15px; }
    .hero__actions { align-items: stretch; }
    .hero__button { min-width: 0; width: 100%; }
    .hero__secondary { margin-inline: auto; }
    .hero__machine { right: -28vw; bottom: 5vh; opacity: .58; }
    .hero__progress { left: 18px; right: 18px; }
    .workshop h2,
    .systems__head h2,
    .faq h2,
    .reserve h2 { font-size: clamp(50px, 16vw, 78px); }
    .receipts { grid-template-columns: 1fr; }
    .receipt,
    .receipt:nth-child(2),
    .receipt:nth-child(4) { min-height: 340px; margin-top: 0; }
    .receipt strong { font-size: clamp(44px, 13vw, 60px); }
    .workshop__note { gap: 16px; }
    .workshop__note > span { font-size: 78px; }
    .bridge__statement,
    .bridge__answer { font-size: clamp(48px, 15vw, 72px); }
    .bridge__answer { margin-top: 80px; }
    .case-rail { padding-left: 14px; }
    .case { flex-basis: calc(100vw - 28px); min-height: auto; }
    .case__copy { min-height: 580px; }
    .case__visual { min-height: 370px; padding: 22px; }
    .ui { transform: none; }
    .floor-map { height: 300px; }
    .faq summary { grid-template-columns: 28px 1fr 20px; gap: 10px; }
    .faq details > p { margin-left: 38px; }
    .footer { grid-template-columns: 1fr; }
    .footer > p { grid-column: auto; }
  }

  /* Teléfonos bajos (iPhone SE, 360×640): el momento final no cabía y el CTA se cortaba.
     Se reduce el titular y, como ya pasa con la meta, la barra decorativa se retira en fase 3
     en cualquier pantalla baja para no chocar con «ver cómo opero». */
  @media (max-width: 560px) and (max-height: 760px) {
    .hero h1 { font-size: clamp(40px, 6.6svh, 70px); }
  }
  @media (max-height: 760px) {
    .hero[data-phase='3'] .hero__progress { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .nav-shell,
    .nav-shell__action,
    .hero__button,
    .hero__secondary,
    .case__link { transition: none; }
    .nav-shell__action::after { animation: none; }
    .hero { height: auto; }
    .hero__sticky { position: relative; min-height: 100svh; }
    .hero__moment { display: none; transition: none; }
    .hero__moment--final { display: flex; opacity: 1 !important; pointer-events: auto; transform: none !important; }
    .hero__progress b { transform: scaleX(1); }
    .receipt,
    .receipt:hover,
    .ui { transform: none; transition: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero-scroll]');
  const ignition = document.querySelector<HTMLElement>('[data-system-ignition]');
  const systemStatus = document.querySelector<HTMLElement>('[data-system-status]');
  const systemTelemetry = document.querySelector<HTMLElement>('[data-system-telemetry]');
  const phaseLabel = document.querySelector<HTMLElement>('[data-phase-label]');
  const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
  const contactForm = document.querySelector<HTMLFormElement>('#contacto-consultoria');
  const contactLinks = document.querySelectorAll<HTMLAnchorElement>('[data-contact-link]');
  const conversionPanels = document.querySelectorAll<HTMLElement>('[data-conversion-panel]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const phaseContent = [
    ['trabajo suelto', 'ESTADO / SIN CONSTANCIA', 'TRABAJO SUELTO'],
    ['recibido sin constancia', 'ESTADO / SIN FOTOS NI CHECKLIST', '01 RECEPCIÓN · 02 CHECKLIST'],
    ['entrega sin cierre', 'ESTADO / SIN FIRMA NI AVISO', '03 ENTREGA · 04 SEGUIMIENTO'],
    ['sistema en línea', 'ESTADO / 4 PIEZAS EN LÍNEA', 'RECIBIR → HACER → ENTREGAR → SEGUIR'],
  ];

  let currentPhase = -1;
  let frame = 0;
  let heroVisible = true;

  const setPhase = (next: number) => {
    if (!hero || next === currentPhase) return;
    currentPhase = next;
    hero.dataset.phase = String(next);
    if (ignition) ignition.dataset.phase = String(next);
    if (systemStatus) systemStatus.textContent = phaseContent[next][0];
    if (systemTelemetry) systemTelemetry.textContent = phaseContent[next][1];
    if (phaseLabel) phaseLabel.textContent = phaseContent[next][2];
  };

  const updateHero = () => {
    frame = 0;
    if (!hero || !heroVisible) return;

    if (reducedMotion.matches) {
      hero.style.setProperty('--hero-progress', '1');
      setPhase(3);
      return;
    }

    const rect = hero.getBoundingClientRect();
    const distance = Math.max(1, hero.offsetHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, -rect.top / distance));
    const phase = progress < .25 ? 0 : progress < .5 ? 1 : progress < .75 ? 2 : 3;
    hero.style.setProperty('--hero-progress', progress.toFixed(3));
    setPhase(phase);
  };

  const requestHeroUpdate = () => {
    if (!frame) frame = window.requestAnimationFrame(updateHero);
    if (siteHeader) siteHeader.dataset.condensed = String(window.scrollY > 44);
  };

  if (hero) {
    const observer = new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting;
      if (heroVisible) requestHeroUpdate();
    }, { rootMargin: '20% 0px' });
    observer.observe(hero);
    window.addEventListener('scroll', requestHeroUpdate, { passive: true });
    window.addEventListener('resize', requestHeroUpdate, { passive: true });
    reducedMotion.addEventListener?.('change', requestHeroUpdate);
    requestHeroUpdate();

    // Teclado: los CTA del momento final existen desde la fase 0 con opacidad 0. Si reciben
    // foco antes de tiempo, se lleva el scroll a la fase 3 para que el foco nunca sea invisible.
    hero.addEventListener('focusin', (event) => {
      if (currentPhase === 3 || !(event.target instanceof Element)) return;
      if (!event.target.closest('[data-moment="3"]')) return;
      const distance = Math.max(1, hero.offsetHeight - window.innerHeight);
      const top = hero.getBoundingClientRect().top + window.scrollY + distance * .9;
      window.scrollTo({ top, behavior: 'instant' });
      setPhase(3);
    });
  }

  if (conversionPanels.length && !reducedMotion.matches && 'IntersectionObserver' in window) {
    conversionPanels.forEach((panel) => panel.classList.add('is-motion-ready'));
    const panelObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-revealed');
        panelObserver.unobserve(entry.target);
      });
    }, { threshold: .22 });
    conversionPanels.forEach((panel) => {
      panelObserver.observe(panel);
      // Un Tab puede llegar al botón antes de que el panel cruce el umbral del observer.
      panel.addEventListener('focusin', () => panel.classList.add('is-revealed'));
    });
  }

  if (contactForm && contactLinks.length) {
    let arrivalPending = false;

    const revealContact = () => {
      arrivalPending = false;
      contactForm.classList.remove('is-arriving');
      void contactForm.offsetWidth;
      contactForm.classList.add('is-arriving');
      contactForm.focus({ preventScroll: true });
      window.setTimeout(() => contactForm.classList.remove('is-arriving'), 1300);
    };

    const contactObserver = new IntersectionObserver(([entry]) => {
      if (arrivalPending && entry.isIntersecting) revealContact();
    }, { threshold: .02, rootMargin: '-72px 0px -28% 0px' });
    contactObserver.observe(contactForm);

    contactLinks.forEach((link) => {
      link.addEventListener('click', () => {
        arrivalPending = true;
        contactForm.dataset.arrivalFrom = link.dataset.ctaPlacement || 'unknown';
        const rect = contactForm.getBoundingClientRect();
        if (rect.top < window.innerHeight * .72 && rect.bottom > 90) {
          window.setTimeout(revealContact, reducedMotion.matches ? 0 : 80);
        }
      });
    });
  }

  if (ignition && window.matchMedia('(pointer: fine)').matches && !reducedMotion.matches) {
    ignition.addEventListener('pointermove', (event) => {
      const rect = ignition.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;
      ignition.style.setProperty('--pointer-x', `${x.toFixed(1)}%`);
      ignition.style.setProperty('--pointer-y', `${y.toFixed(1)}%`);
    }, { passive: true });
  }
</script>
