---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/ibm-plex-sans/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';

import CheckoutForm from './CheckoutForm.astro';
import SystemIgnition from './SystemIgnition.astro';
import { CONSULTING, formatUsd } from '../../lib/consulting';
import { SOCIALS } from '../../lib/contact';
import { SERVICE_SYSTEM_STAGES } from '../../lib/framework';

const price = formatUsd(CONSULTING.priceUsd);
const year = new Date().getFullYear();

const STAGE_ART = {
  captar: {
    color: '#ff6b45',
    ink: '#171218',
    provocation: 'La gente pregunta. ¿Dónde queda el dato?',
    reality: 'Contenido, pauta, referidos y WhatsApp pueden producir atención sin producir una oportunidad que puedas seguir.',
    decision: 'Definir qué señal importa, quién entra y dónde empieza el recorrido.',
    signal: 'ATENCIÓN → DATO',
  },
  convertir: {
    color: '#c79aff',
    ink: '#171218',
    provocation: 'Hay interés. ¿Quién mueve la siguiente acción?',
    reality: 'Un CRM vacío no arregla nada. La oportunidad avanza cuando existe criterio, responsable y siguiente paso.',
    decision: 'Calificar, cotizar, hacer seguimiento, agendar y cobrar sin depender de memoria.',
    signal: 'DATO → DECISIÓN',
  },
  cumplir: {
    color: '#4b5fe3',
    ink: '#fff8ea',
    provocation: 'Vendiste. ¿El equipo sabe exactamente qué sigue?',
    reality: 'La promesa comercial se vuelve costosa cuando vive en chats, hojas sueltas o en la cabeza del dueño.',
    decision: 'Convertir la entrega en responsables, estados, controles, documentos y alertas.',
    signal: 'DECISIÓN → ENTREGA',
  },
  continuar: {
    color: '#c8ff3d',
    ink: '#171218',
    provocation: 'Entregaste. ¿Alguien vuelve a aparecer?',
    reality: 'La postventa no puede depender de acordarse. Ahí viven la confianza, la recompra y los referidos.',
    decision: 'Diseñar garantías, mantenimiento, NPS, reactivación y la próxima conversación.',
    signal: 'ENTREGA → RELACIÓN',
  },
} as const;

const STAGES = SERVICE_SYSTEM_STAGES.map((stage, index) => ({
  ...stage,
  ...STAGE_ART[stage.id],
  index,
}));

const RECEIPTS = [
  {
    eyebrow: 'COTIZACIÓN / ENZO',
    value: '20 → 2',
    unit: 'minutos',
    body: 'La información dejó de viajar entre Excel, chats y memoria antes de llegar al cliente.',
    color: '#c8ff3d',
  },
  {
    eyebrow: 'REPORTE / GRUPO ENZO',
    value: '10',
    unit: 'horas / semana',
    body: 'Un reporte operativo dejó de comerse una jornada completa cada semana.',
    color: '#c79aff',
  },
  {
    eyebrow: 'P&L / ARKHĒ',
    value: '1.5 h → 10 min',
    unit: 'para ver el negocio',
    body: 'El cierre dejó de ser una reconstrucción manual y se convirtió en una lectura útil.',
    color: '#ff6b45',
  },
  {
    eyebrow: 'DEPENDENCIA / OPERACIÓN',
    value: '$19,9M',
    unit: 'al mes',
    body: 'Una parte crítica de la facturación dependía del conocimiento de una sola persona.',
    color: '#5d72ff',
    light: true,
  },
];

const PROJECTS = [
  {
    id: 'enzo',
    number: '01',
    name: 'Enzo Motorsport',
    label: 'NEGOCIO FÍSICO · AUTOMOTRIZ',
    title: 'De cotizar por memoria a operar con trazabilidad.',
    body: 'Caja, taller, cotización, garantías, asistencia, documentos y reportes: piezas construidas sobre el negocio que sí abre la puerta cada mañana.',
    metric: '20 → 2 min',
    metricLabel: 'por cotización',
  },
  {
    id: 'arkhe',
    number: '02',
    name: 'Arkhē',
    label: 'NEGOCIO FÍSICO · ESPACIOS',
    title: 'Reservar, pagar y entender cómo se usa cada metro.',
    body: 'Checkout, validación Wompi, reservas, mapas operativos y análisis histórico para dejar de administrar el espacio a oscuras.',
    metric: '1.340',
    metricLabel: 'usos analizados',
  },
  {
    id: 'adjudika',
    number: '03',
    name: 'Adjudika',
    label: 'SOFTWARE · CONTRATACIÓN PÚBLICA',
    title: 'Leer procesos complejos sin perder el criterio humano.',
    body: 'Radar SECOP II, análisis documental, pagos por créditos, seguridad multiempresa y monitoreo para decidir dónde sí competir.',
    metric: 'SECOP II',
    metricLabel: 'datos conectados',
  },
  {
    id: 'grupo',
    number: '04',
    name: 'Grupo Enzo',
    label: 'CONTROL · DOS EMPRESAS',
    title: 'Un solo pulso para saber qué requiere atención.',
    body: 'Indicadores, alertas, reportes y responsables separados por negocio. Menos persecución; más capacidad de decidir.',
    metric: '10 h',
    metricLabel: 'recuperadas / semana',
  },
];

const AGENDA = [
  ['00—20', 'Poner el problema sobre la mesa', 'Quitamos síntomas y definimos qué decisión necesita mejorar.'],
  ['20—55', 'Desarmar cómo funciona hoy', 'Abrimos datos, personas, restricciones, herramientas y puntos de falla.'],
  ['55—105', 'Dibujar el sistema correcto', 'Diseñamos el flujo y construimos la primera pieza viable cuando el alcance lo permite.'],
  ['105—120', 'Cerrar sin cabos sueltos', 'Priorizamos, asignamos responsables y dejamos claro qué pasa después.'],
];

const FAQ = [
  ['¿Qué problema cabe en dos horas?', 'Uno que ya esté ocurriendo y puedas ubicar en una de las 4C: entrada de leads, CRM, seguimiento, cotización, agenda, operación, reportes, postventa, garantías, NPS o reactivación. Si llega demasiado grande, la primera decisión será recortarlo.'],
  ['¿Vamos a construir algo durante la sesión?', 'Cuando el alcance lo permite, sí: un prototipo, un flujo o la primera pieza viable. No prometo una aplicación completa en 120 minutos. La prioridad es que no gastes tres meses construyendo lo incorrecto.'],
  ['¿Necesito saber programar?', 'No. Necesitas conocer tu operación y tener capacidad de decisión. Yo hago el puente entre negocio, datos, IA y software.'],
  ['¿Puedo traer a mi equipo?', 'Sí. Puedes invitar hasta dos personas que conozcan el problema o vayan a ejecutar lo decidido. Debe estar quien pueda tomar la decisión.'],
  ['¿Por qué el precio está en dólares si Wompi cobra pesos?', `USD ${CONSULTING.priceUsd} es el precio base. Antes de pagar ves la TRM oficial del día, la tasa operativa aplicada y el total exacto en COP que Wompi firmará en la transacción.`],
  ['¿Cómo calculan la tasa operativa?', 'Cada día se consulta la TRM oficial vigente, se aplica un ajuste de 1,65% y se redondea al siguiente múltiplo de $10 COP. Ese margen absorbe variación y parte del costo de recaudo. Nunca reutilizamos una tasa manual de otro día.'],
  ['¿Qué ocurre después del pago?', 'Wompi confirma la transacción y esta misma página desbloquea Cal.com. Escoges el horario y la reserva queda asociada a la referencia del pago.'],
  ['¿Y si al leer el brief veo que no encaja?', 'No apruebo una llamada que no pueda defender. Si el problema no cabe o no soy la persona indicada, devuelvo el 100% del pago. Puedes reprogramar una vez avisando con 24 horas.'],
];
---

<div class="experience">
  <header class="nav-shell" data-site-header>
    <a class="wordmark" href="#inicio" aria-label="Omar Álvarez, volver al inicio">
      <strong>omar</strong><i aria-hidden="true"></i><span>álvarez</span>
    </a>
    <nav aria-label="Navegación principal">
      <a href="#sistemas">lo que construí</a>
      <a href="#marco">las 4C</a>
      <a href="#sesion">la sesión</a>
      <a class="nav-shell__action" href="#taller" data-nav-action><span data-nav-label>empezar el recorrido</span><span aria-hidden="true">↓</span></a>
    </nav>
  </header>

  <section class="hero" id="inicio" data-hero-scroll data-phase="0" aria-label="Un negocio convertido en sistema">
    <div class="hero__sticky">
      <div class="hero__noise" aria-hidden="true"></div>
      <div class="hero__meta">
        <span>NEGOCIOS REALES / SISTEMAS REALES</span>
        <span>SESIÓN PRIVADA · 120 MIN</span>
        <span>CÚCUTA / REMOTO</span>
      </div>

      <div class="hero__copy">
        <div class="hero__moment" data-moment="0">
          <p class="hero__cue">OJO / AQUÍ EMPIEZA</p>
          <p class="hero__display">Mira esto.</p>
          <p class="hero__aside">Cinco señales. Cinco lugares donde se te puede escapar el negocio.</p>
        </div>

        <div class="hero__moment" data-moment="1">
          <p class="hero__cue">ENTRA UNA OPORTUNIDAD</p>
          <p class="hero__display hero__display--medium">Alguien pregunta.<br />Alguien responde.<br /><span>¿Y luego?</span></p>
        </div>

        <div class="hero__moment" data-moment="2">
          <p class="hero__cue">EL PROBLEMA NO ES LA HERRAMIENTA</p>
          <p class="hero__display hero__display--medium">Vendiste.<br />Entregaste.<br /><span>¿Quién se acuerda de seguir?</span></p>
        </div>

        <div class="hero__moment hero__moment--final" data-moment="3">
          <p class="hero__cue">CAPTAR → CONVERTIR → CUMPLIR → CONTINUAR</p>
          <h1>Tu negocio no necesita otra herramienta de IA.<br /><span>Necesita que las partes se hablen.</span></h1>
          <p class="hero__lead">Trae un cuello de botella. En dos horas aterrizamos el sistema que tu empresa de servicios necesita construir primero.</p>
          <a class="hero__button" href="#taller">ver por qué puedo ayudarte <span aria-hidden="true">↘</span></a>
        </div>
      </div>

      <div class="hero__machine">
        <SystemIgnition />
      </div>

      <div class="hero__input" aria-hidden="true">
        <span>TIKTOK</span><span>WHATSAPP</span><span>CRM</span><span>OPERACIÓN</span><span>POSTVENTA</span>
      </div>

      <div class="hero__progress" aria-hidden="true">
        <span>SCROLL</span>
        <i><b></b></i>
        <span data-phase-label>SEÑALES SUELTAS</span>
      </div>
    </div>
  </section>

  <section class="workshop" id="taller" aria-labelledby="workshop-title">
    <div class="workshop__intro">
      <p class="overline">NO VENGO DE UNA AGENCIA</p>
      <h2 id="workshop-title">Tengo dos negocios físicos.<br /><span>El código vino después.</span></h2>
      <div class="workshop__text">
        <p>Primero me cansé de cotizar en Excel, perseguir reportes, reconstruir cierres y depender de que alguien se acordara.</p>
        <p>Lo que enseño en TikTok no son demos. Son piezas que construí porque mis propias empresas las necesitaban para vender, cumplir y seguir atendiendo.</p>
      </div>
    </div>

    <div class="receipts" aria-label="Resultados operativos reales">
      {RECEIPTS.map((receipt, index) => (
        <article
          class:list={['receipt', receipt.light && 'receipt--light']}
          style={`--receipt-color:${receipt.color}; --receipt-tilt:${index % 2 === 0 ? '-1.5deg' : '1.2deg'}`}
        >
          <p>{receipt.eyebrow}</p>
          <strong>{receipt.value}</strong>
          <span>{receipt.unit}</span>
          <small>{receipt.body}</small>
        </article>
      ))}
    </div>

    <div class="workshop__note">
      <span aria-hidden="true">*</span>
      <p>No tienes que copiar mis herramientas.<br /><strong>Tienes que entender qué decisión deben mejorar las tuyas.</strong></p>
    </div>
  </section>

  <section class="bridge" aria-label="Principio de trabajo">
    <p class="overline">LA VAINA ES ASÍ</p>
    <p class="bridge__statement">No empezamos diciendo <s>“metamos IA”.</s></p>
    <p class="bridge__answer">Empezamos encontrando dónde se pierde una oportunidad, una hora, una decisión o un cliente.</p>
    <div class="bridge__tape" aria-hidden="true">EL PROBLEMA PRIMERO · LA HERRAMIENTA DESPUÉS ·</div>
  </section>

  <section class="framework" id="marco" aria-labelledby="framework-title">
    <header class="framework__intro">
      <div>
        <p class="overline">EL MARCO 4C</p>
        <h2 id="framework-title">Todo servicio pasa por cuatro momentos.</h2>
      </div>
      <p>Si uno se rompe, el negocio lo paga. En la sesión no fingimos arreglarlos todos: encontramos el que hoy te está frenando y diseñamos la pieza que vale la pena construir.</p>
    </header>

    <div class="stage-stack">
      {STAGES.map((stage) => (
        <article
          class="stage"
          data-stage={stage.id}
          style={`--stage-bg:${stage.color}; --stage-ink:${stage.ink}; --stage-index:${stage.index}`}
        >
          <div class="stage__topline">
            <span>{stage.number} / 04</span>
            <span>{stage.signal}</span>
          </div>
          <div class="stage__body">
            <div>
              <p class="stage__name">{stage.name}</p>
              <h3>{stage.provocation}</h3>
            </div>
            <div class="stage__explain">
              <p>{stage.reality}</p>
              <div>
                <span>LO QUE DISEÑAMOS</span>
                <strong>{stage.decision}</strong>
              </div>
              <small>{stage.examples}</small>
            </div>
          </div>
          <div class="stage__diagram" aria-hidden="true">
            {STAGES.map((item, itemIndex) => (
              <span class:list={[itemIndex <= stage.index && 'is-active']}>
                <i></i><b>{item.name}</b>
              </span>
            ))}
          </div>
          <span class="stage__ghost" aria-hidden="true">{stage.number}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="systems" id="sistemas" aria-labelledby="systems-title">
    <header class="systems__head">
      <p class="overline">ESTO YA LO OPERO</p>
      <h2 id="systems-title">Lo construí porque me hacía falta.</h2>
      <p>Desliza y abre el taller. Cada sistema empezó con un problema concreto, no con ganas de sumar otra plataforma.</p>
    </header>

    <div class="case-rail" role="list" aria-label="Proyectos construidos por Omar">
      {PROJECTS.map((project) => (
        <article class={`case case--${project.id}`} role="listitem">
          <div class="case__copy">
            <div class="case__top">
              <span>{project.number} / 04</span>
              <span>{project.label}</span>
            </div>
            <p class="case__name">{project.name}</p>
            <h3>{project.title}</h3>
            <p class="case__body">{project.body}</p>
            <div class="case__metric"><strong>{project.metric}</strong><span>{project.metricLabel}</span></div>
          </div>

          <div class="case__visual" aria-hidden="true">
            {project.id === 'enzo' && (
              <div class="ui ui--quote">
                <div class="ui__bar"><i></i><i></i><i></i><span>COTIZACIÓN / ENZ-0428</span></div>
                <div class="quote-car"><span>BMW</span><strong>M4</strong></div>
                <div class="quote-lines"><span>PPF frontal</span><b>$ ———</b><span>Tiempo estimado</span><b>02 días</b><span>Estado</span><b>LISTO PARA ENVIAR</b></div>
                <div class="quote-action">GENERAR COTIZACIÓN ↗</div>
              </div>
            )}
            {project.id === 'arkhe' && (
              <div class="ui ui--map">
                <div class="ui__bar"><i></i><i></i><i></i><span>MAPA / DISPONIBILIDAD AHORA</span></div>
                <div class="floor-map">
                  <span class="room room--one">SALA 01<small>LIBRE</small></span>
                  <span class="room room--two">SALA 02<small>14:30</small></span>
                  <span class="room room--three">FLEX<small>8 / 12</small></span>
                  <span class="room room--four">TERRAZA<small>ACTIVA</small></span>
                </div>
                <div class="map-legend"><span><i></i>Disponible</span><span><i></i>Reservado</span></div>
              </div>
            )}
            {project.id === 'adjudika' && (
              <div class="ui ui--radar">
                <div class="ui__bar"><i></i><i></i><i></i><span>RADAR / SECOP II</span></div>
                <div class="radar-score"><span>OPORTUNIDAD</span><strong>86</strong><small>/ 100</small></div>
                <div class="radar-list"><span><i></i>Capacidad jurídica<b>LISTO</b></span><span><i></i>Experiencia requerida<b>REVISAR</b></span><span><i></i>Presupuesto<b>EN RANGO</b></span></div>
                <div class="radar-wave"></div>
              </div>
            )}
            {project.id === 'grupo' && (
              <div class="ui ui--pulse">
                <div class="ui__bar"><i></i><i></i><i></i><span>PULSO / LUNES 07:00</span></div>
                <div class="pulse-number"><span>HOY REQUIERE ATENCIÓN</span><strong>03</strong></div>
                <div class="pulse-bars"><span style="--bar:72%">Cotizaciones <b>72%</b></span><span style="--bar:46%">Ocupación <b>46%</b></span><span style="--bar:88%">Entregas <b>88%</b></span></div>
                <div class="pulse-alert">01 alerta asignada · no perseguir por chat</div>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
    <p class="systems__scroll"><span aria-hidden="true">←</span> ARRASTRA / DESLIZA <span aria-hidden="true">→</span></p>
  </section>

  <section class="session" id="sesion" aria-labelledby="session-title">
    <header class="session__intro">
      <p class="overline">UNA ÚNICA OFERTA</p>
      <h2 id="session-title">Dos horas.<br /><span>Un problema concreto.</span></h2>
      <p>No es una llamada para escucharme hablar. Llegas con contexto; abrimos la operación, tomamos decisiones y dejamos una ruta defendible.</p>
    </header>

    <ol class="session__route">
      {AGENDA.map(([time, title, body], index) => (
        <li>
          <div class="route__time"><span>{time}</span><i aria-hidden="true">{String(index + 1).padStart(2, '0')}</i></div>
          <div><h3>{title}</h3><p>{body}</p></div>
        </li>
      ))}
    </ol>

    <div class="session__output">
      <p>SALES CON ESTO</p>
      <ul>
        <li>una decisión central tomada</li>
        <li>el mapa del sistema</li>
        <li>la primera pieza viable, cuando aplique</li>
        <li>documento de cierre en 48 horas</li>
        <li>grabación + 7 días para dudas puntuales</li>
      </ul>
    </div>
  </section>

  <section class="fit" aria-labelledby="fit-title">
    <div class="fit__title">
      <p class="overline">SIN PERDER EL TIEMPO</p>
      <h2 id="fit-title">Esto funciona si el problema duele y tú puedes decidir.</h2>
    </div>
    <div class="fit__panels">
      <article class="fit__yes">
        <span>ENTRA</span>
        <h3>Es para ti si…</h3>
        <ul>
          <li>eres dueño o socio de una empresa de servicios que ya vende;</li>
          <li>el problema cuesta tiempo, dinero, control o clientes;</li>
          <li>puedes abrir el contexto real y tomar decisiones;</li>
          <li>quieres construir criterio, no coleccionar prompts.</li>
        </ul>
      </article>
      <article class="fit__no">
        <span>TODAVÍA NO</span>
        <h3>No la reserves si…</h3>
        <ul>
          <li>buscas una lista de herramientas de moda;</li>
          <li>aún no sabes qué negocio quieres empezar;</li>
          <li>esperas una aplicación completa en 120 minutos;</li>
          <li>nadie puede decidir qué cambia después.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="cost" aria-labelledby="cost-title">
    <p class="overline">EL COSTO REAL</p>
    <h2 id="cost-title">No compras dos horas.</h2>
    <p class="cost__answer">Compras una mala ruta menos.</p>
    <div class="cost__marquee" aria-hidden="true"><span>MENOS DEMOS · MÁS OPERACIÓN · MENOS RUIDO · MÁS CRITERIO ·</span></div>
    <p class="cost__body">Lo caro es pasar el siguiente trimestre construyendo algo que no mejora una decisión, depende otra vez de ti o nunca entra a la rutina del equipo.</p>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <header>
      <p class="overline">SIN LETRA PEQUEÑA</p>
      <h2 id="faq-title">Antes de pagar, esto tiene que estar claro.</h2>
    </header>
    <div class="faq__list">
      {FAQ.map(([question, answer], index) => (
        <details open={index === 0}>
          <summary><span>{String(index + 1).padStart(2, '0')}</span><strong>{question}</strong><i aria-hidden="true">+</i></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="reserve" id="reservar" aria-labelledby="reserve-title">
    <div class="reserve__intro">
      <p class="overline">SI LLEGASTE HASTA AQUÍ</p>
      <h2 id="reserve-title">Ya sabes si duele lo suficiente.</h2>
      <p class="reserve__lead">Trae un cuello de botella real. Yo pongo la estructura, la experiencia de haberlo construido en mis empresas y dos horas sin distracciones.</p>
      <div class="reserve__price">
        <span>SESIÓN PRIVADA · 120 MIN</span>
        <strong>{price}</strong>
        <p data-quote-cop>Calculando el equivalente de hoy en COP…</p>
      </div>
      <dl>
        <div><dt>Formato</dt><dd>Cal Video · remoto</dd></div>
        <div><dt>Participan</dt><dd>1–3 personas</dd></div>
        <div><dt>Cobro</dt><dd>COP · tasa diaria visible</dd></div>
        <div><dt>Si no encaja</dt><dd>devolución del 100%</dd></div>
      </dl>
    </div>
    <CheckoutForm />
  </section>

  <footer class="footer">
    <div class="footer__brand">
      <a class="wordmark wordmark--footer" href="#inicio"><strong>omar</strong><i aria-hidden="true"></i><span>álvarez</span></a>
      <p>Empresas de servicios que dejan de improvisar.</p>
    </div>
    <nav aria-label="Redes sociales">
      <a href={SOCIALS.tiktok} target="_blank" rel="noopener">TikTok ↗</a>
      <a href={SOCIALS.instagram} target="_blank" rel="noopener">Instagram ↗</a>
      <a href={SOCIALS.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    </nav>
    <p>© {year} · Cúcuta, Colombia</p>
  </footer>
</div>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
    background: #131118;
  }

  :global(body) {
    margin: 0;
    background: #131118 !important;
  }

  .experience {
    --ink: #131118;
    --ink-soft: #1d1921;
    --bone: #fff8ea;
    --bone-muted: #e2dccc;
    --coral: #ff6b45;
    --purple: #c79aff;
    --cobalt: #4b5fe3;
    --lime: #c8ff3d;
    --sky: #bdd9d8;
    --display: 'Bricolage Grotesque Variable', 'Arial Narrow', sans-serif;
    --body: 'IBM Plex Sans Variable', Arial, sans-serif;
    --data: 'IBM Plex Mono', monospace;
    min-height: 100vh;
    color: var(--ink);
    background: var(--bone);
    font-family: var(--body);
    font-size: 16px;
    font-variation-settings: 'wdth' 96;
  }

  .experience *,
  .experience *::before,
  .experience *::after { box-sizing: border-box; }

  .experience h1,
  .experience h2,
  .experience h3,
  .experience p { margin-top: 0; }

  .experience a { color: inherit; text-decoration: none; }

  .overline {
    margin-bottom: 26px;
    font-family: var(--data);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .nav-shell {
    position: fixed;
    z-index: 80;
    top: 16px;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    width: min(calc(100% - 32px), 1240px);
    min-height: 58px;
    padding: 8px 9px 8px 18px;
    color: var(--bone);
    background: rgba(19, 17, 24, .82);
    border: 1px solid rgba(255, 248, 234, .16);
    border-radius: 999px;
    box-shadow: 0 16px 56px rgba(0, 0, 0, .17);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
    transition: min-height .35s ease, background-color .35s ease, transform .45s cubic-bezier(.16, 1, .3, 1);
  }

  .nav-shell[data-condensed='true'] {
    min-height: 50px;
    background: rgba(19, 17, 24, .94);
  }

  .nav-shell[data-hidden='true'] { transform: translate(-50%, -145%); }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--display);
    font-size: 18px;
    font-stretch: 84%;
    letter-spacing: -.045em;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark strong { font-weight: 760; }
  .wordmark span { font-weight: 420; }
  .wordmark i { align-self: center; width: 7px; height: 7px; background: var(--coral); border-radius: 50%; }

  .nav-shell nav { display: flex; align-items: center; gap: clamp(14px, 2.2vw, 28px); }
  .nav-shell nav a {
    font-family: var(--data);
    font-size: 9px;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color .25s ease;
  }
  .nav-shell nav a:hover { color: var(--lime); }
  .nav-shell__action {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 13px 16px;
    color: var(--ink) !important;
    background: var(--lime);
    border-radius: 999px;
  }
  .nav-shell__action:hover { background: var(--bone); }

  .hero {
    --hero-progress: 0;
    height: 215svh;
    color: var(--bone);
    background: var(--ink);
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(400px, 1.08fr);
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    overflow: hidden;
    padding: clamp(100px, 11vh, 128px) clamp(20px, 4.5vw, 70px) 28px;
    isolation: isolate;
  }

  .hero__sticky::after {
    content: '';
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 49.9%, rgba(255,255,255,.055) 50%, transparent 50.1%),
      linear-gradient(rgba(255,255,255,.032) 1px, transparent 1px);
    background-size: 100% 100%, 100% 96px;
    opacity: .8;
  }

  .hero__noise {
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
    opacity: .055;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .hero__meta {
    position: absolute;
    z-index: 5;
    top: 94px;
    left: clamp(20px, 4.5vw, 70px);
    right: clamp(20px, 4.5vw, 70px);
    display: flex;
    justify-content: space-between;
    gap: 18px;
    color: rgba(255, 248, 234, .42);
    font-family: var(--data);
    font-size: 8px;
    letter-spacing: .13em;
  }

  .hero__copy { position: relative; z-index: 6; align-self: center; min-height: min(58vh, 550px); }
  .hero__moment {
    position: absolute;
    inset: 50% 0 auto;
    max-width: 690px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-42% + 34px)) rotate(.6deg);
    transition: opacity .5s ease, transform .85s cubic-bezier(.16, 1, .3, 1);
  }
  .hero[data-phase='0'] [data-moment='0'],
  .hero[data-phase='1'] [data-moment='1'],
  .hero[data-phase='2'] [data-moment='2'],
  .hero[data-phase='3'] [data-moment='3'] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(-50%) rotate(0);
  }

  .hero__cue {
    margin-bottom: 24px;
    color: var(--lime);
    font-family: var(--data);
    font-size: 9px;
    letter-spacing: .14em;
  }

  .hero__display,
  .hero h1 {
    margin-bottom: 26px;
    font-family: var(--display);
    font-size: clamp(68px, 9.5vw, 150px);
    font-stretch: 76%;
    font-weight: 760;
    line-height: .79;
    letter-spacing: -.075em;
  }
  .hero__display--medium { font-size: clamp(56px, 7.8vw, 124px); line-height: .84; }
  .hero__display span { color: var(--purple); }
  .hero h1 { max-width: 10.5ch; font-size: clamp(50px, 6.4vw, 100px); line-height: .87; }
  .hero h1 span { color: var(--lime); }
  .hero__aside,
  .hero__lead { max-width: 52ch; margin-bottom: 0; color: rgba(255, 248, 234, .67); font-size: clamp(16px, 1.4vw, 20px); line-height: 1.5; }
  .hero__lead { max-width: 46ch; margin-bottom: 28px; }
  .hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    min-width: 280px;
    padding: 15px 17px;
    color: var(--ink) !important;
    background: var(--coral);
    font-family: var(--data);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    transition: transform .25s ease, background-color .25s ease;
  }
  .hero__button:hover { background: var(--bone); transform: translateY(-3px); }

  .hero__machine { position: relative; z-index: 2; align-self: center; justify-self: end; }
  .hero__machine::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 15%;
    background: rgba(93, 114, 255, calc(.02 + var(--hero-progress) * .09));
    filter: blur(80px);
    border-radius: 50%;
  }

  .hero__input {
    position: absolute;
    z-index: 3;
    right: clamp(18px, 3vw, 44px);
    top: 50%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transform: translateY(-50%);
  }
  .hero__input span {
    padding: 7px 9px;
    color: rgba(255, 248, 234, .32);
    border: 1px solid rgba(255, 248, 234, .08);
    font-family: var(--data);
    font-size: 7px;
    letter-spacing: .1em;
  }

  .hero__progress {
    position: relative;
    z-index: 6;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    color: rgba(255, 248, 234, .42);
    font-family: var(--data);
    font-size: 8px;
    letter-spacing: .12em;
  }
  .hero__progress i { display: block; height: 1px; overflow: hidden; background: rgba(255, 248, 234, .14); }
  .hero__progress b { display: block; width: 100%; height: 100%; background: var(--lime); transform: scaleX(var(--hero-progress)); transform-origin: left; }

  .workshop { padding: clamp(100px, 12vw, 180px) clamp(20px, 5vw, 80px); background: var(--bone); }
  .workshop__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, .65fr);
    gap: clamp(40px, 8vw, 130px);
    align-items: end;
    max-width: 1440px;
    margin-inline: auto;
  }
  .workshop__intro .overline { grid-column: 1 / -1; margin-bottom: 0; color: #7b6f65; }
  .workshop h2,
  .framework__intro h2,
  .systems__head h2,
  .session h2,
  .fit h2,
  .faq h2,
  .reserve h2 {
    margin-bottom: 0;
    font-family: var(--display);
    font-size: clamp(54px, 8vw, 122px);
    font-stretch: 78%;
    font-weight: 760;
    line-height: .83;
    letter-spacing: -.07em;
  }
  .workshop h2 span { color: var(--coral); }
  .workshop__text { max-width: 48ch; font-size: clamp(17px, 1.6vw, 21px); line-height: 1.55; }
  .workshop__text p:last-child { margin-bottom: 0; }

  .receipts {
    display: grid;
    grid-template-columns: 1.05fr .85fr 1.1fr .9fr;
    gap: clamp(10px, 1.6vw, 24px);
    align-items: start;
    max-width: 1440px;
    margin: clamp(80px, 11vw, 155px) auto 0;
  }
  .receipt {
    min-height: clamp(310px, 31vw, 450px);
    padding: clamp(22px, 2.6vw, 40px);
    color: var(--ink);
    background: var(--receipt-color);
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(var(--receipt-tilt));
    transition: transform .45s cubic-bezier(.16, 1, .3, 1);
  }
  .receipt:nth-child(2) { margin-top: 74px; }
  .receipt:nth-child(4) { margin-top: 40px; }
  .receipt:hover { transform: rotate(0) translateY(-10px); }
  .receipt--light { color: var(--bone); }
  .receipt > p { min-height: 42px; margin-bottom: 36px; font-family: var(--data); font-size: 9px; letter-spacing: .1em; }
  .receipt strong { display: block; font-family: var(--display); font-size: clamp(50px, 5.6vw, 86px); font-stretch: 76%; line-height: .82; letter-spacing: -.065em; }
  .receipt > span { display: block; margin-top: 8px; font-family: var(--data); font-size: 10px; letter-spacing: .09em; text-transform: uppercase; }
  .receipt small { display: block; margin-top: clamp(44px, 6vw, 90px); font-size: 14px; line-height: 1.45; }

  .workshop__note {
    display: flex;
    gap: 28px;
    max-width: 860px;
    margin: clamp(100px, 13vw, 180px) auto 0;
    transform: rotate(-1deg);
  }
  .workshop__note > span { color: var(--purple); font-family: var(--display); font-size: 120px; font-weight: 800; line-height: .55; }
  .workshop__note p { margin-bottom: 0; font-size: clamp(28px, 4vw, 56px); line-height: 1.02; letter-spacing: -.035em; }
  .workshop__note strong { font-weight: 650; text-decoration: underline; text-decoration-color: var(--purple); text-decoration-thickness: .12em; text-underline-offset: .12em; }

  .bridge {
    position: relative;
    overflow: hidden;
    padding: clamp(110px, 14vw, 210px) clamp(20px, 6vw, 96px) clamp(150px, 18vw, 260px);
    color: var(--ink);
    background: var(--sky);
  }
  .bridge .overline { color: #425d5c; }
  .bridge__statement,
  .bridge__answer {
    max-width: 16ch;
    margin-bottom: 28px;
    font-family: var(--display);
    font-size: clamp(48px, 7.2vw, 108px);
    font-stretch: 78%;
    font-weight: 730;
    line-height: .88;
    letter-spacing: -.065em;
  }
  .bridge__statement { color: #587270; }
  .bridge__statement s { text-decoration-color: var(--coral); text-decoration-thickness: .09em; }
  .bridge__answer { max-width: 13.5ch; margin: 0 0 0 auto; }
  .bridge__tape {
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 55px;
    padding: 14px 0;
    color: var(--bone);
    background: var(--ink);
    font-family: var(--data);
    font-size: clamp(12px, 1.5vw, 20px);
    letter-spacing: .12em;
    text-align: center;
    white-space: nowrap;
    transform: rotate(2deg);
  }

  .framework { background: var(--ink); }
  .framework__intro {
    display: grid;
    grid-template-columns: 1.45fr .55fr;
    gap: clamp(44px, 10vw, 170px);
    align-items: end;
    min-height: 94svh;
    padding: clamp(120px, 15vw, 220px) clamp(20px, 5vw, 80px) clamp(80px, 10vw, 150px);
    color: var(--bone);
  }
  .framework__intro h2 { max-width: 9.5ch; }
  .framework__intro > p { max-width: 42ch; margin-bottom: 2px; color: rgba(255, 248, 234, .68); font-size: clamp(17px, 1.6vw, 22px); line-height: 1.55; }
  .framework__intro .overline { color: var(--lime); }

  .stage-stack { padding-bottom: 12vh; }
  .stage {
    position: sticky;
    top: calc(68px + var(--stage-index) * 10px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(92svh - var(--stage-index) * 10px);
    margin: 0 clamp(10px, 2vw, 30px);
    padding: clamp(24px, 4vw, 58px);
    overflow: hidden;
    color: var(--stage-ink);
    background: var(--stage-bg);
    border: 2px solid var(--ink);
    border-radius: 30px 30px 0 0;
    box-shadow: 0 -14px 60px rgba(0, 0, 0, .2);
  }
  .stage__topline { display: flex; justify-content: space-between; gap: 24px; font-family: var(--data); font-size: 9px; letter-spacing: .12em; }
  .stage__body { position: relative; z-index: 2; display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(50px, 10vw, 160px); align-items: center; margin-block: 40px; }
  .stage__name { margin-bottom: 22px; font-family: var(--data); font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .stage h3 {
    max-width: 11ch;
    margin-bottom: 0;
    font-family: var(--display);
    font-size: clamp(50px, 7.5vw, 116px);
    font-stretch: 76%;
    font-weight: 760;
    line-height: .84;
    letter-spacing: -.07em;
  }
  .stage__explain > p { margin-bottom: 48px; font-size: clamp(18px, 1.55vw, 22px); line-height: 1.48; }
  .stage__explain > div { padding: 20px 0; border-top: 2px solid currentColor; border-bottom: 2px solid currentColor; }
  .stage__explain > div span { display: block; margin-bottom: 12px; font-family: var(--data); font-size: 9px; letter-spacing: .12em; }
  .stage__explain > div strong { display: block; font-size: clamp(20px, 2vw, 28px); line-height: 1.2; }
  .stage__explain small { display: block; margin-top: 22px; opacity: .72; font-family: var(--data); font-size: 10px; line-height: 1.55; }
  .stage__diagram { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4, 1fr); }
  .stage__diagram::before { content: ''; position: absolute; top: 7px; left: 3px; right: 3px; height: 2px; background: currentColor; opacity: .25; }
  .stage__diagram span { position: relative; display: grid; gap: 12px; opacity: .32; }
  .stage__diagram span.is-active { opacity: 1; }
  .stage__diagram i { width: 16px; height: 16px; background: var(--stage-bg); border: 2px solid currentColor; border-radius: 50%; }
  .stage__diagram .is-active i { background: currentColor; }
  .stage__diagram b { font-family: var(--data); font-size: 8px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .stage__ghost {
    position: absolute;
    right: -2vw;
    bottom: -12vw;
    opacity: .075;
    font-family: var(--display);
    font-size: min(48vw, 700px);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.12em;
  }

  .systems { padding: clamp(120px, 15vw, 220px) 0 80px; overflow: hidden; color: var(--bone); background: var(--ink); }
  .systems__head { display: grid; grid-template-columns: 1fr minmax(250px, .45fr); gap: 52px; align-items: end; padding-inline: clamp(20px, 5vw, 80px); }
  .systems__head .overline { grid-column: 1 / -1; margin-bottom: 0; color: var(--coral); }
  .systems__head h2 { max-width: 9ch; }
  .systems__head > p:last-child { max-width: 42ch; margin-bottom: 0; color: rgba(255, 248, 234, .66); font-size: 18px; line-height: 1.55; }

  .case-rail {
    display: flex;
    gap: clamp(16px, 2.2vw, 34px);
    margin-top: clamp(70px, 9vw, 130px);
    padding: 0 max(20px, calc((100vw - 1440px) / 2)) 28px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-color: var(--lime) rgba(255,255,255,.1);
    scrollbar-width: thin;
  }
  .case-rail::-webkit-scrollbar { height: 6px; }
  .case-rail::-webkit-scrollbar-track { background: rgba(255,255,255,.08); }
  .case-rail::-webkit-scrollbar-thumb { background: var(--lime); }
  .case {
    flex: 0 0 min(82vw, 1080px);
    display: grid;
    grid-template-columns: .82fr 1.18fr;
    min-height: min(75svh, 760px);
    overflow: hidden;
    color: var(--ink);
    scroll-snap-align: center;
  }
  .case--enzo { color: var(--bone); background: #211d14; }
  .case--arkhe { background: var(--coral); }
  .case--adjudika { color: var(--bone); background: var(--cobalt); }
  .case--grupo { background: var(--purple); }
  .case__copy { display: flex; flex-direction: column; padding: clamp(28px, 4vw, 60px); }
  .case__top { display: flex; justify-content: space-between; gap: 20px; margin-bottom: auto; font-family: var(--data); font-size: 8px; letter-spacing: .1em; }
  .case__name { margin: 46px 0 14px; font-family: var(--data); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .case h3 { max-width: 11ch; margin-bottom: 24px; font-family: var(--display); font-size: clamp(42px, 5vw, 74px); font-stretch: 77%; font-weight: 750; line-height: .87; letter-spacing: -.06em; }
  .case__body { max-width: 44ch; margin-bottom: 40px; opacity: .72; line-height: 1.5; }
  .case__metric { display: flex; align-items: end; gap: 14px; margin-top: auto; }
  .case__metric strong { font-family: var(--display); font-size: clamp(50px, 6vw, 88px); font-stretch: 76%; line-height: .8; letter-spacing: -.06em; }
  .case__metric span { max-width: 11ch; font-family: var(--data); font-size: 8px; letter-spacing: .1em; text-transform: uppercase; }
  .case__visual { display: grid; place-items: center; min-width: 0; padding: clamp(28px, 5vw, 74px); background: rgba(255,255,255,.08); }
  .ui { width: min(100%, 620px); overflow: hidden; background: #f8f3e9; border: 2px solid currentColor; box-shadow: 14px 14px 0 rgba(0,0,0,.26); transform: rotate(1.4deg); }
  .ui__bar { display: flex; align-items: center; gap: 6px; height: 38px; padding: 0 12px; color: #171218; background: #e9e2d7; border-bottom: 1px solid #171218; font-family: var(--data); font-size: 7px; letter-spacing: .08em; }
  .ui__bar i { width: 6px; height: 6px; background: #171218; border-radius: 50%; }
  .ui__bar span { margin-left: auto; }
  .quote-car { display: flex; align-items: baseline; gap: 8px; padding: 34px; color: var(--bone); background: #15130f; }
  .quote-car span { font-family: var(--data); font-size: 9px; letter-spacing: .15em; }
  .quote-car strong { font-family: var(--display); font-size: 70px; line-height: 1; letter-spacing: -.06em; }
  .quote-lines { display: grid; grid-template-columns: 1fr auto; gap: 0; color: #171218; }
  .quote-lines > * { padding: 14px 18px; border-bottom: 1px solid #c8c0b4; font-size: 11px; }
  .quote-lines b { font-family: var(--data); font-size: 9px; text-align: right; }
  .quote-action { padding: 18px; color: #10140e; background: #2daa7a; font-family: var(--data); font-size: 9px; font-weight: 600; text-align: right; }
  .floor-map { position: relative; height: 360px; color: #171218; background: #f5e8dd; }
  .room { position: absolute; display: flex; flex-direction: column; justify-content: space-between; padding: 12px; border: 2px solid #171218; font-family: var(--data); font-size: 8px; letter-spacing: .08em; }
  .room small { font-size: 7px; }
  .room--one { inset: 28px 52% 51% 28px; background: var(--lime); }
  .room--two { inset: 28px 28px 51% 50%; background: var(--purple); }
  .room--three { inset: 52% 36% 28px 28px; background: var(--sky); }
  .room--four { inset: 52% 28px 28px 66%; background: var(--coral); }
  .map-legend { display: flex; gap: 20px; padding: 16px; color: #171218; font-family: var(--data); font-size: 7px; }
  .map-legend span { display: flex; align-items: center; gap: 6px; }
  .map-legend i { width: 7px; height: 7px; background: var(--lime); border-radius: 50%; }
  .map-legend span:last-child i { background: var(--purple); }
  .ui--radar { color: #171218; background: #11131c; box-shadow: 14px 14px 0 #2937a6; }
  .radar-score { display: flex; align-items: baseline; padding: 38px; color: var(--bone); }
  .radar-score span { margin-right: auto; font-family: var(--data); font-size: 8px; letter-spacing: .12em; }
  .radar-score strong { color: var(--lime); font-family: var(--display); font-size: 100px; line-height: .8; letter-spacing: -.06em; }
  .radar-score small { opacity: .45; font-family: var(--data); }
  .radar-list { color: var(--bone); }
  .radar-list span { display: grid; grid-template-columns: 8px 1fr auto; align-items: center; gap: 10px; padding: 14px 20px; border-top: 1px solid rgba(255,255,255,.14); font-size: 11px; }
  .radar-list i { width: 6px; height: 6px; background: var(--lime); border-radius: 50%; }
  .radar-list b { color: var(--purple); font-family: var(--data); font-size: 8px; }
  .radar-wave { height: 80px; opacity: .5; background: repeating-linear-gradient(90deg, transparent 0 14px, var(--cobalt) 15px 16px), linear-gradient(150deg, transparent 45%, var(--lime) 46% 47%, transparent 48%); }
  .ui--pulse { color: #171218; background: #fff8ea; transform: rotate(-1.4deg); }
  .pulse-number { display: flex; align-items: center; justify-content: space-between; padding: 34px; background: var(--lime); }
  .pulse-number span { max-width: 12ch; font-family: var(--data); font-size: 8px; letter-spacing: .1em; }
  .pulse-number strong { font-family: var(--display); font-size: 100px; line-height: .75; letter-spacing: -.07em; }
  .pulse-bars { padding: 28px; }
  .pulse-bars span { position: relative; display: flex; justify-content: space-between; padding: 15px 0; overflow: hidden; border-bottom: 1px solid #bdb5a9; font-size: 11px; }
  .pulse-bars span::after { content: ''; position: absolute; left: 0; bottom: 0; width: var(--bar); height: 4px; background: var(--coral); }
  .pulse-bars b { font-family: var(--data); font-size: 9px; }
  .pulse-alert { padding: 16px; color: var(--bone); background: var(--ink); font-family: var(--data); font-size: 8px; text-align: center; }
  .systems__scroll { display: flex; justify-content: space-between; gap: 20px; margin: 22px clamp(20px, 5vw, 80px) 0; color: rgba(255,248,234,.42); font-family: var(--data); font-size: 8px; letter-spacing: .12em; }

  .session { padding: clamp(110px, 14vw, 210px) clamp(20px, 6vw, 96px); background: var(--lime); }
