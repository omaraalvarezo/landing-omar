  .reserve__lead { max-width: 46ch; margin: 36px 0 50px; color: #3c3043; font-size: 18px; line-height: 1.55; }
  .reserve__price { padding: 28px 0; color: var(--ink); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .reserve__price > span { display: block; margin-bottom: 16px; font-family: var(--data); font-size: 9px; letter-spacing: .12em; }
  .reserve__price strong { display: block; font-family: var(--display); font-size: clamp(70px, 9vw, 132px); font-stretch: 76%; line-height: .78; letter-spacing: -.075em; }
  .reserve__price p { margin: 18px 0 0; font-family: var(--data); font-size: 10px; }
  .reserve dl { margin: 26px 0 0; color: var(--ink); }
  .reserve dl div { display: flex; justify-content: space-between; gap: 24px; padding: 11px 0; border-bottom: 1px solid rgba(19,17,24,.3); }
  .reserve dt { opacity: .68; }
  .reserve dd { margin: 0; font-family: var(--data); font-size: 10px; text-align: right; }

  .footer { display: grid; grid-template-columns: 1fr auto auto; gap: 50px; align-items: end; padding: 80px clamp(20px, 5vw, 80px) 30px; color: var(--bone); background: var(--ink); border-top: 1px solid rgba(255,248,234,.14); }
  .wordmark--footer { font-size: clamp(34px, 4vw, 58px); }
  .footer__brand p,
  .footer > p { margin: 16px 0 0; color: rgba(255,248,234,.42); font-family: var(--data); font-size: 8px; letter-spacing: .08em; }
  .footer nav { display: flex; flex-wrap: wrap; gap: 18px; }
  .footer nav a { color: rgba(255,248,234,.65); font-family: var(--data); font-size: 9px; letter-spacing: .08em; }
  .footer nav a:hover { color: var(--lime); }

  @media (max-width: 1050px) {
    .hero__sticky { grid-template-columns: 1fr 1fr; }
    .hero__input { display: none; }
    .receipts { grid-template-columns: 1fr 1fr; }
    .receipt:nth-child(2), .receipt:nth-child(4) { margin-top: 30px; }
    .case { grid-template-columns: .95fr 1.05fr; }
    .reserve { grid-template-columns: 1fr; }
    .reserve__intro { max-width: 850px; }
  }

  @media (max-width: 820px) {
    .nav-shell nav a:not(.nav-shell__action) { display: none; }
    .hero { height: 190svh; }
    .hero__sticky { display: block; padding-top: 118px; }
    .hero__meta { top: 92px; }
    .hero__meta span:nth-child(2) { display: none; }
    .hero__copy { z-index: 6; min-height: 47vh; }
    .hero__moment { inset: 48% 0 auto; }
    .hero__machine { position: absolute; z-index: 1; right: -12vw; bottom: 4vh; opacity: .72; }
    .hero__machine::after { content: ''; position: absolute; inset: -10%; background: linear-gradient(var(--ink), transparent 26%); pointer-events: none; }
    .hero__progress { position: absolute; left: 20px; right: 20px; bottom: 25px; }
    .workshop__intro,
    .framework__intro,
    .systems__head,
    .session__intro,
    .faq,
    .fit__title { grid-template-columns: 1fr; }
    .workshop__intro .overline,
    .systems__head .overline,
    .session__intro .overline { grid-column: auto; }
    .workshop__intro { align-items: start; }
    .stage__body { grid-template-columns: 1fr; gap: 52px; }
    .stage { min-height: 86svh; }
    .case { flex-basis: 88vw; grid-template-columns: 1fr; }
    .case__visual { min-height: 440px; }
    .session__route li,
    .session__output { grid-template-columns: minmax(120px, .35fr) 1.65fr; }
    .session__route li > div:last-child { grid-template-columns: 1fr; gap: 12px; }
    .faq header { position: static; }
    .footer { grid-template-columns: 1fr 1fr; }
    .footer > p { grid-column: 1 / -1; }
  }

  @media (max-width: 560px) {
    .nav-shell { top: 10px; width: calc(100% - 20px); min-height: 52px; padding-left: 14px; }
    .wordmark { font-size: 16px; }
    .nav-shell__action { gap: 9px; padding: 12px; font-size: 8px !important; }
    .hero { height: 175svh; }
    .hero__sticky { padding: 100px 18px 24px; }
    .hero__meta { top: 74px; left: 18px; right: 18px; }
    .hero__meta span:last-child { display: none; }
    .hero[data-phase='3'] .hero__meta { opacity: 0; }
    .hero__copy { min-height: 53vh; }
    .hero__display { font-size: clamp(68px, 22vw, 102px); }
    .hero__display--medium { font-size: clamp(54px, 16vw, 78px); }
    .hero h1 { font-size: clamp(48px, 14.6vw, 70px); }
    .hero__lead { font-size: 15px; }
    .hero__button { min-width: 0; width: 100%; }
    .hero__machine { right: -28vw; bottom: 5vh; opacity: .58; }
    .hero__progress { left: 18px; right: 18px; }
    .workshop h2,
    .framework__intro h2,
    .systems__head h2,
    .session h2,
    .fit h2,
    .faq h2,
    .reserve h2 { font-size: clamp(50px, 16vw, 78px); }
    .receipts { grid-template-columns: 1fr; }
    .receipt,
    .receipt:nth-child(2),
    .receipt:nth-child(4) { min-height: 340px; margin-top: 0; }
    .receipt strong { font-size: 66px; }
    .workshop__note { gap: 16px; }
    .workshop__note > span { font-size: 78px; }
    .bridge__statement,
    .bridge__answer { font-size: clamp(48px, 15vw, 72px); }
    .bridge__answer { margin-top: 80px; }
    .stage { top: calc(62px + var(--stage-index) * 7px); min-height: 82svh; margin-inline: 5px; padding: 24px 20px; border-radius: 20px 20px 0 0; }
    .stage h3 { font-size: clamp(48px, 15vw, 70px); }
    .stage__explain > p { margin-bottom: 28px; font-size: 16px; }
    .stage__diagram b { display: none; }
    .case-rail { padding-left: 14px; }
    .case { flex-basis: calc(100vw - 28px); min-height: auto; }
    .case__copy { min-height: 580px; }
    .case__visual { min-height: 370px; padding: 22px; }
    .ui { transform: none; }
    .floor-map { height: 300px; }
    .session__route li,
    .session__output { grid-template-columns: 1fr; }
