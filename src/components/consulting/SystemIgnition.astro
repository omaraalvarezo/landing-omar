<div class="ignition" data-system-ignition data-phase="0" aria-hidden="true">
  <svg class="ignition__map" viewBox="0 0 800 800" role="presentation">
    <defs>
      <filter id="oa-glow-coral" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="12" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <filter id="oa-glow-lime" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="10" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <pattern id="oa-grid" width="48" height="48" patternUnits="userSpaceOnUse">
        <path d="M 48 0 L 0 0 0 48" fill="none" stroke="rgba(255,255,255,.055)" stroke-width="1" />
      </pattern>
    </defs>

    <rect width="800" height="800" fill="url(#oa-grid)" />
    <circle class="ignition__orbit ignition__orbit--outer" cx="400" cy="400" r="292" />
    <circle class="ignition__orbit ignition__orbit--inner" cx="400" cy="400" r="176" />
    <circle class="ignition__scanner" cx="400" cy="400" r="234" pathLength="1" />

    <g class="ignition__traces">
      <path class="ignition__trace ignition__trace--one" pathLength="1" d="M400 400 C314 348 261 261 170 190" />
      <path class="ignition__trace ignition__trace--two" pathLength="1" d="M400 400 C494 338 556 268 641 190" />
      <path class="ignition__trace ignition__trace--three" pathLength="1" d="M400 400 C307 466 250 540 167 625" />
      <path class="ignition__trace ignition__trace--four" pathLength="1" d="M400 400 C488 462 553 548 641 625" />
      <path class="ignition__loop" pathLength="1" d="M170 190 C301 80 522 78 641 190 C754 302 759 506 641 625 C519 744 290 742 167 625 C51 514 54 304 170 190" />
    </g>

    <g class="ignition__node ignition__node--one" transform="translate(170 190)">
      <circle class="ignition__pulse" r="38" />
      <circle class="ignition__disc" r="22" />
      <text text-anchor="middle" dominant-baseline="central">C1</text>
    </g>
    <g class="ignition__node ignition__node--two" transform="translate(641 190)">
      <circle class="ignition__pulse" r="38" />
      <circle class="ignition__disc" r="22" />
      <text text-anchor="middle" dominant-baseline="central">C2</text>
    </g>
    <g class="ignition__node ignition__node--three" transform="translate(167 625)">
      <circle class="ignition__pulse" r="38" />
      <circle class="ignition__disc" r="22" />
      <text text-anchor="middle" dominant-baseline="central">C3</text>
    </g>
    <g class="ignition__node ignition__node--four" transform="translate(641 625)">
      <circle class="ignition__pulse" r="38" />
      <circle class="ignition__disc" r="22" />
      <text text-anchor="middle" dominant-baseline="central">C4</text>
    </g>
  </svg>

  <div class="ignition__core">
    <span>NEGOCIO</span>
    <strong data-system-status>señal suelta</strong>
  </div>

  <p class="ignition__label ignition__label--one"><span></span>Captar</p>
  <p class="ignition__label ignition__label--two"><span></span>Convertir</p>
  <p class="ignition__label ignition__label--three"><span></span>Cumplir</p>
  <p class="ignition__label ignition__label--four"><span></span>Continuar</p>

  <div class="ignition__telemetry">
    <span>INPUT / TIKTOK · WHATSAPP · REFERIDOS</span>
    <span data-system-telemetry>ESTADO / SIN CONECTAR</span>
  </div>
</div>

<style>
  .ignition {
    --pointer-x: 50%;
    --pointer-y: 45%;
    position: relative;
    width: min(55vw, 760px);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(255, 248, 234, .15);
    border-radius: 42% 58% 49% 51% / 52% 44% 56% 48%;
    background:
      radial-gradient(circle at var(--pointer-x) var(--pointer-y), rgba(199, 154, 255, .13), transparent 32%),
      #131118;
    box-shadow: inset 0 0 80px rgba(0, 0, 0, .35), 0 40px 120px rgba(0, 0, 0, .35);
    transform: rotate(-2deg);
    transition: border-radius 1.2s cubic-bezier(.16, 1, .3, 1), transform 1.2s cubic-bezier(.16, 1, .3, 1);
  }

  .ignition[data-phase='2'],
  .ignition[data-phase='3'] {
    border-radius: 25% 75% 32% 68% / 65% 31% 69% 35%;
    transform: rotate(1deg);
  }

  .ignition__map { width: 100%; height: 100%; overflow: visible; }
  .ignition__orbit,
  .ignition__scanner,
  .ignition__trace,
  .ignition__loop { fill: none; vector-effect: non-scaling-stroke; }

  .ignition__orbit { stroke: rgba(255, 248, 234, .12); stroke-width: 1; stroke-dasharray: 3 10; }
  .ignition__orbit--inner { stroke: rgba(255, 248, 234, .08); stroke-dasharray: 2 14; }
  .ignition__orbit--outer { transform-origin: 400px 400px; animation: orbit-turn 34s linear infinite; }
  .ignition__scanner { stroke: rgba(200, 255, 61, .15); stroke-width: 1; stroke-dasharray: .06 .94; animation: scanner-turn 7s linear infinite; transform-origin: 400px 400px; }

  .ignition__trace,
  .ignition__loop {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-linecap: round;
    transition: stroke-dashoffset 1.1s cubic-bezier(.16, 1, .3, 1), opacity .5s ease;
  }
  .ignition__trace { stroke-width: 4; opacity: .86; }
  .ignition__trace--one { stroke: #ff6b45; }
  .ignition__trace--two { stroke: #c79aff; }
  .ignition__trace--three { stroke: #5d72ff; }
  .ignition__trace--four { stroke: #c8ff3d; }
  .ignition__loop { stroke: rgba(255, 248, 234, .7); stroke-width: 2; opacity: 0; }

  .ignition[data-phase='1'] .ignition__trace--one,
  .ignition[data-phase='1'] .ignition__trace--two,
  .ignition[data-phase='2'] .ignition__trace,
  .ignition[data-phase='3'] .ignition__trace { stroke-dashoffset: 0; }
  .ignition[data-phase='3'] .ignition__loop { stroke-dashoffset: 0; opacity: 1; transition-delay: .25s; }

  .ignition__node { opacity: .22; transition: opacity .45s ease; }
  .ignition__node text {
    fill: #131118;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
    font-weight: 600;
  }
  .ignition__pulse { fill: transparent; stroke: currentColor; stroke-width: 1; transform-origin: center; opacity: 0; }
  .ignition__disc { fill: currentColor; }
  .ignition__node--one { color: #ff6b45; }
  .ignition__node--two { color: #c79aff; }
  .ignition__node--three { color: #5d72ff; }
  .ignition__node--three text { fill: #fff8ea; }
  .ignition__node--four { color: #c8ff3d; }

  .ignition[data-phase='1'] .ignition__node--one,
  .ignition[data-phase='1'] .ignition__node--two,
  .ignition[data-phase='2'] .ignition__node,
  .ignition[data-phase='3'] .ignition__node { opacity: 1; }
  .ignition[data-phase='1'] .ignition__node--one .ignition__pulse,
  .ignition[data-phase='1'] .ignition__node--two .ignition__pulse,
  .ignition[data-phase='2'] .ignition__pulse,
  .ignition[data-phase='3'] .ignition__pulse { animation: node-pulse 2.2s ease-out infinite; }

  .ignition__core {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    color: #fff8ea;
    background: rgba(19, 17, 24, .88);
    border: 1px solid rgba(255, 248, 234, .22);
    transform: translate(-50%, -50%);
    transition: width .8s cubic-bezier(.16, 1, .3, 1), background-color .5s ease, box-shadow .5s ease;
  }
  .ignition__core span { font-family: 'IBM Plex Mono', monospace; font-size: clamp(7px, .72vw, 11px); letter-spacing: .14em; }
  .ignition__core strong { font-family: 'IBM Plex Sans Variable', sans-serif; font-size: clamp(8px, .9vw, 13px); font-weight: 450; color: rgba(255, 248, 234, .55); }
  .ignition[data-phase='2'] .ignition__core,
  .ignition[data-phase='3'] .ignition__core {
    width: 26%;
    color: #131118;
    background: #fff8ea;
    border-color: #fff8ea;
    box-shadow: 0 0 52px rgba(255, 248, 234, .22);
  }
  .ignition[data-phase='2'] .ignition__core strong,
  .ignition[data-phase='3'] .ignition__core strong { color: #4c4651; }

  .ignition__label {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: rgba(255, 248, 234, .38);
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(8px, .7vw, 11px);
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color .4s ease, transform .6s cubic-bezier(.16, 1, .3, 1);
  }
  .ignition__label span { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .ignition__label--one { left: 5%; top: 8%; }
  .ignition__label--two { right: 5%; top: 8%; }
  .ignition__label--three { left: 5%; bottom: 8%; }
  .ignition__label--four { right: 5%; bottom: 8%; }
  .ignition[data-phase='1'] .ignition__label--one { color: #ff6b45; transform: translateX(8px); }
  .ignition[data-phase='1'] .ignition__label--two { color: #c79aff; transform: translateX(-8px); }
  .ignition[data-phase='2'] .ignition__label--one,
  .ignition[data-phase='3'] .ignition__label--one { color: #ff6b45; }
  .ignition[data-phase='2'] .ignition__label--two,
  .ignition[data-phase='3'] .ignition__label--two { color: #c79aff; }
  .ignition[data-phase='2'] .ignition__label--three,
  .ignition[data-phase='3'] .ignition__label--three { color: #5d72ff; }
  .ignition[data-phase='2'] .ignition__label--four,
  .ignition[data-phase='3'] .ignition__label--four { color: #c8ff3d; }

  .ignition__telemetry {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 2.5%;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: rgba(255, 248, 234, .35);
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(6px, .53vw, 8px);
    letter-spacing: .08em;
  }

  @keyframes orbit-turn { to { transform: rotate(360deg); } }
  @keyframes scanner-turn { to { transform: rotate(-360deg); } }
  @keyframes node-pulse { 0% { opacity: .7; transform: scale(.55); } 80%, 100% { opacity: 0; transform: scale(1.4); } }

  @media (max-width: 900px) {
    .ignition { width: min(92vw, 620px); }
    .ignition__label,
    .ignition__telemetry { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ignition[data-phase] {
      transform: none;
      border-radius: 32%;
      transition: none;
    }
    .ignition__orbit--outer,
    .ignition__scanner,
    .ignition__pulse { animation: none !important; }
    .ignition__trace,
    .ignition__loop,
    .ignition__core,
    .ignition__node,
    .ignition__label { transition: none; }
  }
</style>
