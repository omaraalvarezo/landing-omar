---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import ResourceDetail from '../../../components/ResourceDetail.astro';
import { getVisibleAreas, getResourcesByArea, type Area, type Resource } from '../../../lib/resources';
import { DEFAULT_OG_IMAGE, SITE, WEBSITE_ID, breadcrumbList, personRef } from '../../../lib/schema';

export function getStaticPaths() {
  return getVisibleAreas().flatMap((area) =>
    getResourcesByArea(area.slug).map((resource) => ({
      params: { area: area.slug, slug: resource.slug },
      props: { area, resource },
    }))
  );
}

interface Props {
  area: Area;
  resource: Resource;
}
const { area, resource } = Astro.props;

const title = `${resource.title} — Recursos · Omar Álvarez`;
const description = resource.description;

const pageUrl = `${SITE}/recursos/${area.slug}/${resource.slug}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbList([
      { name: 'Inicio', url: `${SITE}/` },
      { name: 'Recursos', url: `${SITE}/recursos` },
      { name: area.label, url: `${SITE}/recursos/${area.slug}` },
      { name: resource.title, url: pageUrl },
    ]),
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: resource.title,
      description,
      inLanguage: 'es',
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      dateModified: resource.updatedAt,
      articleSection: area.label,
      image: `${SITE}${DEFAULT_OG_IMAGE}`,
      author: personRef(),
      publisher: personRef(),
      isPartOf: { '@type': 'WebSite', '@id': WEBSITE_ID, url: `${SITE}/` },
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <ResourceDetail area={area} resource={resource} />
  <Footer />
</Layout>

<script>
  import { initMagnetic } from '../../../scripts/magnetic';
  import { splitAndReveal } from '../../../scripts/splitText';

  splitAndReveal({ selector: '[data-split-reveal]', staggerMs: 30, durationMs: 700 });
  initMagnetic();

  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-split-reveal])');
  if (reveals.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      reveals.forEach((el) => el.classList.add('is-revealed'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-revealed');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      reveals.forEach((el) => io.observe(el));
    }
  }
</script>
