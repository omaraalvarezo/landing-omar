---
import SistemaShell from '../../components/sistemas/SistemaShell.astro';
import oficios from '../../data/oficios.json';
import { bogotaToday } from '../../lib/directory';
import { breadcrumb, publishedSistemas, sistemaPath, SITE } from '../../lib/editorial';
import { formatCop } from '../../lib/money';
import { getProduct, isProductOnSale } from '../../lib/products';

const today = bogotaToday();
const sistemas = (await publishedSistemas()).map((entry) => {
  const product = getProduct(entry.data.product);
  if (!product) throw new Error(`SISTEMA_SIN_PRODUCTO:${entry.id}`);
  return {
    id: entry.id,
    href: sistemaPath(entry.id),
    title: entry.data.title,
    description: entry.data.description,
    oficio: oficios.find((oficio) => oficio.id === entry.data.oficio)?.label ?? entry.data.oficio,
    price: formatCop(product.amountCop),
    usd: product.usdReference,
    status: isProductOnSale(product, today) ? 'Preventa abierta' : 'Abre pronto',
  };
});

const title = 'Sistemas de Omar Álvarez';
const description =
  'Los sistemas con los que opero Enzo Motorsport, empacados para que los montes en tu negocio con herramientas que ya existen. Pago único, sin mensualidad conmigo.';
const url = `${SITE}${sistemaPath()}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': url,
      name: title,
      description,
      inLanguage: 'es',
      url,
      isPartOf: { '@type': 'WebSite', name: 'Omar Álvarez', url: SITE },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: sistemas.length,
        itemListElement: sistemas.map((sistema, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: sistema.title,
          url: `${SITE}${sistema.href}`,
        })),
      },
    },
    breadcrumb([
      { name: 'Inicio', url: SITE },
      { name: 'Sistemas', url },
    ]),
  ],
};
---

<SistemaShell title={`${title} — por oficio`} description={description} jsonLd={jsonLd}>
  <section class="head" aria-labelledby="sistemas-titulo">
    <p class="overline">Sistemas · por oficio</p>
    <h1 id="sistemas-titulo">Lo que ya opero, para que lo montes tú.</h1>
    <p>Cada sistema sale de un negocio mío que funciona hoy. Trae el método, las plantillas y las herramientas con su costo al mes. Uno por oficio.</p>
  </section>

  <section class="list" aria-label="Sistemas publicados">
    <ol>
      {sistemas.map((sistema, index) => (
        <li>
          <a href={sistema.href} data-track="sistema_abierto" data-track-id={sistema.id}>
            <span class="list__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="list__body">
              <span class="list__oficio">{sistema.oficio} · {sistema.status}</span>
              <span class="list__title">{sistema.title}</span>
              <span class="list__desc">{sistema.description}</span>
            </span>
            <span class="list__price">
              <strong>{sistema.price}</strong>
              <small>aprox. USD {sistema.usd} · pago único</small>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="other" aria-labelledby="otro-titulo">
    <h2 id="otro-titulo">¿Lo quieres para tu oficio?</h2>
    <p>Dime cuál es. Así sé qué oficio pide más gente antes de armar el siguiente.</p>
    <a href="/?quiero=otro-oficio#contacto" data-track="escalon_click" data-track-id="lista">Anótate</a>
  </section>
</SistemaShell>

<style>
  .overline {
    margin: 0 0 18px;
    color: var(--lime);
    font-family: var(--data);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  h1, h2 {
    margin: 0;
    font-family: var(--display);
    font-stretch: 78%;
    font-weight: 760;
    letter-spacing: -.06em;
    line-height: .88;
    overflow-wrap: break-word;
  }
  p { margin: 0; }

  .head { padding: clamp(48px, 9vw, 120px) var(--gutter) clamp(40px, 6vw, 72px); }
  .head h1 { max-width: 1000px; font-size: clamp(48px, 9vw, 128px); }
  .head > p:last-child { max-width: 600px; margin-top: 26px; color: rgba(255, 248, 234, .84); font-size: clamp(17px, 1.8vw, 20px); }

  .list { padding: 0 var(--gutter) clamp(56px, 8vw, 104px); }
  .list ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(255, 248, 234, .2); }
  .list li { border-bottom: 1px solid rgba(255, 248, 234, .2); }
  .list a {
    display: grid;
    gap: 16px;
    padding: 28px 0;
    color: inherit;
    text-decoration: none;
  }
  .list a:hover .list__title { color: var(--lime); }
  .list__index {
    justify-self: start;
    padding: 8px 12px;
    color: var(--ink);
    background: var(--coral);
    font-family: var(--display);
    font-size: 32px;
    font-stretch: 76%;
    font-weight: 780;
    line-height: 1;
  }
  .list__body { display: grid; gap: 10px; }
  .list__oficio { color: rgba(255, 248, 234, .62); font-family: var(--data); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
  .list__title { font-family: var(--display); font-size: clamp(32px, 5vw, 60px); font-stretch: 80%; font-weight: 760; letter-spacing: -.05em; line-height: .95; transition: color .2s ease; }
  .list__desc { max-width: 680px; color: rgba(255, 248, 234, .8); }
  .list__price { display: grid; gap: 4px; align-content: start; }
  .list__price strong { font-family: var(--display); font-size: clamp(32px, 4vw, 48px); font-stretch: 76%; font-weight: 760; letter-spacing: -.05em; }
  .list__price small { color: rgba(255, 248, 234, .62); font-family: var(--data); font-size: 11px; }
  @media (min-width: 900px) {
    .list a { grid-template-columns: 90px minmax(0, 1fr) auto; column-gap: 40px; align-items: start; }
    .list__price { justify-items: end; text-align: right; }
  }

  .other {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding: clamp(56px, 8vw, 104px) var(--gutter);
    color: var(--ink);
    background: var(--lime);
  }
  .other h2 { font-size: clamp(40px, 7vw, 88px); }
  .other p { max-width: 560px; font-size: 17px; }
  .other a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 14px 24px;
    color: var(--lime);
    background: var(--ink);
    font-family: var(--data);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .06em;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 999px;
  }
  .other a:hover { color: var(--ink); background: var(--bone); }
</style>
