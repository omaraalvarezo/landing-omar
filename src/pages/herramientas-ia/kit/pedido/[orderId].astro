---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import DirectoryChrome from '../../../../components/directory/DirectoryChrome.astro';
import { formatCop } from '../../../../lib/money';
import { kitDownloadPath } from '../../../../lib/kit';
import { settleKitPayment } from '../../../../lib/kit-payment';
import { parseKitReference } from '../../../../lib/kit';
import {
  getKitOrderById,
  hasKitOrderAccess,
  isKitDownloadToken,
  isKitOrderId,
  kitAccessCookieName,
  type KitOrder,
} from '../../../../lib/kit-orders';
import { fetchTransaction } from '../../../../lib/wompi';

const orderId = Astro.params.orderId || '';
let order: KitOrder | null = null;
let allowed = false;
let note = '';

if (isKitOrderId(orderId)) {
  try {
    order = await getKitOrderById(orderId);
    const token = Astro.cookies.get(kitAccessCookieName(orderId))?.value || '';
    allowed = Boolean(order) && (await hasKitOrderAccess(order as KitOrder, token));
  } catch (error) {
    console.error('[kit] no se pudo leer la orden', error);
    note = 'El registro de pagos no está disponible en este momento.';
  }
}

if (allowed && order) {
  const transactionId = Astro.url.searchParams.get('id') || '';
  if (/^[A-Za-z0-9-]{4,80}$/.test(transactionId)) {
    try {
      const transaction = await fetchTransaction(transactionId);
      const parsed = transaction ? parseKitReference(transaction.reference) : null;
      if (!transaction || transaction.reference !== order.reference || !parsed) {
        note = 'Esa transacción no corresponde a este pago.';
      } else {
        const settled = await settleKitPayment(transaction, parsed.amountInCents);
        if (settled.ok) order = settled.order;
      }
    } catch (error) {
      console.warn('[kit] se muestra el estado guardado mientras Wompi no responde', error);
      note = 'Wompi no respondió ahora. Este es el estado que ya teníamos guardado.';
    }
  }
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!allowed) Astro.response.status = note ? 503 : 404;

const downloadReady =
  allowed &&
  order?.status === 'APPROVED' &&
  isKitDownloadToken(order.downloadToken) &&
  Boolean(order.downloadExpiresAt) &&
  Date.parse(order.downloadExpiresAt || '') > Date.now();
const title = allowed ? 'Pago del kit' : 'Pago no disponible';
const expiry = downloadReady && order?.downloadExpiresAt
  ? new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Bogota' }).format(new Date(order.downloadExpiresAt))
  : '';
---

<Layout title={title} description="Estado privado del pago del kit de IA." showNav={false} minimal noIndex privatePage themeColor="#FFF8EA">
  <DirectoryChrome consultCta={false}>
    <p class="dir-kicker">Kit · pago</p>
    {allowed && order ? (
      <>
        <h1>
          {order.status === 'APPROVED'
            ? 'Pago registrado.'
            : order.status === 'DECLINED' || order.status === 'VOIDED' || order.status === 'ERROR'
              ? 'Ese pago no quedó aprobado.'
              : 'Todavía no hay confirmación.'}
        </h1>
        <p class="dir-lead">
          {order.status === 'APPROVED'
            ? 'El enlace de abajo descarga el zip. No está publicado en el sitio.'
            : 'Un redirect de Wompi no alcanza para entregar el kit. Esta página se actualiza cuando el pago queda aprobado.'}
        </p>
        {note && <p class="form-error">{note}</p>}
        <div class="receipt">
          <dl>
            <div><dt>Estado</dt><dd>{order.status}</dd></div>
            <div><dt>Monto</dt><dd>{formatCop(order.amountInCents / 100)}</dd></div>
            <div><dt>Referencia</dt><dd>{order.reference}</dd></div>
          </dl>
        </div>
        {downloadReady && order.downloadToken && (
          <p class="download-ready">
            <a href={kitDownloadPath(order.id, order.downloadToken)} rel="noreferrer">Descargar el kit</a>
            Vence el {expiry}, hora de Bogotá.
          </p>
        )}
        {order.status !== 'APPROVED' && order.status !== 'DECLINED' && order.status !== 'VOIDED' && order.status !== 'ERROR' && (
          <script is:inline>
            const key = 'oa-kit-refresh';
            const tries = Number(sessionStorage.getItem(key) || '0');
            if (tries < 8) {
              sessionStorage.setItem(key, String(tries + 1));
              setTimeout(() => location.reload(), 8000);
            }
          </script>
        )}
      </>
    ) : (
      <>
        <h1>No hay un pago para mostrar.</h1>
        <p class="dir-lead">{note || 'Esta página solo abre con la cookie de quien inició el pago.'}</p>
      </>
    )}
  </DirectoryChrome>
</Layout>
