---
import { getCollection, render } from 'astro:content';
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import ToolChips from '../../../components/directory/ToolChips.astro';
import {
  alternativesPath,
  articleNode,
  breadcrumb,
  publicEntries,
  SITE,
  softwareNodes,
  toolsOf,
  type AlternativeEntry,
} from '../../../lib/editorial';
import { formatDirectoryDate } from '../../../lib/directory';

export async function getStaticPaths() {
  const entries = publicEntries(await getCollection('alternativas'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: AlternativeEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const instead = toolsOf([entry.data.insteadOf])[0];
const alternatives = toolsOf(entry.data.alternatives);
const url = `${SITE}${alternativesPath(entry.id)}`;
const documentTitle = `${entry.data.title} — alternativas`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleNode({
      url,
      title: entry.data.title,
      description: entry.data.description,
      published: entry.data.published,
      updated: entry.data.updated,
      section: 'Alternativas',
    }),
    ...softwareNodes([instead, ...alternatives]),
    breadcrumb([
      { name: 'Inicio', url: SITE },
      { name: 'Herramientas de IA', url: `${SITE}/herramientas-ia` },
      { name: 'Alternativas', url: `${SITE}${alternativesPath()}` },
      { name: entry.data.title, url },
    ]),
  ],
};
---
<EditorialFrame
  documentTitle={documentTitle}
  description={entry.data.description}
  kicker="Alternativas"
  heading={entry.data.title}
  published={entry.data.published}
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { href: alternativesPath(), label: 'Alternativas' }, { label: entry.data.title }]}
  jsonLd={jsonLd}
>
  <p class="dir-meta">Lista armada el {formatDirectoryDate(entry.data.checked)}</p>
  <div class="prose"><Content /></div>
  <h2 class="block-title">En vez de {instead.nombre}</h2>
  <ToolChips tools={[instead]} />
  <h2 class="block-title">Otras fichas</h2>
  <ToolChips tools={alternatives} />
</EditorialFrame>
