---
import Layout from '../../layouts/Layout.astro';
import DirectoryChrome from '../../components/directory/DirectoryChrome.astro';
import ToolList from '../../components/directory/ToolList.astro';
import {
  categoryLabel,
  categoryPath,
  formatDirectoryDate,
  getTools,
  getToolsByCategory,
  isLiveFeatured,
  isLiveSponsor,
  type Tool,
} from '../../lib/directory';
import { piecesForTool } from '../../lib/editorial';

export function getStaticPaths() {
  return getTools().map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const label = categoryLabel(tool.categoria);
const related = getToolsByCategory(tool.categoria).filter((item) => item.slug !== tool.slug).slice(0, 4);
const mentions = await piecesForTool(tool.slug);
const sponsor = isLiveSponsor(tool);
const featured = isLiveFeatured(tool);
const site = 'https://omaralvarezo.co';
const pageUrl = `${site}/herramientas-ia/${tool.slug}`;
const title = `${tool.nombre}: IA para ${label.toLowerCase()} en pymes`;
const description = `${tool.desc} Ficha del directorio de herramientas de IA para pymes de Omar Álvarez.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      name: title,
      description,
      inLanguage: 'es',
      url: pageUrl,
      isPartOf: { '@type': 'WebSite', name: 'Omar Álvarez', url: site },
      about: {
        '@type': 'SoftwareApplication',
        name: tool.nombre,
        description: tool.desc,
        url: tool.url,
        applicationCategory: label,
        operatingSystem: 'Web',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: site },
        { '@type': 'ListItem', position: 2, name: 'Herramientas de IA', item: `${site}/herramientas-ia` },
        { '@type': 'ListItem', position: 3, name: label, item: `${site}${categoryPath(tool.categoria)}` },
        { '@type': 'ListItem', position: 4, name: tool.nombre, item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={title} description={description} showNav={false} minimal themeColor="#FFF8EA">
  <DirectoryChrome active="directorio">
    <nav class="crumb" aria-label="Miga de pan">
      <a href="/herramientas-ia">Herramientas</a>
      <span aria-hidden="true">/</span>
      <a href={categoryPath(tool.categoria)}>{label}</a>
      <span aria-hidden="true">/</span>
      <span>{tool.nombre}</span>
    </nav>
    <p class="dir-kicker">{label}</p>
    <h1>{tool.nombre}</h1>
    <p class="dir-legend">
      {sponsor && <span class="badge badge--sponsor">Portada</span>}
      {featured && <span class="badge">Destacado</span>}
      {!sponsor && !featured && <span>Sin distintivo de pago.</span>}
    </p>
    <p class="dir-lead">{tool.desc}</p>
    <div class="dir-actions">
      <a
        class="dir-button"
        href={tool.url}
        target="_blank"
        rel={sponsor || featured ? 'sponsored noopener noreferrer' : 'noopener noreferrer'}
      >Abrir sitio ↗</a>
      <a href="/herramientas-ia/destacar">Destacar esta herramienta</a>
    </div>
    <dl class="dir-facts">
      <div>
        <dt>Categoría</dt>
        <dd><a href={categoryPath(tool.categoria)}>{label}</a></dd>
      </div>
      <div>
        <dt>En el directorio</dt>
        <dd>desde {formatDirectoryDate(tool.added)}</dd>
      </div>
      <div>
        <dt>Vigencia del distintivo</dt>
        <dd>
          {sponsor && tool.sponsorUntil ? `portada hasta ${formatDirectoryDate(tool.sponsorUntil)}` : featured && tool.featuredUntil ? `destacado hasta ${formatDirectoryDate(tool.featuredUntil)}` : featured || sponsor ? 'vigente hasta que se edite el dato' : 'no aplica'}
        </dd>
      </div>
    </dl>
    {mentions.length > 0 && (
      <section>
        <h2 class="tool-group">Guías y notas</h2>
        <ul class="chips">
          {mentions.map((mention) => (
            <li><a href={mention.href}>{mention.kind}: {mention.title}</a></li>
          ))}
        </ul>
      </section>
    )}
    {related.length > 0 && (
      <section>
        <h2 class="tool-group">También en {label}</h2>
        <ToolList tools={related} as="h3" />
      </section>
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </DirectoryChrome>
</Layout>
