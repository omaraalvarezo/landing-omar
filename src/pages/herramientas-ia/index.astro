---
import Layout from '../../layouts/Layout.astro';
import DirectoryChrome from '../../components/directory/DirectoryChrome.astro';
import DirectoryTaskLinks from '../../components/directory/DirectoryTaskLinks.astro';
import ToolList from '../../components/directory/ToolList.astro';
import { categoryPath, getCategories, getTools } from '../../lib/directory';
import { faqNode } from '../../lib/editorial';
import { clipMeta, DIRECTORY_INDEX } from '../../lib/directory-seo';

const tools = getTools();
const categories = getCategories();
const site = 'https://omaralvarezo.co';
const title = DIRECTORY_INDEX.title;
const description = clipMeta(DIRECTORY_INDEX.lead);
const faqs = DIRECTORY_INDEX.faqs ?? [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${site}/herramientas-ia`,
      name: title,
      description: DIRECTORY_INDEX.lead,
      inLanguage: 'es',
      url: `${site}/herramientas-ia`,
      isPartOf: { '@type': 'WebSite', name: 'Omar Álvarez', url: site },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: tools.length,
        itemListElement: tools.map((tool, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: tool.nombre,
          url: `${site}/herramientas-ia/${tool.slug}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: site },
        { '@type': 'ListItem', position: 2, name: 'Herramientas de IA', item: `${site}/herramientas-ia` },
      ],
    },
    faqNode(`${site}/herramientas-ia`, faqs),
  ],
};
---

<Layout title={title} description={description} showNav={false} minimal themeColor="#FFF8EA" rss>
  <DirectoryChrome active="directorio">
    <p class="dir-kicker">Directorio · {tools.length} herramientas · {categories.length} categorías</p>
    <h1>Herramientas de IA para una pyme.</h1>
    <p class="dir-lead">{DIRECTORY_INDEX.lead}</p>
    <DirectoryTaskLinks current="/herramientas-ia" />
    <p class="dir-legend">
      <span class="badge">Destacado</span>
      <span>sale arriba mientras la fecha siga vigente.</span>
      <span class="badge badge--sponsor">Portada</span>
      <span>es el patrocinio de 30 días.</span>
    </p>

    <label class="dir-search">
      <span>Buscar</span>
      <input type="search" data-tool-search placeholder="Nombre o tarea" autocomplete="off" />
    </label>

    <nav class="dir-cats" aria-label="Guías">
      <a href="/herramientas-ia/guias">Guías</a>
      <a href="/herramientas-ia/para">Para una tarea</a>
      <a href="/herramientas-ia/noticias">Noticias</a>
      <a href="/herramientas-ia/prompts">Prompts</a>
      <a href="/herramientas-ia/semana">Semana</a>
      <a href="/herramientas-ia/comparar">Comparar</a>
      <a href="/herramientas-ia/alternativas">Alternativas</a>
      <a href="/herramientas-ia/casos">Casos</a>
      <a href="/herramientas-ia/tendencias">Tendencias</a>
    </nav>

    <nav class="offer-links" aria-label="Para llevar">
      <a href="/herramientas-ia/prompts-gratis">PDF de prompts</a>
      <a href="/herramientas-ia/recursos">Calculadoras</a>
      <a href="/herramientas-ia/kit">Kit talleres y detailing</a>
    </nav>

    <nav class="dir-cats" aria-label="Filtrar por categoría">
      <a href="/herramientas-ia" aria-current="page">Todas</a>
      {categories.map((category) => (
        <a href={categoryPath(category.slug)}>{category.label}</a>
      ))}
    </nav>

    <ToolList tools={tools} grouped as="h3" />
    <p class="tool-empty" data-tool-empty hidden>Ninguna herramienta coincide con esa búsqueda.</p>
    <div class="tool-group">
      <h2>Preguntas frecuentes</h2>
    </div>
    <div class="faq">
      {faqs.map((faq) => (
        <>
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </>
      ))}
    </div>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </DirectoryChrome>
</Layout>
