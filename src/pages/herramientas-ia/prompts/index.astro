---
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import DirectoryTaskLinks from '../../../components/directory/DirectoryTaskLinks.astro';
import GuideOffers from '../../../components/directory/GuideOffers.astro';
import NewsletterSlot from '../../../components/directory/NewsletterSlot.astro';
import { collectionNode, promptsPath, publishedPrompts, SITE } from '../../../lib/editorial';
import { formatDirectoryDate } from '../../../lib/directory';
import { hubSeo } from '../../../lib/directory-seo';

const entries = await publishedPrompts();
const { title, lead: description } = hubSeo('prompts');
const jsonLd = collectionNode({
  url: `${SITE}${promptsPath()}`,
  name: title,
  description,
  items: entries.map((entry) => ({ name: entry.data.title, url: `${SITE}${promptsPath(entry.id)}` })),
});
---
<EditorialFrame
  documentTitle={title}
  description={description}
  kicker="Prompts"
  heading="Prompts por rol."
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { label: 'Prompts' }]}
  jsonLd={jsonLd}
>
  <DirectoryTaskLinks current="/herramientas-ia/prompts" />
  <nav class="entries" aria-label="Paquetes de prompts">
    {entries.map((entry) => (
      <a class="entry" href={promptsPath(entry.id)}>
        <span>{formatDirectoryDate(entry.data.published)} · 4 roles</span>
        <strong>{entry.data.title}</strong>
        <em>{entry.data.description}</em>
      </a>
    ))}
  </nav>
  <GuideOffers lead />
  <NewsletterSlot />
</EditorialFrame>
