---
import { getCollection, render } from 'astro:content';
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import PromptCard from '../../../components/directory/PromptCard.astro';
import { articleNode, breadcrumb, promptsPath, publicEntries, SITE, type PromptEntry } from '../../../lib/editorial';

export async function getStaticPaths() {
  const entries = publicEntries(await getCollection('prompts'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: PromptEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const url = `${SITE}${promptsPath(entry.id)}`;
const documentTitle = `${entry.data.title} — prompts para pymes`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleNode({
      url,
      title: entry.data.title,
      description: entry.data.description,
      published: entry.data.published,
      updated: entry.data.updated,
      section: 'Prompts',
    }),
    breadcrumb([
      { name: 'Inicio', url: SITE },
      { name: 'Herramientas de IA', url: `${SITE}/herramientas-ia` },
      { name: 'Prompts', url: `${SITE}${promptsPath()}` },
      { name: entry.data.title, url },
    ]),
  ],
};
---
<EditorialFrame
  documentTitle={documentTitle}
  description={entry.data.description}
  kicker="Prompts"
  heading={entry.data.title}
  published={entry.data.published}
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { href: promptsPath(), label: 'Prompts' }, { label: entry.data.title }]}
  jsonLd={jsonLd}
  newsletter
>
  <div class="prose"><Content /></div>
  <nav class="role-jump" aria-label="Roles">
    {entry.data.roles.map((role) => <a href={`#${role.id}`}>{role.label}</a>)}
  </nav>
  {entry.data.roles.map((role) => (
    <section class="role" id={role.id}>
      <h2 class="block-title">{role.label}</h2>
      {role.prompts.map((prompt) => <PromptCard title={prompt.title} text={prompt.text} />)}
    </section>
  ))}
</EditorialFrame>
