---
import Layout from '../../../layouts/Layout.astro';
import DirectoryChrome from '../../../components/directory/DirectoryChrome.astro';
import ToolList from '../../../components/directory/ToolList.astro';
import {
  categoryLabel,
  categoryPath,
  getCategories,
  getToolsByCategory,
  type ToolCategory,
} from '../../../lib/directory';
import { faqNode, guidesForCategory } from '../../../lib/editorial';
import { categorySeo, clipMeta } from '../../../lib/directory-seo';

export function getStaticPaths() {
  return getCategories()
    .filter((category) => getToolsByCategory(category.slug).length > 0)
    .map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

interface Props {
  category: ToolCategory;
}

const { category } = Astro.props;
const tools = getToolsByCategory(category.slug);
const others = getCategories().filter((item) => item.slug !== category.slug);
const seo = categorySeo(category.slug);
const guides = await guidesForCategory(category.slug);
const site = 'https://omaralvarezo.co';
const pageUrl = `${site}${categoryPath(category.slug)}`;
const title = seo.title;
const description = clipMeta(seo.lead);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: title,
      description: seo.lead,
      inLanguage: 'es',
      url: pageUrl,
      isPartOf: { '@type': 'WebSite', name: 'Omar Álvarez', url: site },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: tools.length,
        itemListElement: tools.map((tool, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: tool.nombre,
          url: `${site}/herramientas-ia/${tool.slug}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: site },
        { '@type': 'ListItem', position: 2, name: 'Herramientas de IA', item: `${site}/herramientas-ia` },
        { '@type': 'ListItem', position: 3, name: category.label, item: pageUrl },
      ],
    },
    faqNode(pageUrl, seo.faqs),
  ],
};
---

<Layout title={title} description={description} showNav={false} minimal themeColor="#FFF8EA">
  <DirectoryChrome active="directorio">
    <nav class="crumb" aria-label="Miga de pan">
      <a href="/herramientas-ia">Herramientas</a>
      <span aria-hidden="true">/</span>
      <span>{category.label}</span>
    </nav>
    <p class="dir-kicker">Categoría · {tools.length}</p>
    <h1>IA para {category.label.toLowerCase()}.</h1>
    <p class="dir-lead">{seo.lead}</p>
    {guides.length > 0 && (
      <nav aria-label="Guías de esta categoría">
        <div class="tool-group">
          <h2>Guías y fichas relacionadas</h2>
        </div>
        <ul class="chips">
          {guides.map((guide) => (
            <li><a href={guide.href}>{guide.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <label class="dir-search">
      <span>Buscar en {category.label}</span>
      <input type="search" data-tool-search placeholder="Nombre o tarea" autocomplete="off" />
    </label>
    <nav class="dir-cats" aria-label="Otras categorías">
      <a href="/herramientas-ia">Todas</a>
      <a href={categoryPath(category.slug)} aria-current="page">{category.label}</a>
      {others.map((item) => (
        <a href={categoryPath(item.slug)}>{item.label}</a>
      ))}
    </nav>
    <ToolList tools={tools} grouped as="h3" />
    <p class="tool-empty" data-tool-empty hidden>Ninguna herramienta de esta categoría coincide.</p>
    <nav aria-label="Si esta no es la tarea">
      <div class="tool-group">
        <h2>Si esta no es la tarea</h2>
      </div>
      <ul class="chips">
        {seo.related.map((slug) => (
          <li><a href={categoryPath(slug)}>{categoryLabel(slug)}</a></li>
        ))}
      </ul>
    </nav>
    <div class="tool-group">
      <h2>Preguntas frecuentes</h2>
    </div>
    <div class="faq">
      {seo.faqs.map((faq) => (
        <>
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </>
      ))}
    </div>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </DirectoryChrome>
</Layout>
