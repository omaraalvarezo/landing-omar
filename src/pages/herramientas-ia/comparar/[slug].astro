---
import { getCollection, render } from 'astro:content';
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import { articleNode, breadcrumb, comparePath, publicEntries, SITE, softwareNodes, toolsOf, type CompareEntry } from '../../../lib/editorial';
import { pageTitle } from '../../../lib/directory-seo';
import { formatDirectoryDate } from '../../../lib/directory';

export async function getStaticPaths() {
  const entries = publicEntries(await getCollection('comparar'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CompareEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const [left, right] = toolsOf([entry.data.left, entry.data.right]);
const url = `${SITE}${comparePath(entry.id)}`;
const documentTitle = pageTitle(entry.data.title, ' — comparativa');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleNode({
      url,
      title: entry.data.title,
      description: entry.data.description,
      published: entry.data.published,
      updated: entry.data.updated,
      section: 'Comparativas',
    }),
    ...softwareNodes([left, right]),
    breadcrumb([
      { name: 'Inicio', url: SITE },
      { name: 'Herramientas de IA', url: `${SITE}/herramientas-ia` },
      { name: 'Comparar', url: `${SITE}${comparePath()}` },
      { name: entry.data.title, url },
    ]),
  ],
};
---
<EditorialFrame
  documentTitle={documentTitle}
  description={entry.data.description}
  kicker="Comparar"
  heading={entry.data.title}
  published={entry.data.published}
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { href: comparePath(), label: 'Comparar' }, { label: entry.data.title }]}
  jsonLd={jsonLd}
>
  <p class="dir-meta">Fuentes revisadas el {formatDirectoryDate(entry.data.checked)}</p>
  <div class="prose"><Content /></div>
  <div class="cmp">
    <div class="cmp__row">
      <p class="cmp__label">Pieza</p>
      <p><a href={`/herramientas-ia/${left.slug}`}>{left.nombre}</a></p>
      <p><a href={`/herramientas-ia/${right.slug}`}>{right.nombre}</a></p>
    </div>
    {entry.data.rows.map((row) => (
      <div class="cmp__row">
        <p class="cmp__label">{row.label}</p>
        <p>{row.left}</p>
        <p>{row.right}</p>
      </div>
    ))}
  </div>
  <h2 class="block-title">Para cuál caso</h2>
  <p class="prose">{entry.data.recommendation}</p>
</EditorialFrame>
