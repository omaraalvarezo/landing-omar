---
import { getCollection, render } from 'astro:content';
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import ToolChips from '../../../components/directory/ToolChips.astro';
import {
  articleNode,
  breadcrumb,
  publicEntries,
  SITE,
  softwareNodes,
  toolsOf,
  weekPath,
  type WeekEntry,
} from '../../../lib/editorial';

export async function getStaticPaths() {
  const entries = publicEntries(await getCollection('semana'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: WeekEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const tool = toolsOf([entry.data.tool])[0];
const alternatives = toolsOf(entry.data.alternatives);
const sponsor = entry.data.sponsorName.trim() && entry.data.sponsorUrl.startsWith('https://');
const url = `${SITE}${weekPath(entry.id)}`;
const documentTitle = `${entry.data.title} — herramienta de la semana`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleNode({
      url,
      title: entry.data.title,
      description: entry.data.description,
      published: entry.data.published,
      updated: entry.data.updated,
      section: 'Herramienta de la semana',
    }),
    ...softwareNodes([tool, ...alternatives]),
    breadcrumb([
      { name: 'Inicio', url: SITE },
      { name: 'Herramientas de IA', url: `${SITE}/herramientas-ia` },
      { name: 'Herramienta de la semana', url: `${SITE}${weekPath()}` },
      { name: entry.data.title, url },
    ]),
  ],
};
---
<EditorialFrame
  documentTitle={documentTitle}
  description={entry.data.description}
  kicker="Herramienta de la semana"
  heading={entry.data.title}
  published={entry.data.published}
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { href: weekPath(), label: 'Semana' }, { label: entry.data.title }]}
  jsonLd={jsonLd}
  newsletter
>
  <div class="prose"><Content /></div>
  <h2 class="block-title">Ficha</h2>
  <ToolChips tools={[tool]} />
  <h2 class="block-title">Cinco pasos</h2>
  <ol class="steps">
    {entry.data.steps.map((step) => <li>{step}</li>)}
  </ol>
  <h2 class="block-title">Veredicto</h2>
  <p class="prose">{entry.data.verdict}</p>
  <h2 class="block-title">Alternativas en el directorio</h2>
  <ToolChips tools={alternatives} />
  {sponsor ? (
    <aside class="sponsor sponsor--live">
      <h2 class="block-title">Patrocinador</h2>
      <p>{entry.data.sponsorNote}</p>
      <p><a href={entry.data.sponsorUrl} target="_blank" rel="noopener noreferrer sponsored">{entry.data.sponsorName}</a></p>
    </aside>
  ) : (
    <aside class="sponsor">
      <h2 class="block-title">Espacio de patrocinio</h2>
      <p>Esta semana no hay patrocinador. El cupo de portada y mención se reserva en destacar.</p>
      <p><a href="/herramientas-ia/destacar">Ver planes de destacado</a></p>
    </aside>
  )}
</EditorialFrame>
