---
import { getCollection, render } from 'astro:content';
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import PromptCard from '../../../components/directory/PromptCard.astro';
import ToolChips from '../../../components/directory/ToolChips.astro';
import {
  articleNode,
  breadcrumb,
  faqNode,
  newsForPara,
  newsPath,
  paraPath,
  publicEntries,
  publishedPara,
  requireRelated,
  SITE,
  softwareNodes,
  toolsOf,
  type ParaEntry,
} from '../../../lib/editorial';

export async function getStaticPaths() {
  const entries = publicEntries(await getCollection('para'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: ParaEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const tools = toolsOf(entry.data.tools);
const promptCards = entry.data.prompts?.length
  ? entry.data.prompts
  : entry.data.prompt
    ? [{ title: 'Para adaptar', text: entry.data.prompt }]
    : [];
const related = requireRelated(entry.data.related, await publishedPara(), entry.id);
const news = await newsForPara(entry.id);
const url = `${SITE}${paraPath(entry.id)}`;
const documentTitle = `${entry.data.title} — guía para pymes`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleNode({
      url,
      title: entry.data.title,
      description: entry.data.description,
      published: entry.data.published,
      updated: entry.data.updated,
      section: 'IA para una tarea',
    }),
    faqNode(url, entry.data.faqs),
    ...softwareNodes(tools),
    breadcrumb([
      { name: 'Inicio', url: SITE },
      { name: 'Herramientas de IA', url: `${SITE}/herramientas-ia` },
      { name: 'IA para una tarea', url: `${SITE}${paraPath()}` },
      { name: entry.data.title, url },
    ]),
  ],
};
---
<EditorialFrame
  documentTitle={documentTitle}
  description={entry.data.description}
  kicker="IA para una tarea"
  heading={entry.data.title}
  published={entry.data.published}
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { href: paraPath(), label: 'Para una tarea' }, { label: entry.data.title }]}
  jsonLd={jsonLd}
>
  <div class="prose"><Content /></div>
  <h2 class="block-title">Herramientas del directorio</h2>
  <ToolChips tools={tools} />
  {entry.data.guides?.length ? (
    entry.data.guides.map((guide) => {
      const tool = tools.find((item) => item.slug === guide.tool);
      return (
        <section>
          <h2 class="block-title">{tool?.nombre}</h2>
          {tool && <p class="price-note"><a class="source-link" href={`/herramientas-ia/${tool.slug}`}>{tool.desc}</a></p>}
          <ol class="steps">
            {guide.steps.map((step) => <li>{step}</li>)}
          </ol>
        </section>
      );
    })
  ) : (
    <>
      <h2 class="block-title">Pasos</h2>
      <ol class="steps">
        {entry.data.steps?.map((step) => <li>{step}</li>)}
      </ol>
    </>
  )}
  <h2 class="block-title">{promptCards.length > 1 ? 'Prompts' : 'Prompt'}</h2>
  {promptCards.map((prompt) => <PromptCard title={prompt.title} text={prompt.text} />)}
  <h2 class="block-title">Preguntas frecuentes</h2>
  <div class="faq">
    {entry.data.faqs.map((faq) => (
      <>
        <h3>{faq.q}</h3>
        <p>{faq.a}</p>
      </>
    ))}
  </div>
  {(related.length > 0 || news.length > 0) && (
    <>
      <h2 class="block-title">Sigue por aquí</h2>
      <ul class="chips">
        {related.map((item) => <li><a href={paraPath(item.id)}>{item.data.title}</a></li>)}
        {news.map((item) => <li><a href={newsPath(item.id)}>{item.data.title}</a></li>)}
      </ul>
    </>
  )}
</EditorialFrame>
