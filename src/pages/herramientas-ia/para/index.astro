---
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import DirectoryTaskLinks from '../../../components/directory/DirectoryTaskLinks.astro';
import { collectionNode, paraPath, publishedPara, SITE } from '../../../lib/editorial';
import { formatDirectoryDate } from '../../../lib/directory';
import { hubSeo } from '../../../lib/directory-seo';

const entries = await publishedPara();
const { title, lead: description } = hubSeo('para');
const jsonLd = collectionNode({
  url: `${SITE}${paraPath()}`,
  name: title,
  description,
  items: entries.map((entry) => ({ name: entry.data.title, url: `${SITE}${paraPath(entry.id)}` })),
});
---
<EditorialFrame
  documentTitle={title}
  description={description}
  kicker="IA para una tarea"
  heading="IA para una tarea concreta."
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { label: 'Para una tarea' }]}
  jsonLd={jsonLd}
>
  <DirectoryTaskLinks current="/herramientas-ia/para" />
  <nav class="chips" aria-label="Guías de taller y detailing">
    <a href={paraPath('talleres-de-carros')}>Talleres de carros</a>
    <a href={paraPath('detailing')}>Detailing</a>
  </nav>
  <nav class="entries" aria-label="Páginas por tarea">
    {entries.map((entry) => (
      <a class="entry" href={paraPath(entry.id)}>
        <span>{entry.data.priority ? 'Empieza por aquí · ' : ''}{formatDirectoryDate(entry.data.published)} · {entry.data.tools.length} herramientas</span>
        <strong>{entry.data.title}</strong>
        <em>{entry.data.description}</em>
      </a>
    ))}
  </nav>
</EditorialFrame>
