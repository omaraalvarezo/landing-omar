---
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import { collectionNode, publishedTrends, SITE, trendPath } from '../../../lib/editorial';
import { formatDirectoryDate } from '../../../lib/directory';
import { hubSeo } from '../../../lib/directory-seo';

const entries = await publishedTrends();
const { title, lead: description } = hubSeo('tendencias');
const jsonLd = collectionNode({
  url: `${SITE}${trendPath()}`,
  name: title,
  description,
  items: entries.map((entry) => ({ name: entry.data.title, url: `${SITE}${trendPath(entry.id)}` })),
});
---
<EditorialFrame
  documentTitle={title}
  description={description}
  kicker="Tendencias"
  heading="Lo que cambió este mes."
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { label: 'Tendencias' }]}
  jsonLd={jsonLd}
>
  <nav class="entries" aria-label="Tendencias">
    {entries.map((entry) => (
      <a class="entry" href={trendPath(entry.id)}>
        <span>{entry.data.month} · publicado {formatDirectoryDate(entry.data.published)}</span>
        <strong>{entry.data.title}</strong>
        <em>{entry.data.description}</em>
      </a>
    ))}
  </nav>
</EditorialFrame>
