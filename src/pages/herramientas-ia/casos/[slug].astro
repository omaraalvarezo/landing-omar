---
import { getCollection, render } from 'astro:content';
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import ToolChips from '../../../components/directory/ToolChips.astro';
import {
  articleNode,
  breadcrumb,
  casePath,
  paraPath,
  publicEntries,
  publishedPara,
  requireRelated,
  SITE,
  softwareNodes,
  toolsOf,
  type CaseEntry,
} from '../../../lib/editorial';
import { pageTitle } from '../../../lib/directory-seo';

export async function getStaticPaths() {
  const entries = publicEntries(await getCollection('casos'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CaseEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const tools = toolsOf(entry.data.tools);
const paras = requireRelated(entry.data.para, await publishedPara(), entry.id);
const url = `${SITE}${casePath(entry.id)}`;
const documentTitle = pageTitle(entry.data.title, ' — caso de uso');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleNode({
      url,
      title: entry.data.title,
      description: entry.data.description,
      published: entry.data.published,
      updated: entry.data.updated,
      section: 'Casos',
      citation: entry.data.sourceUrl,
    }),
    ...softwareNodes(tools),
    breadcrumb([
      { name: 'Inicio', url: SITE },
      { name: 'Herramientas de IA', url: `${SITE}/herramientas-ia` },
      { name: 'Casos', url: `${SITE}${casePath()}` },
      { name: entry.data.title, url },
    ]),
  ],
};
---
<EditorialFrame
  documentTitle={documentTitle}
  description={entry.data.description}
  kicker={`Caso · ${entry.data.sourceName}`}
  heading={entry.data.title}
  published={entry.data.published}
  sourceDate={entry.data.sourceDate}
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { href: casePath(), label: 'Casos' }, { label: entry.data.title }]}
  jsonLd={jsonLd}
>
  <div class="prose"><Content /></div>
  <section class="meaning">
    <h2 class="block-title">Qué dice la fuente, y qué no</h2>
    <p>{entry.data.resultNote}</p>
  </section>
  <p class="price-note">
    Fuente: <a class="source-link" href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer">{entry.data.sourceName}</a>
  </p>
  <h2 class="block-title">En el directorio</h2>
  <ToolChips tools={tools} />
  {paras.length > 0 && (
    <ul class="chips">
      {paras.map((item) => <li><a href={paraPath(item.id)}>{item.data.title}</a></li>)}
    </ul>
  )}
</EditorialFrame>
