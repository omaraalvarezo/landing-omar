---
import EditorialFrame from '../../../components/directory/EditorialFrame.astro';
import DirectoryTaskLinks from '../../../components/directory/DirectoryTaskLinks.astro';
import { casePath, collectionNode, publishedCases, SITE } from '../../../lib/editorial';
import { formatDirectoryDate } from '../../../lib/directory';
import { hubSeo } from '../../../lib/directory-seo';

const entries = await publishedCases();
const { title, lead: description } = hubSeo('casos');
const jsonLd = collectionNode({
  url: `${SITE}${casePath()}`,
  name: title,
  description,
  items: entries.map((entry) => ({ name: entry.data.title, url: `${SITE}${casePath(entry.id)}` })),
});
---
<EditorialFrame
  documentTitle={title}
  description={description}
  kicker="Casos"
  heading="Casos con fuente."
  crumbs={[{ href: '/herramientas-ia/guias', label: 'Guías' }, { label: 'Casos' }]}
  jsonLd={jsonLd}
>
  <DirectoryTaskLinks current="/herramientas-ia/casos" />
  <nav class="entries" aria-label="Casos">
    {entries.map((entry) => (
      <a class="entry" href={casePath(entry.id)}>
        <span>{entry.data.sourceName} · {formatDirectoryDate(entry.data.sourceDate)}</span>
        <strong>{entry.data.title}</strong>
        <em>{entry.data.description}</em>
      </a>
    ))}
  </nav>
</EditorialFrame>
