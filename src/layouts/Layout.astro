---
import '../styles/global.css';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import CustomCursor from '../components/CustomCursor.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import BookFloat from '../components/BookFloat.astro';
import CalRuntime from '../components/CalRuntime.astro';
import { ADSENSE, adsenseAccount } from '../lib/ads';
import { DEFAULT_OG_IMAGE, SITE_NAME } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showNav?: boolean;
  minimal?: boolean;
  noIndex?: boolean;
  privatePage?: boolean;
  themeColor?: string;
  rss?: boolean;
  /** Imprime la meta de verificación de AdSense. Apagada mientras ADSENSE.enabled sea false. */
  ads?: boolean;
  /** JSON-LD propio de la página; el grafo Persona/Servicio solo lo pasa el home. */
  jsonLd?: unknown;
}

const {
  title = 'omar.alvarez — Negocios reales, código real',
  description = 'Trabajo 1:1 con dueños y socios de empresas de servicios para mejorar captación, CRM, operación y postventa con sistemas e inteligencia artificial.',
  image = DEFAULT_OG_IMAGE,
  showNav = true,
  minimal = false,
  noIndex = false,
  privatePage = false,
  themeColor = '#FAFAF9',
  rss = false,
  ads = ADSENSE.enabled,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const isDefaultImage = image === DEFAULT_OG_IMAGE;
// El placeholder del pub-ID nunca se imprime; tampoco en páginas privadas o noindex.
const adsAccount = ads && !privatePage && !noIndex ? adsenseAccount() : null;
---

<!doctype html>
<html
  lang="es"
  class:list={{
    'loader-enabled': !minimal,
    'loader-skipped': minimal,
  }}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC: aplica tema antes del primer paint.
         Lee localStorage 'omar-theme'; si no existe, respeta prefers-color-scheme. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('omar-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <!-- Favicon dual: light + dark según prefers-color-scheme del SO -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {!privatePage && <link rel="canonical" href={canonicalURL} />}
    {rss && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title="Herramientas de IA"
        href={new URL('/herramientas-ia/rss.xml', Astro.site)}
      />
    )}

    <!-- Open Graph -->
    {!privatePage && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:locale" content="es_CO" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        {isDefaultImage && (
          <>
            <meta property="og:image:type" content="image/png" />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta property="og:image:alt" content="Omar Álvarez: los sistemas con los que opera Enzo Motorsport y Arkhē" />
          </>
        )}
      </>
    )}

    <!-- Twitter -->
    {!privatePage && (
      <>
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}

    <meta name="theme-color" content={themeColor} />

    {adsAccount && <meta name="google-adsense-account" content={adsAccount} />}

    {/* JSON-LD de la página. El grafo Persona/ProfessionalService solo viaja en el home. */}
    {!privatePage && jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-120 focus:bg-accent focus:px-4 focus:py-2 focus:text-bg focus:rounded-sm"
      style="font-family: var(--font-mono);"
    >
      Saltar al contenido
    </a>

    {!minimal && <Loader />}
    {!minimal && <ScrollProgress />}
    {!minimal && <CustomCursor />}
    {showNav && <Nav />}

    <main id="main">
      <span id="top" class="sr-only" aria-hidden="true"></span>
      <slot />
    </main>

    {!minimal && <BookFloat />}
    {!minimal && <CalRuntime />}

    {!minimal && (
      <script>
        import { initLenis } from '../scripts/lenis';
        initLenis();
      </script>
    )}

    <!-- Theme toggle: sincroniza estado del botón con [data-theme] y persiste en localStorage.
         Vive aquí (no en Nav.astro) para evitar duplicación si la nav re-renderiza. -->
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var meta = document.querySelector('meta[name="theme-color"]');

        function apply(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          btn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
          btn.setAttribute('aria-label', theme === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0D0D0D' : '#FAFAF9');
          try { localStorage.setItem('omar-theme', theme); } catch (e) {}
        }

        var current = document.documentElement.getAttribute('data-theme') || 'light';
        apply(current);

        btn.addEventListener('click', function () {
          var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          apply(next);
        });

        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        if (mq.addEventListener) {
          mq.addEventListener('change', function (e) {
            // Si el usuario nunca tocó el toggle, seguir al SO en tiempo real
            try {
              if (!localStorage.getItem('omar-theme')) apply(e.matches ? 'dark' : 'light');
            } catch (err) {}
          });
        }
      })();
    </script>
  </body>
</html>
