{
  "name": "landing-omar",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Landing personal de Omar Álvarez — consultoría IA pymes LATAM",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "resource:add": "node scripts/add-resource.mjs",
    "resource:toggle": "node scripts/toggle-resource.mjs",
    "resource:hide": "node scripts/toggle-resource.mjs --state hide",
    "resource:show": "node scripts/toggle-resource.mjs --state show",
    "resource:list": "node scripts/list-resources.mjs",
    "area:toggle": "node scripts/toggle-area.mjs",
    "area:list": "node scripts/list-areas.mjs",
    "tool:add": "node scripts/add-tool.mjs",
    "tool:feature": "node scripts/feature-tool.mjs",
    "tool:list": "node scripts/list-tools.mjs",
    "tool:pending": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/list-directory-orders.mjs",
    "tool:check": "node scripts/check-directory.mjs",
    "content:new": "node scripts/content-new.mjs",
    "content:new:para": "node scripts/content-new.mjs --type para",
    "content:new:noticias": "node scripts/content-new.mjs --type noticias",
    "content:new:prompts": "node scripts/content-new.mjs --type prompts",
    "content:new:semana": "node scripts/content-new.mjs --type semana",
    "content:new:comparar": "node scripts/content-new.mjs --type comparar",
    "content:new:alternativas": "node scripts/content-new.mjs --type alternativas",
    "content:new:casos": "node scripts/content-new.mjs --type casos",
    "content:new:tendencias": "node scripts/content-new.mjs --type tendencias",
    "content:check": "node scripts/check-content.mjs",
    "test": "vitest run",
    "offers:check": "node --experimental-strip-types scripts/check-offers.mjs",
    "lead:list": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/list-leads.mjs",
    "kit:pending": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/list-kit-orders.mjs",
    "sistema:avisar-videos": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/notify-sistema-videos.mjs",
    "prepare": "husky",
    "zernio:accounts": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/zernio-accounts.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vercel": "^11.0.15",
    "@calcom/embed-snippet": "^1.3.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.1.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "@lucide/astro": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "2.0.1",
    "@zernio/node": "^0.2.1376",
    "astro": "^7.4.0",
    "bcryptjs": "^3.0.3",
    "lenis": "^1.1.20",
    "motion": "^11.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "gitleaks": "^1.0.0",
    "husky": "^9.1.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
