# URL canónica. En producción: https://omaralvarezo.co
PUBLIC_SITE_URL=http://localhost:4321

# Evento oculto de 120 minutos en Cal.com, con confirmación manual. Formato: usuario/slug
CAL_CONSULTING_LINK=omaralvarezo/consultoria-2-horas

# El entorno local debe quedarse en test. Solo producción usa cobros reales.
WOMPI_ENVIRONMENT=test

# Comercio Wompi de producción
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=

# HMAC privada landing → almacén de órdenes en Adjudika (mismo valor en ambos).
WOMPI_RELAY_SECRET=
# En local apunta al endpoint interno de Adjudika; producción usa adjudika.co por defecto.
CONSULTING_ORDER_STORE_URL=http://127.0.0.1:3000/api/internal/consulting-orders

# Sandbox de Wompi
WOMPI_TEST_PUBLIC_KEY=
WOMPI_TEST_INTEGRITY_SECRET=

# Secreto de eventos del dashboard de Wompi (Developers → Secretos).
# No reemplaza la URL de eventos que ya apunta a Adjudika.
# Adjudika debe reenviar, sin modificar el JSON, los eventos cuya referencia
# empieza por oa-directorio- a POST https://omaralvarezo.co/api/herramientas/evento
# El kit usa otro prefijo, oa-kit-. Adjudika también tiene que reenviar ese JSON,
# sin modificarlo, al mismo endpoint.
WOMPI_EVENTS_SECRET=
WOMPI_TEST_EVENTS_SECRET=

# Aviso cuando un listado queda pagado. Sin RESEND_API_KEY y DIRECTORY_NOTIFY_FROM
# la orden se guarda y el correo queda pendiente (npm run tool:pending).
# El destinatario por defecto del servidor es omaraalvarezo@gmail.com.
DIRECTORY_NOTIFY_EMAIL=omaraalvarezo@gmail.com
# Remitente verificado en Resend. Ejemplo: Directorio <avisos@omaralvarezo.co>
DIRECTORY_NOTIFY_FROM=
RESEND_API_KEY=

# Upstash guarda las órdenes del directorio (oa:dir:*), las del kit (oa:kit:*)
# y los correos del PDF de prompts (oa:lead:*). Sin estas variables el checkout
# del directorio y del kit fallan cerrados, y el PDF no se entrega.
# No hace falta una variable nueva: es el mismo Redis de /admin.
# Lista de correo de las guías. Sin las dos variables, el formulario queda
# visible y desactivado: no guarda direcciones. El action tiene que ser https
# y del mismo proveedor (beehiiv.com o buttondown.com / buttondown.email).
# NEWSLETTER_PROVIDER=beehiiv
# NEWSLETTER_PROVIDER=buttondown
NEWSLETTER_PROVIDER=
NEWSLETTER_ACTION_URL=

# Panel privado de recursos (existente)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
